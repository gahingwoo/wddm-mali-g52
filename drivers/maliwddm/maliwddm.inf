;
; maliwddm.inf - milestone M5.2: the full WDDM 1.3 driver for the RK3576's
; Mali-G52 and its display (docs/M5.2-PLAN.md). Binds ACPI\RKCP7402 (GPU0 in
; the edk2-rk3576 CM5-IO DSDT), the device m1probe and malikm bind:
; only one of them can be installed at a time.
;
; The user-mode driver is maliumd.dll: Mesa's d3d10umd with Panfrost
; (libgallium_d3d10.dll from mesa.yml). CI puts it in the package as
; maliumd_arm64.dll and this INF copies it to System32\maliumd.dll; a full
; WDDM adapter with no loadable UMD fails with code 43 (board runs 1-3,
; viogpu3d's PR 943 thread). Steps (a)/(b) named WARP (d3d10warp.dll)
; instead. Preemption is turned off system-wide, as viogpu3d does: the
; driver never preempts a DMA buffer.
;
; Why the UMD goes to System32 under another name than the one it has in
; the package: a UMD is often replaced on the board by renaming
; System32\maliumd.dll and copying a new one beside it. The driver store
; holds every file a package copies, so if it held a maliumd.dll the runtime
; could load that one instead of System32's. It holds maliumd_arm64.dll, so
; the name in UserModeDriverName exists in System32 only.
;
; SPDX-License-Identifier: GPL-2.0
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = maliwddm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
MW_UmdFiles    = 11 ; System32

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
maliwddm.sys      = 1
maliumd_arm64.dll = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%MW.DeviceDesc% = MW_Inst,ACPI\RKCP7402

[MW_Inst]
FeatureScore = F9
CopyFiles = MW_CopyFiles, MW_UmdFiles
AddReg = MW_Settings

[MW_CopyFiles]
maliwddm.sys

; 0x00004000 is COPYFLG_IN_USE_RENAME: when dwm.exe or LogonUI.exe has the
; old maliumd.dll loaded, setup renames it and puts the new one in place at
; once (the old one is deleted at the next restart), so processes started
; after the update load the new UMD without a reboot. Without the flag an
; in-use file is only replaced at the next restart.
[MW_UmdFiles]
maliumd.dll,maliumd_arm64.dll,,0x00004000

; PnpLockdown = 1 keeps applications, administrators included, from changing
; the files this INF copies. For the UMD that would stop the rename above,
; so its ACL is given here: what System32's own DLLs grant (read and execute
; for users and for app containers, which load UMDs too), plus full control
; for SYSTEM and Administrators.
[MW_UmdFiles.security]
"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;AC)(A;;GRGX;;;S-1-15-2-2)"

; A 32-bit (WoW64) or x64 UMD would go here: its file in SourceDisksFiles,
; its own file-list section in CopyFiles and DestinationDirs, and
; UserModeDriverNameWow next to UserModeDriverName. Nothing builds one yet.

[MW_Settings]
HKR,,UserModeDriverName,%REG_MULTI_SZ%,maliumd.dll,maliumd.dll,maliumd.dll,maliumd.dll
; Base names of the UMDs this package installs ("Installed display drivers
; directive", Microsoft's display driver INF documentation).
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,maliumd
HKLM,"SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler",EnablePreemption,%REG_DWORD%,0

[MW_Inst.Services]
AddService = maliwddm,0x00000002,MW_Service

[MW_Service]
DisplayName    = %MW.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %13%\maliwddm.sys
LoadOrderGroup = Video

[Strings]
ProviderName  = "wddm-mali-g52"
DiskName      = "RK3576 Mali-G52 WDDM driver"
MW.DeviceDesc = "Rockchip RK3576 Mali-G52 (WDDM)"
MW.SvcDesc    = "RK3576 Mali-G52 WDDM driver"
REG_DWORD     = 0x00010001
REG_MULTI_SZ  = 0x00010000
