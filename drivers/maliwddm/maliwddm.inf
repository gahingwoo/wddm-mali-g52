;
; maliwddm.inf - milestone M5.2: the full WDDM driver (2.0 by default, 1.3 on request) for the RK3576's
; Mali-G52 and its display (docs/M5.2-PLAN.md). Binds ACPI\RKCP7402 (GPU0 in
; the edk2-rk3576 CM5-IO DSDT), the device m1probe and malikm bind:
; only one of them can be installed at a time.
;
; The user-mode driver is Mesa's d3d10umd with Panfrost (mesa.yml), built
; three times, because a process loads a UMD of its own kind:
;   System32\maliumd_arm64.dll  ARM64 processes, dwm.exe among them
;   System32\maliumd_x64.dll    x64 processes, which run emulated
;   SysWOW64\maliumd_x86.dll    x86 processes, likewise
; System32\maliumd.dll, the name in UserModeDriverName, is an ARM64X
; forwarder: an ARM64 process that loads it gets maliumd_arm64.dll and an
; x64 process gets maliumd_x64.dll. Without it an x64 process cannot load
; the UMD at all, and without UserModeDriverNameWow an x86 process is given
; no name to load (D3D11CreateDevice 0x887A0004 for both on the TaishanPi
; 3M, 2026-11-14, and a triangle on the Mali from all three with these
; files in place).
;
; A full WDDM adapter with no loadable UMD fails with code 43 (board runs
; 1-3, viogpu3d's PR 943 thread). Preemption is turned off system-wide, as
; viogpu3d does: the driver never preempts a DMA buffer.
;
; To try another ARM64 UMD on a board without reinstalling: rename
; System32\maliumd_arm64.dll and copy the new one beside it. The forwarder
; is in the package as maliumd_fwd.dll so that the driver store holds no
; maliumd.dll of its own.
;
; SPDX-License-Identifier: GPL-2.0
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = maliwddm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
MW_UmdFiles    = 11 ; System32
MW_UmdWowFiles = 10,SysWOW64
MW_ClFiles     = 13 ; [opencl]
MW_ClLoader    = 11 ; [opencl] System32

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
maliwddm.sys      = 1
maliwddm.man      = 1
maliumd_fwd.dll   = 1
maliumd_arm64.dll = 1
maliumd_x64.dll   = 1
maliumd_x86.dll   = 1
maligl_fwd.dll    = 1
maligl_arm64.dll  = 1
maligl_x64.dll    = 1
maligl_x86.dll    = 1
malicl_arm64.dll   = 1 ; [opencl]
vcruntime140.dll   = 1 ; [opencl]
vcruntime140_1.dll = 1 ; [opencl]
msvcp140.dll       = 1 ; [opencl]
OpenCL.dll         = 1 ; [opencl]

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%MW.DeviceDesc% = MW_Inst,ACPI\RKCP7402

[MW_Inst]
FeatureScore = F9
CopyFiles = MW_CopyFiles, MW_UmdFiles, MW_UmdWowFiles
CopyFiles = MW_ClFiles, MW_ClLoader ; [opencl]
AddReg = MW_Settings

[MW_CopyFiles]
maliwddm.sys
; The "RK3576 GPU" performance counter manifest (docs/PERFDATA.md section 6),
; next to maliwddm.sys, whose resources hold the counter names. No INF
; directive installs a counter manifest; maliwddm-counters.cmd install runs
; lodctr /m on this copy. The driver provides the counters either way.
maliwddm.man

; 0x00004000 is COPYFLG_IN_USE_RENAME: when dwm.exe or LogonUI.exe has the
; old maliumd.dll loaded, setup renames it and puts the new one in place at
; once (the old one is deleted at the next restart), so processes started
; after the update load the new UMD without a reboot. Without the flag an
; in-use file is only replaced at the next restart.
[MW_UmdFiles]
maliumd.dll,maliumd_fwd.dll,,0x00004000
maliumd_arm64.dll,,,0x00004000
maliumd_x64.dll,,,0x00004000
; The OpenGL ICD, Mesa's WGL frontend on Panfrost: a forwarder and its two
; builds, as for the Direct3D UMD.
maligl.dll,maligl_fwd.dll,,0x00004000
maligl_arm64.dll,,,0x00004000
maligl_x64.dll,,,0x00004000

; PnpLockdown = 1 keeps applications, administrators included, from changing
; the files this INF copies. For the UMD that would stop the rename above,
; so its ACL is given here: what System32's own DLLs grant (read and execute
; for users and for app containers, which load UMDs too), plus full control
; for SYSTEM and Administrators.
[MW_UmdFiles.security]
"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;AC)(A;;GRGX;;;S-1-15-2-2)"

[MW_UmdWowFiles]
maliumd_x86.dll,,,0x00004000
maligl_x86.dll,,,0x00004000

[MW_UmdWowFiles.security]
"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;AC)(A;;GRGX;;;S-1-15-2-2)"

; OpenCL (docs/OPENCL.md): Mesa's rusticl on Panfrost, an OpenCL ICD for the
; Khronos loader, ARM64 processes only. It stays in the driver store with the
; VC runtime it was linked against (/MD, as the LLVM release it carries is):
; the loader opens it by full path with LOAD_WITH_ALTERED_SEARCH_PATH, so the
; runtime beside it is the one found. Lines marked [opencl] are taken out by
; the package job when a build has no OpenCL ICD.
[MW_ClFiles] ; [opencl]
malicl_arm64.dll ; [opencl]
vcruntime140.dll ; [opencl]
vcruntime140_1.dll ; [opencl]
msvcp140.dll ; [opencl]

; The Khronos ICD loader as System32\OpenCL.dll, which programs link to;
; Windows has none of its own. 0x00000010 is COPYFLG_NO_OVERWRITE: an
; OpenCL.dll already there (another GPU's driver, an SDK) is left alone, and
; that loader finds this ICD the same way.
[MW_ClLoader] ; [opencl]
OpenCL.dll,,,0x00000010 ; [opencl]

[MW_ClLoader.security] ; [opencl]
"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;AC)(A;;GRGX;;;S-1-15-2-2)" ; [opencl]

[MW_Settings]
HKR,,UserModeDriverName,%REG_MULTI_SZ%,maliumd.dll,maliumd.dll,maliumd.dll,maliumd.dll
HKR,,UserModeDriverNameWow,%REG_MULTI_SZ%,maliumd_x86.dll,maliumd_x86.dll,maliumd_x86.dll,maliumd_x86.dll
; opengl32.dll asks the kernel for these (KMTQAITYPE_UMOPENGLINFO) and loads
; the ICD they name; the kernel reads them when the adapter starts. Without
; them a program gets Windows' GL 1.1 software implementation, and one that
; calls a GL 2 entry point crashes at address 0 (GpuTest, TaishanPi 3M,
; 2026-11-14). With them set by hand there, gltri drew on the Mali through
; Windows' opengl32 from ARM64, x64 and x86 processes, and FurMark ran.
; Flags 1: the ICD is told to finish before a swap.
HKR,,OpenGLDriverName,%REG_SZ%,maligl.dll
HKR,,OpenGLVersion,%REG_DWORD%,1
HKR,,OpenGLFlags,%REG_DWORD%,1
HKR,,OpenGLDriverNameWow,%REG_SZ%,maligl_x86.dll
HKR,,OpenGLVersionWow,%REG_DWORD%,1
HKR,,OpenGLFlagsWow,%REG_DWORD%,1
; The Khronos loader reads this from the adapter's key (D3DKMTQueryAdapterInfo
; with KMTQAITYPE_QUERYREGISTRY, and through the device's software key with
; CM_Open_DevNode_Key) and loads the ICD it names. x64 and x86 processes are
; given no OpenCL ICD (none is built for them): an x64 process reads the same
; value, fails to load an ARM64 DLL, and the loader goes on without it.
HKR,,OpenCLDriverName,%REG_SZ%,%13%\malicl_arm64.dll ; [opencl]
; Base names of the UMDs this package installs ("Installed display drivers
; directive", Microsoft's display driver INF documentation).
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,maliumd
HKLM,"SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler",EnablePreemption,%REG_DWORD%,0

[MW_Inst.Services]
AddService = maliwddm,0x00000002,MW_Service

[MW_Service]
DisplayName    = %MW.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %13%\maliwddm.sys
LoadOrderGroup = Video

[Strings]
ProviderName  = "wddm-mali-g52"
DiskName      = "RK3576 Mali-G52 WDDM driver"
MW.DeviceDesc = "Rockchip RK3576 Mali-G52 (WDDM)"
MW.SvcDesc    = "RK3576 Mali-G52 WDDM driver"
REG_DWORD     = 0x00010001
REG_SZ        = 0x00000000
REG_MULTI_SZ  = 0x00010000
