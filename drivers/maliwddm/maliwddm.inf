;
; maliwddm.inf - milestone M5.2: the full WDDM 1.3 driver for the RK3576's
; Mali-G52 and its display (docs/M5.2-PLAN.md). Binds ACPI\RKCP7402 (GPU0 in
; the edk2-rk3576 CM5-IO DSDT), the device m1probe and malikm bind:
; only one of them can be installed at a time.
;
; The user-mode driver is Mesa's d3d10umd with Panfrost (mesa.yml), built
; three times, because a process loads a UMD of its own kind:
;   System32\maliumd_arm64.dll  ARM64 processes, dwm.exe among them
;   System32\maliumd_x64.dll    x64 processes, which run emulated
;   SysWOW64\maliumd_x86.dll    x86 processes, likewise
; System32\maliumd.dll, the name in UserModeDriverName, is an ARM64X
; forwarder: an ARM64 process that loads it gets maliumd_arm64.dll and an
; x64 process gets maliumd_x64.dll. Without it an x64 process cannot load
; the UMD at all, and without UserModeDriverNameWow an x86 process is given
; no name to load (D3D11CreateDevice 0x887A0004 for both on the TaishanPi
; 3M, 2026-11-14, and a triangle on the Mali from all three with these
; files in place).
;
; A full WDDM adapter with no loadable UMD fails with code 43 (board runs
; 1-3, viogpu3d's PR 943 thread). Preemption is turned off system-wide, as
; viogpu3d does: the driver never preempts a DMA buffer.
;
; To try another ARM64 UMD on a board without reinstalling: rename
; System32\maliumd_arm64.dll and copy the new one beside it. The forwarder
; is in the package as maliumd_fwd.dll so that the driver store holds no
; maliumd.dll of its own.
;
; SPDX-License-Identifier: GPL-2.0
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = maliwddm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
MW_UmdFiles    = 11 ; System32
MW_UmdWowFiles = 10,SysWOW64

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
maliwddm.sys      = 1
maliumd_fwd.dll   = 1
maliumd_arm64.dll = 1
maliumd_x64.dll   = 1
maliumd_x86.dll   = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%MW.DeviceDesc% = MW_Inst,ACPI\RKCP7402

[MW_Inst]
FeatureScore = F9
CopyFiles = MW_CopyFiles, MW_UmdFiles, MW_UmdWowFiles
AddReg = MW_Settings

[MW_CopyFiles]
maliwddm.sys

; 0x00004000 is COPYFLG_IN_USE_RENAME: when dwm.exe or LogonUI.exe has the
; old maliumd.dll loaded, setup renames it and puts the new one in place at
; once (the old one is deleted at the next restart), so processes started
; after the update load the new UMD without a reboot. Without the flag an
; in-use file is only replaced at the next restart.
[MW_UmdFiles]
maliumd.dll,maliumd_fwd.dll,,0x00004000
maliumd_arm64.dll,,,0x00004000
maliumd_x64.dll,,,0x00004000

; PnpLockdown = 1 keeps applications, administrators included, from changing
; the files this INF copies. For the UMD that would stop the rename above,
; so its ACL is given here: what System32's own DLLs grant (read and execute
; for users and for app containers, which load UMDs too), plus full control
; for SYSTEM and Administrators.
[MW_UmdFiles.security]
"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;AC)(A;;GRGX;;;S-1-15-2-2)"

[MW_UmdWowFiles]
maliumd_x86.dll,,,0x00004000

[MW_UmdWowFiles.security]
"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;AC)(A;;GRGX;;;S-1-15-2-2)"

[MW_Settings]
HKR,,UserModeDriverName,%REG_MULTI_SZ%,maliumd.dll,maliumd.dll,maliumd.dll,maliumd.dll
HKR,,UserModeDriverNameWow,%REG_MULTI_SZ%,maliumd_x86.dll,maliumd_x86.dll,maliumd_x86.dll,maliumd_x86.dll
; Base names of the UMDs this package installs ("Installed display drivers
; directive", Microsoft's display driver INF documentation).
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,maliumd
HKLM,"SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler",EnablePreemption,%REG_DWORD%,0

[MW_Inst.Services]
AddService = maliwddm,0x00000002,MW_Service

[MW_Service]
DisplayName    = %MW.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %13%\maliwddm.sys
LoadOrderGroup = Video

[Strings]
ProviderName  = "wddm-mali-g52"
DiskName      = "RK3576 Mali-G52 WDDM driver"
MW.DeviceDesc = "Rockchip RK3576 Mali-G52 (WDDM)"
MW.SvcDesc    = "RK3576 Mali-G52 WDDM driver"
REG_DWORD     = 0x00010001
REG_MULTI_SZ  = 0x00010000
