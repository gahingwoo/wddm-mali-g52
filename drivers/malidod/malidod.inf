;
; malidod.inf - milestone M5.1: display-only driver (KMDOD) for the RK3576.
; Binds ACPI\RKCP7403 (DSP0 in the edk2-rk3576 CM5-IO DSDT, branch
; cm5io-mali-m1), the display device apart from the GPU, so that it pairs
; with maliwddm, the render-only driver on GPU0 (ACPI\RKCP7402). Firmware
; without DSP0 has no device for it.
;
; SPDX-License-Identifier: GPL-2.0
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = malidod.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
malidod.sys = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%MD.DeviceDesc% = MD_Inst,ACPI\RKCP7403

[MD_Inst]
FeatureScore = F9
CopyFiles = MD_CopyFiles

[MD_CopyFiles]
malidod.sys

[MD_Inst.Services]
AddService = malidod,0x00000002,MD_Service

[MD_Service]
DisplayName    = %MD.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %13%\malidod.sys
LoadOrderGroup = Video

[Strings]
ProviderName  = "wddm-mali-g52"
DiskName      = "RK3576 display-only driver"
MD.DeviceDesc = "Rockchip RK3576 Display (display-only)"
MD.SvcDesc    = "RK3576 display-only driver"
