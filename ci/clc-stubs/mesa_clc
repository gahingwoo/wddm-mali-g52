#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
# Stand-in for Mesa's mesa_clc on the Windows ARM64 build. Compiling OpenCL C
# needs LLVM and clang, which the Windows build does without: the SPIR-V for
# Panfrost's libpan shaders is generated by the Linux CI job (it is platform
# independent) and this copies the one for the requested PAN_ARCH.
#   mesa_clc -o OUT --depfile DEP <sources...> -- -DPAN_ARCH=N ...
import os, shutil, sys
a = sys.argv[1:]
out = a[a.index("-o") + 1]
dep = a[a.index("--depfile") + 1] if "--depfile" in a else None
arch = next(x.split("=", 1)[1] for x in a if x.startswith("-DPAN_ARCH="))
src = os.path.join(os.environ["LIBPAN_PREBUILT"], "libpan_v%s.spv" % arch)
shutil.copyfile(src, out)
if dep:
    with open(dep, "w") as f:
        f.write("%s: %s\n" % (out.replace("\\", "/"), src.replace("\\", "/")))
