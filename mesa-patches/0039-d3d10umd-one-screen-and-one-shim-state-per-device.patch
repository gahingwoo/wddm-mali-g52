--- a/src/gallium/auxiliary/util/u_screen.c
+++ b/src/gallium/auxiliary/util/u_screen.c
@@ -229,6 +229,14 @@ equal_file_description(const void *key1, const void *key2)
    if (fd1 == fd2)
       return true;
 
+#ifdef _WIN32
+   /* wddm-mali-g52: the fd is a placeholder (NUL or a pipe end) and says
+    * nothing about the device. Every Direct3D device gets a screen of its
+    * own, bound to that device's runtime callbacks; two placeholders must
+    * never compare equal, whatever fstat makes of them. */
+   return false;
+#endif
+
    ret = os_same_file_description(fd1, fd2);
    if (ret >= 0)
       return (ret == 0);
