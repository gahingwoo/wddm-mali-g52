diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index 5f8160d..3de0580 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -169,6 +169,9 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    pDevice->msaa = pAdapter->msaa;
    pDevice->caps_logged = 0;
    pDevice->cso = cso_create_context(pipe, CSO_NO_VBUF);
+   /* The first draw binds the vertex elements, even if IaSetInputLayout
+    * was never called (update_velems in Draw.cpp). */
+   pDevice->velems_changed = TRUE;
 
    /* D3D10UMD_NO_GS=1 takes the path Panfrost takes on a screen that has
     * the stage (softpipe), so the failure paths can be tested without a
diff --git a/src/gallium/frontends/d3d10umd/Draw.cpp b/src/gallium/frontends/d3d10umd/Draw.cpp
index 142697f..a8c526e 100644
--- a/src/gallium/frontends/d3d10umd/Draw.cpp
+++ b/src/gallium/frontends/d3d10umd/Draw.cpp
@@ -64,6 +64,20 @@ update_velems(Device *pDevice)
       for (unsigned i = 0; i < state->count; i++)
          state->velems[i].src_stride = pDevice->vertex_strides[state->velems[i].vertex_buffer_index];
       cso_set_vertex_elements(pDevice->cso, state);
+   } else {
+      /*
+       * No input layout: the vertex shader reads no attributes (a draw on
+       * SV_VertexID alone). Bind a layout of no elements rather than none
+       * or the previous one. Panfrost reads the bound vertex elements at
+       * every draw and has none until something is bound; the D3D11
+       * runtime's own clear of a part of a view (the region a DComp
+       * surface's BeginDraw gives, on a device that never set a layout)
+       * is such a draw, and crashed at NULL+0x344 in
+       * panfrost_emit_vertex_data (TaishanPi 3M, 2026-11-23).
+       */
+      struct cso_velems_state none;
+      memset(&none, 0, sizeof none);
+      cso_set_vertex_elements(pDevice->cso, &none);
    }
 
    pDevice->velems_changed = false;
