+/*
+ * What the process that opens a shared resource needs to build the same
+ * pipe_resource on the creator's allocation. It travels through the runtime
+ * as private driver data: the resource's, and again behind the kernel
+ * driver's own data in the allocation's. Both sides are this DLL.
+ */
+#define SHARED_DESC_MAGIC0 0x494c414d  /* "MALI" */
+#define SHARED_DESC_MAGIC1 0x31524853  /* "SHR1" */
+
+struct SharedResourceDesc
+{
+   uint32_t Magic0, Magic1;
+   uint32_t Size;
+   uint32_t Target, PipeFormat;
+   uint32_t Width, Height, Depth, ArraySize, LastLevel;
+   uint32_t NrSamples, NrStorageSamples;
+   uint32_t Bind, Usage;
+   uint32_t DxgiFormat, MipLevels;
+};
+
+
+static const SharedResourceDesc *
+FindSharedDesc(const void *pData, UINT Size)
+{
+   const uint8_t *p = (const uint8_t *)pData;
+
+   if (!p)
+      return NULL;
+   for (UINT off = 0; off + sizeof(SharedResourceDesc) <= Size; off += 4) {
+      SharedResourceDesc desc;
+      memcpy(&desc, p + off, sizeof desc);
+      if (desc.Magic0 == SHARED_DESC_MAGIC0 && desc.Magic1 == SHARED_DESC_MAGIC1 &&
+          desc.Size == sizeof desc)
+         return (const SharedResourceDesc *)(p + off);
+   }
+   return NULL;
+}
+
+
+/*
+ * Have the driver treat the buffer as shared for good: Panfrost marks it
+ * when it is exported, and from then on neither returns it to its buffer
+ * cache nor replaces it when it is mapped for writing. The handle itself is
+ * not used; the surface travels through the runtime.
+ */
+static bool
+MarkResourceShared(struct pipe_context *pipe, struct pipe_resource *resource)
+{
+   struct pipe_screen *screen = pipe->screen;
+   struct winsys_handle whandle;
+
+   memset(&whandle, 0, sizeof whandle);
+   whandle.type = WINSYS_HANDLE_TYPE_FD;
+   if (!screen->resource_get_handle ||
+       !screen->resource_get_handle(screen, pipe, resource, &whandle, 0)) {
+      DebugPrintf("  shared: the driver did not export the buffer\n");
+      return false;
+   }
+   _close((int)(intptr_t)whandle.handle);
+   DebugPrintf("  shared: exported, stride %u offset %u modifier 0x%llx\n",
+               whandle.stride, whandle.offset, (unsigned long long)whandle.modifier);
+   return true;
+}
 
 
