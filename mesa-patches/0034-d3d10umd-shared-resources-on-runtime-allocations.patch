+void
+d3d10_shared_begin_create(void *hRTDevice, void *hRTResource, unsigned w, unsigned h,
+                          const void *desc, unsigned desc_size)
+{
+#ifdef GALLIUM_PANFROST
+   malikm_shared_begin_create(hRTDevice, hRTResource, w, h, desc, desc_size);
+#else
+   (void)hRTDevice; (void)hRTResource; (void)w; (void)h; (void)desc; (void)desc_size;
+#endif
+}
+
+void
+d3d10_shared_begin_open(void *hRTDevice, void *hRTResource, unsigned hAllocation)
+{
+#ifdef GALLIUM_PANFROST
+   malikm_shared_begin_open(hRTDevice, hRTResource, hAllocation);
+#else
+   (void)hRTDevice; (void)hRTResource; (void)hAllocation;
+#endif
+}
+
+unsigned
+d3d10_shared_end(void)
+{
+#ifdef GALLIUM_PANFROST
+   return malikm_shared_end();
+#else
+   return 0;
+#endif
+}
+
+void
+d3d10_shared_destroy(void *hRTDevice, void *hRTResource)
+{
+#ifdef GALLIUM_PANFROST
+   malikm_shared_destroy(hRTDevice, hRTResource);
+#else
+   (void)hRTDevice; (void)hRTResource;
+#endif
+}
