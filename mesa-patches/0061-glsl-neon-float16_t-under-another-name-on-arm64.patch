+/* On ARM64 the UCRT's wchar.h, which <vector> reaches, includes
+ * arm_neon.h, and that declares a global float16_t (__fp16), as ir.h does
+ * (mesa::float16_t); clang-cl rejects the second. Nothing here uses NEON:
+ * its float16_t gets another name while <vector> is read, which is before
+ * any Mesa header, so that arm_neon.h is never read again in this file. */
+#if defined(_WIN32) && (defined(_M_ARM64) || defined(_M_ARM64EC))
+#define float16_t neon_float16_t
+#include <vector>
+#undef float16_t
+#else
+#include <vector>
+#endif
+
