+{
+   return S_OK;
+}
+
+static HRESULT __stdcall
+Blt1_12(DXGI_DDI_ARG_BLT1 *p)
+{
+   /* A whole-source blit is the 1.0 Blt; a source rectangle is not
+    * carried out. */
+   DXGI_DDI_ARG_BLT b;
+   memset(&b, 0, sizeof b);
+   b.hDevice = p->hDevice;
+   b.hDstResource = p->hDstResource;
+   b.DstSubresource = p->DstSubresource;
+   b.DstLeft = p->DstLeft;
+   b.DstTop = p->DstTop;
+   b.DstRight = p->DstRight;
+   b.DstBottom = p->DstBottom;
+   b.hSrcResource = p->hSrcResource;
+   b.SrcSubresource = p->SrcSubresource;
+   b.Flags = p->Flags;
+   b.Rotate = p->Rotate;
+   return _Blt(&b);
+}
+
+static HRESULT __stdcall
+OfferResources12(DXGI_DDI_ARG_OFFERRESOURCES *)
+{
+   return S_OK;
+}
+
+static HRESULT __stdcall
+ReclaimResources12(DXGI_DDI_ARG_RECLAIMRESOURCES *p)
+{
+   if (p->pDiscarded)
+      for (UINT i = 0; i < p->Resources; i++)
+         p->pDiscarded[i] = FALSE;
+   return S_OK;
+}
+
+static HRESULT __stdcall
+GetMultiplaneOverlayCaps12(DXGI_DDI_ARG_GETMULTIPLANEOVERLAYCAPS *p)
+{
+   memset(&p->MultiplaneOverlayCaps, 0, sizeof p->MultiplaneOverlayCaps);
+   return S_OK;
+}
