+   f->pfnBlt = _Blt;
+   f->pfnResolveSharedResource = ResolveSharedResource12;
+   f->pfnBlt1 = Blt1_12;
+   f->pfnOfferResources = OfferResources12;
+   f->pfnReclaimResources = ReclaimResources12;
+   f->pfnGetMultiplaneOverlayCaps = GetMultiplaneOverlayCaps12;
+   f->pfnGetMultiplaneOverlayFilterRange = NoMultiplaneOverlay12;
+   f->pfnCheckMultiplaneOverlaySupport =
