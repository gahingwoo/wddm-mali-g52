diff --git a/src/gallium/frontends/d3d10umd/D3D11.cpp b/src/gallium/frontends/d3d10umd/D3D11.cpp
new file mode 100644
index 0000000..bb84b97
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/D3D11.cpp
@@ -0,0 +1,738 @@
+/*
+ * D3D11.cpp --
+ *    The D3D11.1 device interface, offered only where video decode is on.
+ *
+ * The D3D11 runtime exposes ID3D11VideoDevice only on a driver whose
+ * device interface is D3D11.1 or later; the D3D10.x interface this
+ * frontend has always offered gets no video at all. So a process that
+ * decodes (Adapter::video, Video.cpp) is offered D3D11_1_DDI_INTERFACE_VERSION
+ * at feature level 10_0 or 10_1, and its device is the same D3D10.x
+ * implementation behind the D3D11.1 table: the entry points whose
+ * signature did not change are the same functions, the ones that gained
+ * parameters are wrapped below, and the D3D11 stages this hardware path
+ * does not have (hull, domain, compute, unordered access, command lists)
+ * are entry points that do nothing. At 10_x the runtime does not call
+ * those; with no D3D11DDICAPS_COMMANDLISTS it emulates deferred contexts
+ * itself.
+ *
+ * Every other process keeps the D3D10.x interface and never reaches this
+ * file.
+ *
+ * Copyright (c) 2026 Ga Hing Woo <gahing@gahingwoo.com>
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "DriverIncludes.h"
+#include "D3D11.h"
+#include "Draw.h"
+#include "DxgiFns.h"
+#include "InputAssembly.h"
+#include "OutputMerger.h"
+#include "Query.h"
+#include "Rasterizer.h"
+#include "Resource.h"
+#include "Shader.h"
+#include "State.h"
+#include "Debug.h"
+
+#include <stddef.h>
+#include <string.h>
+
+/* The few entry points of Device.cpp's own, the same for every device. */
+static D3D11DeviceStatics Statics;
+
+
+/* ----------------------------------------------------------- wrappers */
+
+static VOID APIENTRY
+UpdateSubresourceUP11(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hResource, UINT Sub,
+                      const D3D10_DDI_BOX *pBox, const VOID *pData, UINT RowPitch,
+                      UINT DepthPitch, UINT CopyFlags)
+{
+   /* D3D11_COPY_NO_OVERWRITE and _DISCARD only promise what the caller
+    * will not touch; a synchronized update keeps both promises. */
+   (void)CopyFlags;
+   ResourceUpdateSubResourceUP(hDevice, hResource, Sub, pBox, pData, RowPitch, DepthPitch);
+}
+
+static VOID APIENTRY
+CopyRegion11(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDst, UINT DstSub, UINT X, UINT Y,
+             UINT Z, D3D10DDI_HRESOURCE hSrc, UINT SrcSub, const D3D10_DDI_BOX *pBox,
+             UINT CopyFlags)
+{
+   (void)CopyFlags;
+   ResourceCopyRegion(hDevice, hDst, DstSub, X, Y, Z, hSrc, SrcSub, pBox);
+}
+
+#define CB11(stage, name)                                                            \
+   static VOID APIENTRY                                                              \
+   name(D3D10DDI_HDEVICE hDevice, UINT Start, UINT Num, const D3D10DDI_HRESOURCE *ph, \
+        const UINT *pFirst, const UINT *pNum)                                         \
+   {                                                                                 \
+      SetConstantBuffers1(stage, hDevice, Start, Num, ph, pFirst, pNum);             \
+   }
+CB11(MESA_SHADER_VERTEX, VsSetConstantBuffers11)
+CB11(MESA_SHADER_FRAGMENT, PsSetConstantBuffers11)
+CB11(MESA_SHADER_GEOMETRY, GsSetConstantBuffers11)
+
+static VOID APIENTRY
+NoSetConstantBuffers11(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HRESOURCE *,
+                       const UINT *, const UINT *)
+{
+}
+
+static VOID APIENTRY
+SetRenderTargets11(D3D10DDI_HDEVICE hDevice, const D3D10DDI_HRENDERTARGETVIEW *phRTV,
+                   UINT NumRTVs, UINT ClearSlots, D3D10DDI_HDEPTHSTENCILVIEW hDSV,
+                   const D3D11DDI_HUNORDEREDACCESSVIEW *, const UINT *, UINT, UINT, UINT, UINT)
+{
+   /* No unordered access views below feature level 11_0. */
+   SetRenderTargets(hDevice, phRTV, NumRTVs, ClearSlots, hDSV);
+}
+
+static BOOL APIENTRY
+Flush11(D3D10DDI_HDEVICE hDevice, UINT FlushFlags)
+{
+   (void)FlushFlags;
+   Statics.Flush(hDevice);
+   return TRUE;
+}
+
+static VOID APIENTRY
+RelocateDeviceFuncs11(D3D10DDI_HDEVICE, D3D11_1DDI_DEVICEFUNCS *)
+{
+   DebugPrintf("RelocateDeviceFuncs11: the runtime moved the D3D11.1 table\n");
+}
+
+static SIZE_T APIENTRY
+CalcPrivateResourceSize11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *p)
+{
+   /* D3D10DDIARG_CREATERESOURCE is the start of D3D11DDIARG_CREATERESOURCE. */
+   return CalcPrivateResourceSize(hDevice, (const D3D10DDIARG_CREATERESOURCE *)p);
+}
+
+static VOID APIENTRY
+CreateResource11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *p,
+                 D3D10DDI_HRESOURCE hResource, D3D10DDI_HRTRESOURCE hRTResource)
+{
+   CreateResource(hDevice, (const D3D10DDIARG_CREATERESOURCE *)p, hResource, hRTResource);
+}
+
+/* D3D10_1DDIARG_CREATESHADERRESOURCEVIEW is the start of the D3D11 form,
+ * whose union only adds BufferEx (raw buffers, not below 11_0). */
+static SIZE_T APIENTRY
+CalcPrivateShaderResourceViewSize11(D3D10DDI_HDEVICE hDevice,
+                                    const D3D11DDIARG_CREATESHADERRESOURCEVIEW *p)
+{
+   return CalcPrivateShaderResourceViewSize1(hDevice,
+                                             (const D3D10_1DDIARG_CREATESHADERRESOURCEVIEW *)p);
+}
+
+static VOID APIENTRY
+CreateShaderResourceView11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *p,
+                           D3D10DDI_HSHADERRESOURCEVIEW h, D3D10DDI_HRTSHADERRESOURCEVIEW hrt)
+{
+   CreateShaderResourceView1(hDevice, (const D3D10_1DDIARG_CREATESHADERRESOURCEVIEW *)p, h, hrt);
+}
+
+static void
+DepthStencilView10(const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *p,
+                   D3D10DDIARG_CREATEDEPTHSTENCILVIEW *o)
+{
+   memset(o, 0, sizeof *o);
+   o->hDrvResource = p->hDrvResource;
+   o->Format = p->Format;
+   o->ResourceDimension = p->ResourceDimension;
+   /* Flags (read-only depth or stencil) dropped: the view then writes. */
+   memcpy(&o->Tex1D, &p->Tex1D,
+          MIN2(sizeof *o - offsetof(D3D10DDIARG_CREATEDEPTHSTENCILVIEW, Tex1D),
+               sizeof *p - offsetof(D3D11DDIARG_CREATEDEPTHSTENCILVIEW, Tex1D)));
+}
+
+static SIZE_T APIENTRY
+CalcPrivateDepthStencilViewSize11(D3D10DDI_HDEVICE hDevice,
+                                  const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *p)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW o;
+   DepthStencilView10(p, &o);
+   return CalcPrivateDepthStencilViewSize(hDevice, &o);
+}
+
+static VOID APIENTRY
+CreateDepthStencilView11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *p,
+                         D3D10DDI_HDEPTHSTENCILVIEW h, D3D10DDI_HRTDEPTHSTENCILVIEW hrt)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW o;
+   DepthStencilView10(p, &o);
+   CreateDepthStencilView(hDevice, &o, h, hrt);
+}
+
+static void
+BlendDesc10(const D3D11_1_DDI_BLEND_DESC *p, D3D10_1_DDI_BLEND_DESC *o)
+{
+   memset(o, 0, sizeof *o);
+   o->AlphaToCoverageEnable = p->AlphaToCoverageEnable;
+   o->IndependentBlendEnable = p->IndependentBlendEnable;
+   for (unsigned i = 0; i < D3D10_DDI_SIMULTANEOUS_RENDER_TARGET_COUNT; i++) {
+      /* Logic ops are not offered (D3D11_1DDICAPS_D3D11_OPTIONS zero). */
+      o->RenderTarget[i].BlendEnable = p->RenderTarget[i].BlendEnable;
+      o->RenderTarget[i].SrcBlend = p->RenderTarget[i].SrcBlend;
+      o->RenderTarget[i].DestBlend = p->RenderTarget[i].DestBlend;
+      o->RenderTarget[i].BlendOp = p->RenderTarget[i].BlendOp;
+      o->RenderTarget[i].SrcBlendAlpha = p->RenderTarget[i].SrcBlendAlpha;
+      o->RenderTarget[i].DestBlendAlpha = p->RenderTarget[i].DestBlendAlpha;
+      o->RenderTarget[i].BlendOpAlpha = p->RenderTarget[i].BlendOpAlpha;
+      o->RenderTarget[i].RenderTargetWriteMask = p->RenderTarget[i].RenderTargetWriteMask;
+   }
+}
+
+static SIZE_T APIENTRY
+CalcPrivateBlendStateSize11(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_BLEND_DESC *p)
+{
+   D3D10_1_DDI_BLEND_DESC o;
+   BlendDesc10(p, &o);
+   return CalcPrivateBlendStateSize1(hDevice, &o);
+}
+
+static VOID APIENTRY
+CreateBlendState11(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_BLEND_DESC *p,
+                   D3D10DDI_HBLENDSTATE h, D3D10DDI_HRTBLENDSTATE hrt)
+{
+   D3D10_1_DDI_BLEND_DESC o;
+   BlendDesc10(p, &o);
+   CreateBlendState1(hDevice, &o, h, hrt);
+}
+
+static void
+RasterizerDesc10(const D3D11_1_DDI_RASTERIZER_DESC *p, D3D10_DDI_RASTERIZER_DESC *o)
+{
+   memset(o, 0, sizeof *o);
+   o->FillMode = p->FillMode;
+   o->CullMode = p->CullMode;
+   o->FrontCounterClockwise = p->FrontCounterClockwise;
+   o->DepthBias = p->DepthBias;
+   o->DepthBiasClamp = p->DepthBiasClamp;
+   o->SlopeScaledDepthBias = p->SlopeScaledDepthBias;
+   o->DepthClipEnable = p->DepthClipEnable;
+   o->ScissorEnable = p->ScissorEnable;
+   o->MultisampleEnable = p->MultisampleEnable;
+   o->AntialiasedLineEnable = p->AntialiasedLineEnable;
+   /* ForcedSampleCount: target-independent rasterization is 11_0+. */
+}
+
+static SIZE_T APIENTRY
+CalcPrivateRasterizerStateSize11(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_RASTERIZER_DESC *p)
+{
+   D3D10_DDI_RASTERIZER_DESC o;
+   RasterizerDesc10(p, &o);
+   return CalcPrivateRasterizerStateSize(hDevice, &o);
+}
+
+static VOID APIENTRY
+CreateRasterizerState11(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_RASTERIZER_DESC *p,
+                        D3D10DDI_HRASTERIZERSTATE h, D3D10DDI_HRTRASTERIZERSTATE hrt)
+{
+   D3D10_DDI_RASTERIZER_DESC o;
+   RasterizerDesc10(p, &o);
+   CreateRasterizerState(hDevice, &o, h, hrt);
+}
+
+/* The shaders: the frontend does not read the signatures (it takes the
+ * declarations from the bytecode), and the D3D11.1 entries are larger, so
+ * none is passed on. */
+static const D3D10DDIARG_STAGE_IO_SIGNATURES NoSignatures = {};
+
+static SIZE_T APIENTRY
+CalcPrivateShaderSize11(D3D10DDI_HDEVICE hDevice, const UINT *pCode,
+                        const D3D11_1DDIARG_STAGE_IO_SIGNATURES *)
+{
+   return CalcPrivateShaderSize(hDevice, pCode, &NoSignatures);
+}
+
+static VOID APIENTRY
+CreateVertexShader11(D3D10DDI_HDEVICE hDevice, const UINT *pCode, D3D10DDI_HSHADER h,
+                     D3D10DDI_HRTSHADER hrt, const D3D11_1DDIARG_STAGE_IO_SIGNATURES *)
+{
+   CreateVertexShader(hDevice, pCode, h, hrt, &NoSignatures);
+}
+
+static VOID APIENTRY
+CreateGeometryShader11(D3D10DDI_HDEVICE hDevice, const UINT *pCode, D3D10DDI_HSHADER h,
+                       D3D10DDI_HRTSHADER hrt, const D3D11_1DDIARG_STAGE_IO_SIGNATURES *)
+{
+   CreateGeometryShader(hDevice, pCode, h, hrt, &NoSignatures);
+}
+
+static VOID APIENTRY
+CreatePixelShader11(D3D10DDI_HDEVICE hDevice, const UINT *pCode, D3D10DDI_HSHADER h,
+                    D3D10DDI_HRTSHADER hrt, const D3D11_1DDIARG_STAGE_IO_SIGNATURES *)
+{
+   CreatePixelShader(hDevice, pCode, h, hrt, &NoSignatures);
+}
+
+/* Stream output from the D3D11 form: one stream, the first buffer's
+ * stride (what D3D10 could express). */
+#define SO11_MAX_ENTRIES 64
+
+static bool
+StreamOutput10(const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *p,
+               D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *o,
+               D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY *entries)
+{
+   UINT n = 0;
+
+   if (p->NumEntries > SO11_MAX_ENTRIES)
+      return false;
+   for (UINT i = 0; i < p->NumEntries; i++) {
+      if (p->pOutputStreamDecl[i].Stream != 0)
+         continue;
+      entries[n].OutputSlot = p->pOutputStreamDecl[i].OutputSlot;
+      entries[n].RegisterIndex = p->pOutputStreamDecl[i].RegisterIndex;
+      entries[n].RegisterMask = p->pOutputStreamDecl[i].RegisterMask;
+      n++;
+   }
+   memset(o, 0, sizeof *o);
+   o->pShaderCode = p->pShaderCode;
+   o->pOutputStreamDecl = entries;
+   o->NumEntries = n;
+   o->StreamOutputStrideInBytes = p->NumStrides ? p->BufferStridesInBytes[0] : 0;
+   return true;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateGeometryShaderWithStreamOutput11(D3D10DDI_HDEVICE hDevice,
+                                            const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *p,
+                                            const D3D11_1DDIARG_STAGE_IO_SIGNATURES *)
+{
+   D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT o;
+   D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY entries[SO11_MAX_ENTRIES];
+   if (!StreamOutput10(p, &o, entries))
+      return sizeof(Shader);
+   return CalcPrivateGeometryShaderWithStreamOutput(hDevice, &o, &NoSignatures);
+}
+
+static VOID APIENTRY
+CreateGeometryShaderWithStreamOutput11(D3D10DDI_HDEVICE hDevice,
+                                       const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *p,
+                                       D3D10DDI_HSHADER h, D3D10DDI_HRTSHADER hrt,
+                                       const D3D11_1DDIARG_STAGE_IO_SIGNATURES *)
+{
+   D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT o;
+   D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY entries[SO11_MAX_ENTRIES];
+   if (!StreamOutput10(p, &o, entries)) {
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   CreateGeometryShaderWithStreamOutput(hDevice, &o, h, hrt, &NoSignatures);
+}
+
+/* ------------------------------------- what feature level 10_x has not */
+
+static VOID APIENTRY NoDrawIndirect(D3D10DDI_HDEVICE, D3D10DDI_HRESOURCE, UINT) {}
+static VOID APIENTRY NoCommandListExecute(D3D10DDI_HDEVICE, D3D11DDI_HCOMMANDLIST) {}
