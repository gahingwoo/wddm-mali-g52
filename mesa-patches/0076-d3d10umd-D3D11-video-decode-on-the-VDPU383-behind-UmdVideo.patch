+   f->pfnGetVideoDecoderBufferInfo = VideoGetVideoDecoderBufferInfo;
+   f->pfnCalcPrivateVideoDecoderSize = VideoCalcPrivateVideoDecoderSize;
+   f->pfnCreateVideoDecoder = VideoCreateVideoDecoder;
+   f->pfnDestroyVideoDecoder = VideoDestroyVideoDecoder;
+   f->pfnVideoDecoderExtension = VideoStubVideoDecoderExtension;
+   f->pfnVideoDecoderBeginFrame = VideoVideoDecoderBeginFrame;
+   f->pfnVideoDecoderEndFrame = VideoVideoDecoderEndFrame;
+   f->pfnVideoDecoderSubmitBuffers = VideoVideoDecoderSubmitBuffers;
+   f->pfnCalcPrivateVideoProcessorEnumSize = VideoStubCalcPrivateVideoProcessorEnumSize;
+   f->pfnCreateVideoProcessorEnum = VideoStubCreateVideoProcessorEnum;
+   f->pfnDestroyVideoProcessorEnum = VideoStubDestroyVideoProcessorEnum;
+   f->pfnCheckVideoProcessorFormat = VideoStubCheckVideoProcessorFormat;
+   f->pfnGetVideoProcessorCaps = VideoStubGetVideoProcessorCaps;
+   f->pfnGetVideoProcessorRateConversionCaps = VideoStubGetVideoProcessorRateConversionCaps;
+   f->pfnGetVideoProcessorCustomRate = VideoStubGetVideoProcessorCustomRate;
+   f->pfnGetVideoProcessorFilterRange = VideoStubGetVideoProcessorFilterRange;
