+static VOID APIENTRY
+ClearView11(D3D10DDI_HDEVICE hDevice, D3D11DDI_HANDLETYPE viewType, VOID *hView,
+            const FLOAT Color[4], const D3D10_DDI_RECT *, UINT NumRects)
+{
+   /* A whole render target view only; rectangles and the other view
+    * kinds are left alone (logged). */
+   if (viewType == D3D10DDI_HT_RENDERTARGETVIEW && NumRects == 0) {
+      D3D10DDI_HRENDERTARGETVIEW h;
+      FLOAT c[4] = { Color[0], Color[1], Color[2], Color[3] };
+      h.pDrvPrivate = hView;
+      ClearRenderTargetView(hDevice, h, c);
+      return;
+   }
+   DebugPrintf("ClearView11: view type %u with %u rectangles not cleared\n",
+               (unsigned)viewType, NumRects);
+}
