+/*
+ * Video.cpp --
+ *    D3D11 video decode: the D3D11.1 video DDI, H.264 on the RK3576 VDPU383.
+ *
+ * What a player does (FFmpeg's d3d11va, mpv, Media Foundation's H.264
+ * decoder, Chromium's D3D11VideoDecoder) and where it lands here:
+ *
+ *    ID3D11VideoDevice::GetVideoDecoderProfile...   VideoGetVideoDecoderProfile*
+ *    CreateTexture2D(NV12, BIND_DECODER, array)     Resource.cpp (NV12 as R8, Y over UV)
+ *    CreateVideoDecoderOutputView                   VideoCreateVideoDecoderOutputView
+ *    CreateVideoDecoder                             VideoCreateVideoDecoder (vdec_h264_create)
+ *    GetDecoderBuffer / ReleaseDecoderBuffer        the runtime's buffers, Resource.cpp
+ *    DecoderBeginFrame                              VideoVideoDecoderBeginFrame
+ *    SubmitDecoderBuffers                           VideoVideoDecoderSubmitBuffers (copied)
+ *    DecoderEndFrame                                VideoVideoDecoderEndFrame: decode, copy
+ *
+ * The picture is decoded by the VDPU383 into a surface of the decoder's own
+ * (video/vdec.c; one per DXVA surface index, references are read from
+ * there) and copied into the application's texture at the end of the
+ * frame. That copy is the price of milestone V3a: the decoder writes
+ * contiguous memory of vdpu383.sys, the texture is an allocation of
+ * maliwddm's, and only the KMD could map one into the other (V3b in
+ * docs/VIDEO-DECODE.md).
+ *
+ * Off unless maliwddm's UmdVideo is set, and then only in the processes
+ * VideoEffective names: the D3D11.1 interface this needs is offered
+ * nowhere else.
+ *
+ * Copyright (c) 2026 Ga Hing Woo <gahing@gahingwoo.com>
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "DriverIncludes.h"
+#include "Video.h"
+#include "State.h"
+#include "Debug.h"
+
+#include "util/box.h"
+#include "util/u_inlines.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "video/vdec.h"
+
+
+/* ----------------------------------------------------------- settings */
+
+static bool
+ProcessIs(const char *const *names, unsigned count)
+{
+   char path[MAX_PATH];
+   DWORD n = GetModuleFileNameA(NULL, path, sizeof path);
+   const char *base = path;
+
+   if (n == 0 || n >= sizeof path)
+      return false;
+   for (const char *c = path; *c; c++)
+      if (*c == '\\' || *c == '/')
+         base = c + 1;
+   for (unsigned i = 0; i < count; i++)
+      if (_stricmp(base, names[i]) == 0)
+         return true;
+   return false;
+}
+
+/*
+ * UmdVideo (maliwddm Device Parameters, default 0):
+ *   0  nothing changes anywhere.
+ *   1  the D3D11.1 interface and the video DDI with no decoder profiles,
+ *      in the processes below: a player sees a video device and decodes
+ *      in software, which checks the new interface alone.
+ *   2  the same with the VDPU383's H.264 profile.
+ *   3  2 in every process but the compositor and the logon screen
+ *      (for players not on the list; Media Foundation decodes in the
+ *      application's process).
+ */
+unsigned
+VideoEffective(unsigned setting)
+{
+   static const char *const players[] = {
+      "mpv.exe", "ffmpeg.exe", "ffplay.exe", "ffprobe.exe", "vlc.exe",
+      "vdectest.exe", "d3dprobe.exe",
+   };
+   static const char *const never[] = {
+      "dwm.exe", "logonui.exe", "consent.exe",
+   };
+
+   if (setting == 0 || setting > 3)
+      return 0;
+   if (ProcessIs(never, ARRAYSIZE(never)))
+      return 0;
+   if (setting == 3)
+      return 2;
+   return ProcessIs(players, ARRAYSIZE(players)) ? setting : 0;
+}
+
+/* -------------------------------------------------------------- GUIDs */
+
+/* D3D11_DECODER_PROFILE_H264_VLD_NOFGT (DXVA_ModeH264_E) */
+static const GUID ProfileH264 =
+   { 0x1b81be68, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+/* DXVA_NoEncrypt */
+static const GUID NoEncrypt =
+   { 0x1b81bed0, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+
+/* The VDPU383's H.264 limit (vendor: 4096x2304; the board has run CIF). */
+#define VIDEO_MAX_WIDTH  4096
+#define VIDEO_MAX_HEIGHT 2304
+
+static bool
+ProfilesOffered(const Device *pDevice)
+{
+   return pDevice->video >= 2 && vdec_available();
+}
+
+/* ------------------------------------------------------------ objects */
+
+struct VideoOutputView {
+   Resource *resource;
+   UINT slice;
+};
+
+struct VideoDecoder {
+   UINT width, height;
+   vdec_h264 *dec;
+   VideoOutputView *target;
+   bool have_pp, have_qm;
+   V383_DXVA_PicParams_H264 pp;
+   V383_DXVA_Qmatrix_H264 qm;
+   uint8_t *bitstream;
+   unsigned bitstream_len, bitstream_cap;
+   unsigned slices;
+   unsigned frames, errors, logged;
+};
+
+static inline VideoDecoder *
+CastDecoder(D3D11_1DDI_HDECODE h)
+{
+   return (VideoDecoder *)h.pDrvPrivate;
+}
+
+static inline VideoOutputView *
+CastOutputView(D3D11_1DDI_HVIDEODECODEROUTPUTVIEW h)
+{
+   return (VideoOutputView *)h.pDrvPrivate;
+}
+
+UINT
+VideoNv12FormatSupport(Device *pDevice)
+{
+   /* NV12 exists on a D3D11.1 device only. As a decoder output now;
+    * sampled as two planes and video processor input come with V4. */
+   if (!pDevice->ddi11_1 || !pDevice->video)
+      return 0;
+   return D3D11_1DDI_FORMAT_SUPPORT_DECODER_OUTPUT;
+}
+
+/* -------------------------------------------------------- decoder caps */
+
+static VOID APIENTRY
+VideoGetVideoDecoderProfileCount(D3D10DDI_HDEVICE hDevice, UINT *pCount)
+{
+   Device *pDevice = CastDevice(hDevice);
+   *pCount = ProfilesOffered(pDevice) ? 1 : 0;
+   DebugPrintf("video: %u decoder profile(s) (UmdVideo here %u, decoder %s)\n", *pCount,
+               pDevice->video, vdec_available() ? "available" : "absent");
+}
+
+static VOID APIENTRY
+VideoGetVideoDecoderProfile(D3D10DDI_HDEVICE hDevice, UINT Index, GUID *pGuid)
+{
+   (void)hDevice;
+   (void)Index;
+   *pGuid = ProfileH264;
+}
+
+static bool
+DescSupported(Device *pDevice, const GUID *guid, DXGI_FORMAT format)
+{
+   return ProfilesOffered(pDevice) && IsEqualGUID(*guid, ProfileH264) && format == DXGI_FORMAT_NV12;
+}
+
+static VOID APIENTRY
+VideoCheckVideoDecoderFormat(D3D10DDI_HDEVICE hDevice, const GUID *pGuid, DXGI_FORMAT Format,
+                             BOOL *pSupported)
+{
+   *pSupported = DescSupported(CastDevice(hDevice), pGuid, Format);
+}
+
+static VOID APIENTRY
+VideoGetVideoDecoderConfigCount(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc,
+                                UINT *pCount)
+{
+   *pCount = DescSupported(CastDevice(hDevice), &pDesc->Guid, pDesc->OutputFormat) &&
+             pDesc->SampleWidth <= VIDEO_MAX_WIDTH && pDesc->SampleHeight <= VIDEO_MAX_HEIGHT ? 1 : 0;
+}
+
+static VOID APIENTRY
+VideoGetVideoDecoderConfig(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc,
+                           UINT Index, D3D11_1DDI_VIDEO_DECODER_CONFIG *pConfig)
+{
+   (void)hDevice;
+   (void)pDesc;
+   (void)Index;
+   memset(pConfig, 0, sizeof *pConfig);
+   pConfig->guidConfigBitstreamEncryption = NoEncrypt;
+   pConfig->guidConfigMBcontrolEncryption = NoEncrypt;
+   pConfig->guidConfigResidDiffEncryption = NoEncrypt;
+   /* 2: DXVA_Slice_H264_Short, the bitstream with its start codes, which
+    * is what the VDPU383 reads (and the only form Chromium accepts). */
+   pConfig->ConfigBitstreamRaw = 2;
+}
+
+static const D3D11_1DDI_VIDEO_DECODER_BUFFER_TYPE BufferTypes[] = {
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS,
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX,
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL,
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_BITSTREAM,
+};
+
+static UINT
+BitstreamBufferSize(UINT width, UINT height)
+{
+   UINT size = width * height * 3 / 4;
+   return MAX2(1u << 20, MIN2(size, 16u << 20));
+}
+
+static VOID APIENTRY
+VideoGetVideoDecoderBufferTypeCount(D3D10DDI_HDEVICE, const D3D11_1DDI_VIDEO_DECODER_DESC *,
+                                    UINT *pCount)
+{
+   *pCount = ARRAYSIZE(BufferTypes);
+}
+
+static VOID APIENTRY
+VideoGetVideoDecoderBufferInfo(D3D10DDI_HDEVICE, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc,
+                               UINT Index, D3D11_1DDI_VIDEO_DECODER_BUFFER_INFO *pInfo)
+{
+   memset(pInfo, 0, sizeof *pInfo);
+   if (Index >= ARRAYSIZE(BufferTypes))
+      return;
+   pInfo->Type = BufferTypes[Index];
+   switch (pInfo->Type) {
+   case D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS:
+      pInfo->Size = 4096;
+      break;
+   case D3D11_1DDI_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX:
+      pInfo->Size = 4096;
+      break;
+   case D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL:
+      pInfo->Size = 64 * 1024;
+      break;
+   default:
+      pInfo->Size = BitstreamBufferSize(pDesc->SampleWidth, pDesc->SampleHeight);
+      break;
+   }
+   /* Written by the CPU, read back by the CPU here: staging memory. */
+   pInfo->Usage = D3D10_DDI_USAGE_STAGING;
+}
+
+/* ------------------------------------------------------------ decoder */
+
+static SIZE_T APIENTRY
+VideoCalcPrivateVideoDecoderSize(D3D10DDI_HDEVICE, const D3D11_1DDIARG_CREATEVIDEODECODER *)
+{
+   return sizeof(VideoDecoder);
+}
+
+static HRESULT APIENTRY
+VideoCreateVideoDecoder(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEODECODER *pCreate,
+                        D3D11_1DDI_HDECODE hDecode, D3D11_1DDI_HRTDECODE)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoDecoder *d = CastDecoder(hDecode);
+   char err[160] = "";
+
+   memset(d, 0, sizeof *d);
+   if (!DescSupported(pDevice, &pCreate->Desc.Guid, pCreate->Desc.OutputFormat) ||
+       pCreate->Config.ConfigBitstreamRaw != 2) {
+      DebugPrintf("video: CreateVideoDecoder refused (profile, format %u or bitstream form %u)\n",
+                  (unsigned)pCreate->Desc.OutputFormat, pCreate->Config.ConfigBitstreamRaw);
+      return E_INVALIDARG;
+   }
+   d->width = pCreate->Desc.SampleWidth;
+   d->height = pCreate->Desc.SampleHeight;
+   d->dec = vdec_h264_create(d->width, d->height, err, sizeof err);
+   if (!d->dec) {
+      DebugPrintf("video: CreateVideoDecoder %ux%u: %s\n", d->width, d->height, err);
+      return E_OUTOFMEMORY;
+   }
+   DebugPrintf("video: H.264 decoder %ux%u created\n", d->width, d->height);
+   return S_OK;
+}
+
+static VOID APIENTRY
+VideoDestroyVideoDecoder(D3D10DDI_HDEVICE, D3D11_1DDI_HDECODE hDecode)
+{
+   VideoDecoder *d = CastDecoder(hDecode);
+   vdec_stats st;
+
+   vdec_get_stats(&st);
+   DebugPrintf("video: decoder %ux%u destroyed after %u frames, %u errors; process total %u "
+               "pictures, %u errors, %u us in the decoder, driver runs %u%s\n",
+               d->width, d->height, d->frames, d->errors, st.pictures, st.errors,
+               st.hw_us_total, st.driver_runs, st.fake ? " (fake)" : "");
+   vdec_h264_destroy(d->dec);
+   free(d->bitstream);
+   memset(d, 0, sizeof *d);
+}
+
+static HRESULT APIENTRY
+VideoVideoDecoderBeginFrame(D3D10DDI_HDEVICE, D3D11_1DDI_HDECODE hDecode,
+                            const D3D11_1DDIARG_VIDEODECODERBEGINFRAME *pBegin)
+{
+   VideoDecoder *d = CastDecoder(hDecode);
+
+   if (pBegin->pContentKey)
+      return E_INVALIDARG;
+   d->target = CastOutputView(pBegin->hOutputView);
+   d->have_pp = d->have_qm = false;
+   d->bitstream_len = 0;
+   d->slices = 0;
+   return S_OK;
+}
+
+/* The bytes of a decoder buffer (the runtime's staging buffer). */
+static bool
+ReadBuffer(Device *pDevice, const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *desc, void *dst,
+           unsigned max, unsigned *got)
+{
+   Resource *r = CastResource(desc->hResource);
+   struct pipe_transfer *transfer;
+   unsigned size = desc->DataSize;
+
+   *got = 0;
+   if (!r || !r->resource || !r->buffer)
+      return false;
+   if (desc->DataOffset >= r->resource->width0)
+      return false;
+   size = MIN2(size, r->resource->width0 - desc->DataOffset);
+   size = MIN2(size, max);
+   const uint8_t *map = (const uint8_t *)pipe_buffer_map(pDevice->pipe, r->resource, PIPE_MAP_READ,
+                                                         &transfer);
+   if (!map)
+      return false;
+   memcpy(dst, map + desc->DataOffset, size);
+   pipe_buffer_unmap(pDevice->pipe, transfer);
+   *got = size;
+   return true;
+}
+
+static HRESULT APIENTRY
+VideoVideoDecoderSubmitBuffers(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode, UINT Count,
+                               const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *pDescs)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoDecoder *d = CastDecoder(hDecode);
+   unsigned got;
+
+   for (UINT i = 0; i < Count; i++) {
+      const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *b = &pDescs[i];
+
+      if (b->pIV || b->PartialEncryption)
+         return E_INVALIDARG;
+      switch (b->BufferType) {
+      case D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS:
+         memset(&d->pp, 0, sizeof d->pp);
+         d->have_pp = ReadBuffer(pDevice, b, &d->pp, sizeof d->pp, &got) && got >= sizeof d->pp;
+         break;
+      case D3D11_1DDI_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX:
+         memset(&d->qm, 0, sizeof d->qm);
+         d->have_qm = ReadBuffer(pDevice, b, &d->qm, sizeof d->qm, &got) && got >= sizeof d->qm;
+         break;
+      case D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL:
+         /* The short form only says where each slice starts; the decoder
+          * finds the slices from their start codes. */
+         d->slices += b->DataSize / 10;     /* sizeof(DXVA_Slice_H264_Short) */
+         break;
+      case D3D11_1DDI_VIDEO_DECODER_BUFFER_BITSTREAM: {
+         unsigned need = d->bitstream_len + b->DataSize;
+         if (need > d->bitstream_cap) {
+            uint8_t *n = (uint8_t *)realloc(d->bitstream, need);
+            if (!n)
+               return E_OUTOFMEMORY;
+            d->bitstream = n;
+            d->bitstream_cap = need;
+         }
+         if (ReadBuffer(pDevice, b, d->bitstream + d->bitstream_len, b->DataSize, &got))
+            d->bitstream_len += got;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+   return S_OK;
+}
+
+/* The decoded picture into the application's texture: luma rows, then the
+ * interleaved chroma rows below them (Resource.cpp's NV12). */
+static bool
+CopyToTarget(Device *pDevice, VideoOutputView *v, const vdec_picture *pic)
+{
+   Resource *r = v->resource;
+   struct pipe_context *pipe = pDevice->pipe;
+   struct pipe_box box;
+   unsigned w, h;
+
+   if (!r || !r->resource || !r->nv12)
+      return false;
+   w = MIN2(r->resource->width0, pic->stride);
+   h = MIN2(r->nv12_luma_height, pic->luma_rows);
+   u_box_3d(0, 0, v->slice, w, h, 1, &box);
+   pipe->texture_subdata(pipe, r->resource, 0, PIPE_MAP_WRITE, &box, pic->data, pic->stride, 0);
+   u_box_3d(0, r->nv12_luma_height, v->slice, w, h / 2, 1, &box);
+   pipe->texture_subdata(pipe, r->resource, 0, PIPE_MAP_WRITE, &box,
+                         pic->data + (size_t)pic->stride * pic->luma_rows, pic->stride, 0);
+   return true;
+}
+
+static VOID APIENTRY
+VideoVideoDecoderEndFrame(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoDecoder *d = CastDecoder(hDecode);
+   vdec_picture pic;
+   char err[160] = "";
+   bool ok = false;
+
+   if (!d->target || !d->have_pp || !d->bitstream_len) {
+      snprintf(err, sizeof err, "incomplete frame (view %d, parameters %d, %u bitstream bytes)",
+               d->target != NULL, d->have_pp, d->bitstream_len);
+   } else if (vdec_h264_decode(d->dec, &d->pp, d->have_qm ? &d->qm : NULL, d->bitstream,
+                               d->bitstream_len, &pic, err, sizeof err) == 0) {
+      ok = CopyToTarget(pDevice, d->target, &pic);
+      if (!ok)
+         snprintf(err, sizeof err, "the output view is not an NV12 texture");
+   }
+
+   d->frames++;
+   if (!ok) {
+      d->errors++;
+      /* The frame is wrong, not the device: nothing reported that would
+       * remove it (mesa-patches 0069). */
+      if (d->logged++ < 20)
+         DebugPrintf("video: frame %u (surface %u, %u slices): %s\n", d->frames,
+                     V383_PIC_INDEX(d->pp.CurrPic), d->slices, err);
+   } else if (d->frames <= 3 || (d->frames % 300) == 0) {
+      DebugPrintf("video: frame %u decoded into slice %u (surface %u, %u slices, %u bytes)\n",
+                  d->frames, d->target->slice, V383_PIC_INDEX(d->pp.CurrPic), d->slices,
+                  d->bitstream_len);
+   }
+   d->target = NULL;
+}
+
+/* -------------------------------------------------------- output view */
+
+static SIZE_T APIENTRY
+VideoCalcPrivateVideoDecoderOutputViewSize(D3D10DDI_HDEVICE,
+                                           const D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *)
+{
+   return sizeof(VideoOutputView);
+}
+
+static HRESULT APIENTRY
+VideoCreateVideoDecoderOutputView(D3D10DDI_HDEVICE, const D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *p,
+                                  D3D11_1DDI_HVIDEODECODEROUTPUTVIEW hView,
+                                  D3D11_1DDI_HRTVIDEODECODEROUTPUTVIEW)
+{
+   VideoOutputView *v = CastOutputView(hView);
+   Resource *r = CastResource(p->hDrvResource);
+
+   memset(v, 0, sizeof *v);
+   if (!r || !r->nv12 || !IsEqualGUID(p->DecodeProfile, ProfileH264) ||
+       p->FirstArraySlice >= r->resource->array_size)
+      return E_INVALIDARG;
+   v->resource = r;
+   v->slice = p->FirstArraySlice;
+   return S_OK;
+}
+
+static VOID APIENTRY
+VideoDestroyVideoDecoderOutputView(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEODECODEROUTPUTVIEW hView)
+{
+   memset(CastOutputView(hView), 0, sizeof(VideoOutputView));
+}
+
+/* ------------------------------------------- the rest, and the table */
+
+#include "VideoStubs.h"
+
+HRESULT APIENTRY
+VideoRetrieveSubObject(D3D10DDI_HDEVICE hDevice, UINT32 SubDeviceID, SIZE_T ParamSize,
+                       void *pParams, SIZE_T OutputParamSize, void *pOutputParamsBuffer)
+{
+   (void)hDevice;
+   if (SubDeviceID != D3D11_1DDI_VIDEO_FUNCTIONS || ParamSize < sizeof(D3D11_1DDI_VIDEO_INPUT) ||
+       !pParams) {
+      DebugPrintf("video: RetrieveSubObject %u (%u bytes) not offered\n", (unsigned)SubDeviceID,
+                  (unsigned)ParamSize);
+      return E_NOTIMPL;
+   }
+   D3D11_1DDI_VIDEO_INPUT *in = (D3D11_1DDI_VIDEO_INPUT *)pParams;
+   VideoFillFuncs(in->p11VideoDeviceFuncs);
+   if (pOutputParamsBuffer && OutputParamSize)
+      memset(pOutputParamsBuffer, 0, OutputParamSize);
+   DebugPrintf("video: the video function table handed over (relocate %d)\n", in->Relocate);
+   return S_OK;
+}
