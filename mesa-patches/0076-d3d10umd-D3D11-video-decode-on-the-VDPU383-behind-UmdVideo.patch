+                                          const D3D10DDI_HSHADERRESOURCEVIEW *) {}
+static VOID APIENTRY NoSetShader(D3D10DDI_HDEVICE, D3D10DDI_HSHADER) {}
+static VOID APIENTRY NoSetSamplers(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HSAMPLER *) {}
+
+static VOID APIENTRY
+NoCreateTessellationShader(D3D10DDI_HDEVICE hDevice, const UINT *, D3D10DDI_HSHADER,
+                           D3D10DDI_HRTSHADER, const D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES *)
+{
+   SetError(hDevice, E_NOTIMPL);
+}
+
+static SIZE_T APIENTRY
+CalcPrivateTessellationShaderSize11(D3D10DDI_HDEVICE, const UINT *,
+                                    const D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES *)
+{
+   return sizeof(Shader);
+}
+
+static VOID APIENTRY
+NoCheckDeferredContextHandleSizes(D3D10DDI_HDEVICE, UINT *pHSizes, D3D11DDI_HANDLESIZE *)
+{
+   *pHSizes = 0;
+}
+
+static SIZE_T APIENTRY NoCalcDeferredContextHandleSize(D3D10DDI_HDEVICE, D3D11DDI_HANDLETYPE, VOID *)
+{
+   return 0;
+}
+
+static SIZE_T APIENTRY
+NoCalcPrivateDeferredContextSize(D3D10DDI_HDEVICE, const D3D11DDIARG_CALCPRIVATEDEFERREDCONTEXTSIZE *)
+{
+   return sizeof(Device);
