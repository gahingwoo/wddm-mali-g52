+/*
+ * Whether this is Chromium's GPU process: msedge.exe, chrome.exe or
+ * msedgewebview2.exe started with --type=gpu-process. Its D3D11 video
+ * decoder takes ANGLE's device and refuses one below feature level 11_0
+ * (media/gpu/windows/d3d11_video_decoder_backend.cc). The browser process,
+ * the renderers and the utility processes have other --type values, or
+ * none, and keep what they had.
+ */
+static bool
+IsChromiumGpuProcess(void)
+{
+   static const char *const names[] = {
+      "msedge.exe", "chrome.exe", "msedgewebview2.exe",
+   };
+   char path[MAX_PATH];
+   DWORD n = GetModuleFileNameA(NULL, path, sizeof path);
+   const char *base = path;
+   const wchar_t *cmd = GetCommandLineW();
+   bool named = false;
+
+   if (n == 0 || n >= sizeof path || !cmd)
+      return false;
+   for (const char *c = path; *c; c++)
+      if (*c == '\\' || *c == '/')
+         base = c + 1;
+   for (unsigned i = 0; i < ARRAYSIZE(names); i++)
+      if (_stricmp(base, names[i]) == 0)
+         named = true;
+   return named && wcsstr(cmd, L"--type=gpu-process") != NULL;
+}
+
+/*
+ * UmdReportFL11 (maliwddm Device Parameters, default 0):
+ *   0  nothing changes anywhere.
+ *   1  Chromium's GPU process gets the D3D11.1 interface (D3D11.cpp) at
+ *      feature level 11_0: shader model 5 shaders are taken (the subset
+ *      FXC emits for OpenGL ES 3.0 code, ShaderParse.c), hull, domain and
+ *      compute shaders and unordered access views fail as the DDI allows.
+ *      ANGLE stays on OpenGL ES 3.0 at 11_0 (renderer11_utils.cpp,
+ *      GetMaximumClientVersion), so it never asks for them.
+ */
+static bool
+EffectiveFl11(unsigned setting)
+{
+   return setting == 1 && IsChromiumGpuProcess();
+}
