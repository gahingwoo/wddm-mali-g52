+/*
+ * Shader model 5's bit-field instructions take the field's width and
+ * offset in their low five bits (D3D11 functional spec, ubfe/ibfe/bfi);
+ * TGSI's (GLSL's) take them as they are.
+ */
+static struct ureg_src
+low5_bits(struct ureg_program *ureg, struct ureg_dst tmp, struct ureg_src src)
+{
+   ureg_AND(ureg, tmp, src, ureg_imm1u(ureg, 31));
+   return ureg_src(tmp);
+}
+
+/* ubfe/ibfe dst, width, offset, value */
+static void
+expand_bfe(struct ureg_program *ureg, struct Shader_xlate *sx,
+           struct Shader_opcode *opcode, bool is_signed)
+{
+   enum dx10_opcode_format f = is_signed ? OF_INT : OF_UINT;
+   struct ureg_dst w = ureg_DECL_temporary(ureg);
+   struct ureg_dst o = ureg_DECL_temporary(ureg);
+   struct ureg_src width = low5_bits(ureg, w, translate_src_operand(sx, &opcode->src[0], OF_UINT));
+   struct ureg_src offset = low5_bits(ureg, o, translate_src_operand(sx, &opcode->src[1], OF_UINT));
+   struct ureg_dst dst = translate_dst_operand(sx, &opcode->dst[0], opcode->saturate);
+   struct ureg_src value = translate_src_operand(sx, &opcode->src[2], f);
+
+   if (is_signed)
+      ureg_IBFE(ureg, dst, value, offset, width);
+   else
+      ureg_UBFE(ureg, dst, value, offset, width);
+   ureg_release_temporary(ureg, w);
+   ureg_release_temporary(ureg, o);
+}
+
+/* bfi dst, width, offset, insert, base */
+static void
+expand_bfi(struct ureg_program *ureg, struct Shader_xlate *sx, struct Shader_opcode *opcode)
+{
+   struct ureg_dst w = ureg_DECL_temporary(ureg);
+   struct ureg_dst o = ureg_DECL_temporary(ureg);
+   struct ureg_src width = low5_bits(ureg, w, translate_src_operand(sx, &opcode->src[0], OF_UINT));
+   struct ureg_src offset = low5_bits(ureg, o, translate_src_operand(sx, &opcode->src[1], OF_UINT));
+   struct ureg_dst dst = translate_dst_operand(sx, &opcode->dst[0], opcode->saturate);
+
+   ureg_BFI(ureg, dst, translate_src_operand(sx, &opcode->src[3], OF_UINT),
+            translate_src_operand(sx, &opcode->src[2], OF_UINT), offset, width);
+   ureg_release_temporary(ureg, w);
+   ureg_release_temporary(ureg, o);
+}
+
+/*
+ * firstbit_hi / firstbit_shi: the first set (for shi: differing from the
+ * sign) bit counted from the most significant end, ~0 when there is none.
+ * TGSI's UMSB and IMSB count from the least significant end, also ~0 when
+ * there is none: 31 - n, which for 0 <= n <= 31 is n ^ 31.
+ */
+static void
+expand_firstbit_hi(struct ureg_program *ureg, struct Shader_xlate *sx,
+                   struct Shader_opcode *opcode, bool is_signed)
+{
+   struct ureg_dst n = ureg_DECL_temporary(ureg);
+   struct ureg_dst none = ureg_DECL_temporary(ureg);
+   struct ureg_dst flip = ureg_DECL_temporary(ureg);
+   struct ureg_dst dst;
+
+   if (is_signed)
+      ureg_IMSB(ureg, n, translate_src_operand(sx, &opcode->src[0], OF_INT));
+   else
+      ureg_UMSB(ureg, n, translate_src_operand(sx, &opcode->src[0], OF_UINT));
+   ureg_USEQ(ureg, none, ureg_src(n), ureg_imm1u(ureg, 0xffffffff));
+   ureg_XOR(ureg, flip, ureg_src(n), ureg_imm1u(ureg, 31));
+   dst = translate_dst_operand(sx, &opcode->dst[0], opcode->saturate);
+   ureg_UCMP(ureg, dst, ureg_src(none), ureg_src(n), ureg_src(flip));
+   ureg_release_temporary(ureg, n);
+   ureg_release_temporary(ureg, none);
+   ureg_release_temporary(ureg, flip);
+}
