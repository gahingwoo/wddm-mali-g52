diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index f717d5c..36ef023 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -386,6 +386,17 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
     * other process keeps NO_REDIRECTION, whose present paths are the ones
     * the desktop has been tested with. The file C:\mali\redirect allows it
     * for every process, C:\mali\noredirect refuses it for every process.
+    *
+    * Which processes get it by default is the KMD's to say (UmdRedirect,
+    * Adapter::redirect). At WDDM 2.0 the browsers' default froze the
+    * session on the TaishanPi 3M (2026-11-25, maliwddm 10.24.57.813): an
+    * allocation was opened, 14 ms later the screen was made invisible and
+    * never visible again, and every GUI thread of every process, Edge's
+    * exiting threads included, then waited for a win32k lock. The KMD had
+    * no work outstanding, so no timeout detection could fire
+    * (docs/EDGE-PRESENT.md, "The WDDM 2.0 session hang"). maliwddm answers
+    * 2 (the browsers) at WDDM 1.3 and 1 (none) at 2.x; a KMD that predates
+    * the field answers 0, which keeps the browsers' default.
     */
    if (GetFileAttributesA("C:\\mali\\noredirect") != INVALID_FILE_ATTRIBUTES) {
       DebugPrintf("CreateDevice: done, DXGI_STATUS_NO_REDIRECTION (C:\\mali\\noredirect)\n");
@@ -395,10 +406,19 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
       DebugPrintf("CreateDevice: done, S_OK (redirection allowed, C:\\mali\\redirect)\n");
       return S_OK;
    }
-   if (IsRedirectProcess()) {
-      DebugPrintf("CreateDevice: done, S_OK (redirection allowed: a browser)\n");
+   if (pAdapter->redirect == 3) {
+      DebugPrintf("CreateDevice: done, S_OK (redirection allowed: UmdRedirect 3)\n");
       return S_OK;
    }
+   if (IsRedirectProcess()) {
+      if (pAdapter->redirect != 1) {
+         DebugPrintf("CreateDevice: done, S_OK (redirection allowed: a browser, UmdRedirect %u)\n",
+                     pAdapter->redirect);
+         return S_OK;
+      }
+      DebugPrintf("CreateDevice: done, DXGI_STATUS_NO_REDIRECTION (a browser, but UmdRedirect 1)\n");
+      return DXGI_STATUS_NO_REDIRECTION;
+   }
    DebugPrintf("CreateDevice: done, DXGI_STATUS_NO_REDIRECTION\n");
    return DXGI_STATUS_NO_REDIRECTION;
 }
