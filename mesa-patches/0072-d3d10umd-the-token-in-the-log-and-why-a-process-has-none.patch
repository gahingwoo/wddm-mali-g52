+/*
+ * The token this process runs with, for the first line of its log. A
+ * sandboxed process (Edge's GPU process: a restricted token at low
+ * integrity) writes the log only where the directory's ACL grants one of
+ * its restricted SIDs and its label lets a low process write; without
+ * that it has no log, and says so only through OutputDebugString.
+ */
+#pragma comment(lib, "advapi32.lib")
+
+static void
+DebugTokenDescription(char *out, size_t size)
+{
+   HANDLE token;
+   DWORD len, rid = 0, app_container = 0;
+   BOOL restricted;
+   union {
+      TOKEN_MANDATORY_LABEL label;
+      char bytes[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_MANDATORY_LABEL)];
+   } il;
+
+   if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+      snprintf(out, size, "token not readable (%lu)", (unsigned long)GetLastError());
+      return;
+   }
+   if (GetTokenInformation(token, TokenIntegrityLevel, &il, sizeof il, &len)) {
+      PSID sid = il.label.Label.Sid;
+      rid = *GetSidSubAuthority(sid, *GetSidSubAuthorityCount(sid) - 1);
+   }
+   if (!GetTokenInformation(token, TokenIsAppContainer, &app_container,
+                            sizeof app_container, &len))
+      app_container = 0;
+   restricted = IsTokenRestricted(token);
+   CloseHandle(token);
+   snprintf(out, size, "integrity 0x%lx%s, app container %lu, restricted %d",
+            (unsigned long)rid,
+            rid < SECURITY_MANDATORY_MEDIUM_RID ? " (low)" : "",
+            (unsigned long)app_container, restricted ? 1 : 0);
+}
