+/*
+ * Whether this process gets the multisample answers (Device.cpp,
+ * CheckFormatSupport). With them on in every process, dwm.exe's render
+ * thread failed at start (0x8898008d, TaishanPi 3M, 2026-11-21) and the
+ * logon screen never came. Only ANGLE needs them, so by default they are
+ * for the browsers and d3dprobe alone: UmdMsaa 1 and 4 apply to these,
+ * 2 and 5 to every process.
+ */
+static bool
+IsMsaaProcess(void)
+{
+   static const char *const names[] = {
+      "msedge.exe", "chrome.exe", "msedgewebview2.exe", "d3dprobe.exe",
+   };
+   char path[MAX_PATH];
+   DWORD n = GetModuleFileNameA(NULL, path, sizeof path);
+   const char *base = path;
+
+   if (n == 0 || n >= sizeof path)
+      return false;
+   for (const char *c = path; *c; c++)
+      if (*c == '\\' || *c == '/')
+         base = c + 1;
+   for (unsigned i = 0; i < ARRAYSIZE(names); i++)
+      if (_stricmp(base, names[i]) == 0)
+         return true;
+   return false;
+}
+
+static unsigned
+EffectiveMsaa(unsigned setting)
+{
+   bool all = setting == 2 || setting == 5;
+   unsigned samples = setting >= 4 ? 4 : (setting ? 1 : 0);
+
+   if (!samples || !(all || IsMsaaProcess()))
+      return 0;
+   return samples;
+}
