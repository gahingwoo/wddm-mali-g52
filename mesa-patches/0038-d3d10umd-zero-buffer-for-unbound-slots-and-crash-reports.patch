index 5b5dc5d..e9e2ee5 100644
--- a/src/gallium/frontends/d3d10umd/Debug.cpp
+++ b/src/gallium/frontends/d3d10umd/Debug.cpp
@@ -2,6 +2,7 @@
 
 #include <stdarg.h>
 #include <stdio.h>
+#include <stdint.h>
 
 
 #if MESA_DEBUG
@@ -29,10 +30,87 @@ st_debug_parse(void)
  * writes one file per process, <exe>-<pid>.txt. Each line is appended with
  * a single WriteFile so threads do not interleave inside a line.
  */
+/*
+ * A crash inside this DLL, to the file log: the event log gives one offset
+ * and no caller. First-chance, and only for faults whose address is in this
+ * module; the exception then goes on to whoever handles it. The offsets are
+ * relative to the module base, as llvm-symbolizer --relative-address takes
+ * them with the build's .pdb.
+ */
+static LONG CALLBACK
+DebugCrashHandler(EXCEPTION_POINTERS *info)
+{
+   static volatile LONG reports = 0;
+   const EXCEPTION_RECORD *rec = info->ExceptionRecord;
+   DWORD code = rec->ExceptionCode;
+   HMODULE self = NULL;
+
+   if (code != EXCEPTION_ACCESS_VIOLATION && code != EXCEPTION_ILLEGAL_INSTRUCTION &&
+       code != EXCEPTION_INT_DIVIDE_BY_ZERO && code != EXCEPTION_PRIV_INSTRUCTION &&
+       code != EXCEPTION_IN_PAGE_ERROR)
+      return EXCEPTION_CONTINUE_SEARCH;
+   if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                           GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)(void *)&DebugCrashHandler, &self) || !self)
+      return EXCEPTION_CONTINUE_SEARCH;
+
+   uintptr_t base = (uintptr_t)self;
+   const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)base;
+   const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)(base + dos->e_lfanew);
+   uintptr_t size = nt->OptionalHeader.SizeOfImage;
+   uintptr_t pc = (uintptr_t)rec->ExceptionAddress;
+
+   if (pc - base >= size)
+      return EXCEPTION_CONTINUE_SEARCH;
+   if (InterlockedIncrement(&reports) > 4)
+      return EXCEPTION_CONTINUE_SEARCH;
+
+   DebugPrintf("CRASH code 0x%08lx at maliumd+0x%llx, %s address 0x%llx\n",
+               (unsigned long)code, (unsigned long long)(pc - base),
+               rec->NumberParameters >= 2 ? (rec->ExceptionInformation[0] == 1 ? "writing" :
+                                             rec->ExceptionInformation[0] == 8 ? "executing" :
+                                             "reading") : "no",
+               rec->NumberParameters >= 2 ? (unsigned long long)rec->ExceptionInformation[1] : 0ull);
+#if defined(_M_ARM64)
+   {
+      const CONTEXT *c = info->ContextRecord;
+      uintptr_t lr = (uintptr_t)c->Lr;
+      char line[1024];
+      int n = 0;
+
+      if (lr - base < size)
+         DebugPrintf("CRASH lr maliumd+0x%llx\n", (unsigned long long)(lr - base));
+      else
+         DebugPrintf("CRASH lr 0x%llx (not in this module)\n", (unsigned long long)lr);
+      DebugPrintf("CRASH x0 0x%llx x1 0x%llx x2 0x%llx x8 0x%llx x9 0x%llx x19 0x%llx x20 0x%llx\n",
+                  (unsigned long long)c->X[0], (unsigned long long)c->X[1],
+                  (unsigned long long)c->X[2], (unsigned long long)c->X[8],
+                  (unsigned long long)c->X[9], (unsigned long long)c->X[19],
+                  (unsigned long long)c->X[20]);
+
+      /* Return addresses, or what looks like them: every word of the stack
+       * above sp that points into this module. */
+      const uintptr_t *sp = (const uintptr_t *)c->Sp;
+      NT_TIB *tib = (NT_TIB *)NtCurrentTeb();
+      const uintptr_t *top = (const uintptr_t *)tib->StackBase;
+      for (unsigned i = 0; i < 2048 && sp + i < top && n < (int)sizeof line - 24; i++) {
+         uintptr_t v = sp[i];
+         if (v - base < size && (v & 3) == 0)
+            n += snprintf(line + n, sizeof line - n, " +0x%llx", (unsigned long long)(v - base));
+      }
+      line[n] = 0;
+      DebugPrintf("CRASH stack words in this module:%s\n", line);
+   }
+#endif
+   return EXCEPTION_CONTINUE_SEARCH;
+}
+
+
 static HANDLE
 DebugLogFile(void)
 {
    static volatile LONG state = 0;       /* 0 untried, 1 opening, 2 done */
+   static volatile LONG tries = 0;
    static HANDLE file = INVALID_HANDLE_VALUE;
 
    if (state == 2)
@@ -54,6 +132,15 @@ DebugLogFile(void)
                          FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                          NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    }
+   if (InterlockedIncrement(&tries) == 1)
+      AddVectoredExceptionHandler(1, DebugCrashHandler);
+   /* explorer.exe had this DLL loaded and no log: the first call there may
+    * come on a thread that cannot create the file. Try again on later calls
+    * instead of giving up for the life of the process. */
+   if (file == INVALID_HANDLE_VALUE && tries < 200) {
+      InterlockedExchange(&state, 0);
+      return file;
+   }
    InterlockedExchange(&state, 2);
    return file;
 }
