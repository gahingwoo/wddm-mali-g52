@@ -155,6 +174,14 @@ IaSetVertexBuffers(D3D10DDI_HDEVICE hDevice,
       else {
          pDevice->vertex_strides[StartBuffer + i] = 0;
          vb->buffer_offset = 0;
+         if (!user_buffers) {
+            if (vb->is_user_buffer) {
+               vb->buffer.resource = NULL;
+               vb->is_user_buffer = false;
+            }
+            pipe_resource_reference(&vb->buffer.resource, pDevice->null_vertex_buffer);
+            continue;
+         }
          if (!vb->is_user_buffer) {
             pipe_resource_reference(&vb->buffer.resource, NULL);
             vb->is_user_buffer = true;
@@ -170,6 +197,10 @@ IaSetVertexBuffers(D3D10DDI_HDEVICE hDevice,
       if (!vb->is_user_buffer && !vb->buffer.resource) {
          pDevice->vertex_strides[i] = 0;
          vb->buffer_offset = 0;
+         if (!user_buffers) {
+            pipe_resource_reference(&vb->buffer.resource, pDevice->null_vertex_buffer);
+            continue;
+         }
          vb->is_user_buffer = true;
          vb->buffer.user = dummy;
