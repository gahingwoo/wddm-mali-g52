+static void __cdecl
+mali_wassert_impl(const wchar_t *message, const wchar_t *file, unsigned line)
+{
+   static volatile LONG count = 0;
+   char buf[1024];
+   int len;
+
+   if (InterlockedIncrement(&count) > 2000)
+      return;
+   len = snprintf(buf, sizeof buf, "%10lu %5lu ASSERT %ls:%u: %ls\n",
+                  (unsigned long)GetTickCount(), (unsigned long)GetCurrentThreadId(),
+                  file, line, message);
+   if (len <= 0)
+      return;
+   if (len >= (int)sizeof buf)
+      len = (int)sizeof buf - 1;
+   OutputDebugStringA(buf);
+   fputs(buf, stderr);
+   mali_log_append(buf, len);
+}
+
+/* Mesa's own messages (mesa_loge and friends) go to stderr and the debugger,
+ * which nobody reads inside a shell process. Called from util/log.c. */
+void
+mali_log_line(const char *msg)
+{
+   static volatile LONG count = 0;
+   char buf[1024];
+   int len;
+
+   if (InterlockedIncrement(&count) > 2000)
+      return;
+   len = snprintf(buf, sizeof buf, "%10lu %5lu MESA %s%s",
+                  (unsigned long)GetTickCount(), (unsigned long)GetCurrentThreadId(), msg,
+                  (msg[0] && msg[strlen(msg) - 1] == '\n') ? "" : "\n");
+   if (len <= 0)
+      return;
+   if (len >= (int)sizeof buf)
+      len = (int)sizeof buf - 1;
+   mali_log_append(buf, len);
+}
+
 /* What "__declspec(dllimport) mali_wassert" resolves to. */
 void (__cdecl *__imp_mali_wassert)(const wchar_t *, const wchar_t *, unsigned) = mali_wassert_impl;
 
