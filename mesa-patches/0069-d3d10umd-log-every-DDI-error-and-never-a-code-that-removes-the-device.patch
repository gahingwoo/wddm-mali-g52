+/*
+ * The only codes pfnSetErrorCb takes as an error of the call. For any other
+ * the runtime decides a critical error occurred and removes the device: the
+ * application then sees DXGI_ERROR_DEVICE_REMOVED on its next Present and
+ * GetDeviceRemovedReason says DXGI_ERROR_DRIVER_INTERNAL_ERROR (0x887A0020),
+ * which is what Edge's GPU process got on the TaishanPi 3M (2026-11-22), with
+ * no TDR and nothing from the KMD.
+ */
+#ifndef D3DDDIERR_DEVICEREMOVED
+#define D3DDDIERR_DEVICEREMOVED ((HRESULT)0x88760870L)
+#endif
+#ifndef DXGI_DDI_ERR_NONEXCLUSIVEMODE
+#define DXGI_DDI_ERR_NONEXCLUSIVEMODE ((HRESULT)0x887B0003L)
+#endif
+
+static inline bool
+ErrorTheRuntimeTakes(HRESULT hr)
+{
+   return hr == E_OUTOFMEMORY || hr == DXGI_DDI_ERR_WASSTILLDRAWING ||
+          hr == DXGI_DDI_ERR_UNSUPPORTED || hr == DXGI_DDI_ERR_NONEXCLUSIVEMODE ||
+          hr == D3DDDIERR_DEVICEREMOVED;
+}
+
+/*
+ * Every error a DDI reports, with the DDI's name, goes into the UMD log
+ * (C:\mali\log), the first of each device marked, so that a device the
+ * runtime removed shows the call that did it. A code the runtime would
+ * remove the device for is logged as such and reported as E_OUTOFMEMORY:
+ * the call fails, the device lives (E_FAIL from a map that returned no
+ * pointer, E_INVALIDARG from OpenResource of a surface this driver did not
+ * make, E_NOTIMPL from a render target view of a buffer).
+ */
+#define SetError(hDevice, hr) SetErrorAt((hDevice), (hr), __func__)
+
 static inline void
-SetError(D3D10DDI_HDEVICE hDevice, HRESULT hr)
+SetErrorAt(D3D10DDI_HDEVICE hDevice, HRESULT hr, const char *ddi)
 {
    if (FAILED(hr)) {
       Device *pDevice = CastDevice(hDevice);
-      DebugPrintf("SetError 0x%08lx\n", (unsigned long)hr);
-      pDevice->UMCallbacks.pfnSetErrorCb(pDevice->hRTCoreLayer, hr);
+      HRESULT reported = ErrorTheRuntimeTakes(hr) ? hr : E_OUTOFMEMORY;
+      /* WASSTILLDRAWING is an answer, not a failure: the first few only,
+       * and on a count of their own. */
+      bool still = hr == DXGI_DDI_ERR_WASSTILLDRAWING;
+      unsigned n = still ? ++pDevice->stilldrawing_logged : ++pDevice->errors_logged;
+      if (n <= (still ? 4u : 256u)) {
+         if (reported != hr)
+            DebugPrintf("ddi-error%s: %s 0x%08lx, a code the runtime removes the device for;"
+                        " reported as E_OUTOFMEMORY\n", n == 1 && !still ? " (first)" : "", ddi,
+                        (unsigned long)hr);
+         else
+            DebugPrintf("ddi-error%s: %s 0x%08lx\n", n == 1 && !still ? " (first)" : "", ddi,
+                        (unsigned long)hr);
+      }
+      pDevice->UMCallbacks.pfnSetErrorCb(pDevice->hRTCoreLayer, reported);
    }
 }
 
