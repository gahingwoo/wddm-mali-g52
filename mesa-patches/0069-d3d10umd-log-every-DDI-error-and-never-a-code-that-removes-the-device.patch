 }
+
+
+/*
+ * What the DXGI DDI functions return, in the UMD log when it is not S_OK:
+ * a failure here is passed to the application (Present1), and one the
+ * runtime does not expect from the driver removes the device. Edge's GPU
+ * process on the TaishanPi 3M (2026-11-22) saw Present1 fail with
+ * DXGI_ERROR_DEVICE_REMOVED, reason 0x887A0020, and left no record of the
+ * call that started it; with this and SetError (State.h) it does.
+ */
+static HRESULT
+DxgiResult(const char *ddi, HRESULT hr)
+{
+   static volatile LONG said = 0;
+
+   if (hr != S_OK && InterlockedIncrement(&said) <= 256)
+      DebugPrintf("dxgi-result: %s 0x%08lx%s\n", ddi, (unsigned long)hr,
+                  FAILED(hr) ? " (failed)" : "");
+   return hr;
+}
+
+HRESULT APIENTRY
+_Present(DXGI_DDI_ARG_PRESENT *pPresentData)
+{
+   return DxgiResult("Present", PresentImpl(pPresentData));
+}
+
+HRESULT APIENTRY
+_SetDisplayMode(DXGI_DDI_ARG_SETDISPLAYMODE *SetDisplayMode)
+{
+   return DxgiResult("SetDisplayMode", SetDisplayModeImpl(SetDisplayMode));
+}
+
+HRESULT APIENTRY
+_RotateResourceIdentities(DXGI_DDI_ARG_ROTATE_RESOURCE_IDENTITIES *RotateResourceIdentities)
+{
+   return DxgiResult("RotateResourceIdentities",
+                     RotateResourceIdentitiesImpl(RotateResourceIdentities));
+}
