+/* pipe_screen::resource_alias: the same memory, another format and size. */
+static struct pipe_resource *
+softpipe_resource_alias(struct pipe_screen *screen, struct pipe_resource *parent,
+                        const struct pipe_resource *templat, unsigned y_rows)
+{
+   struct softpipe_resource *p = softpipe_resource(parent);
+   struct softpipe_resource *spr;
+   const unsigned row = util_format_get_stride(templat->format, templat->width0);
+
+   if (p->dt || !p->data || parent->target == PIPE_BUFFER || parent->last_level ||
+       templat->last_level || templat->array_size != parent->array_size ||
+       util_format_is_compressed(templat->format) || row > p->stride[0] ||
+       y_rows + templat->height0 > parent->height0)
+      return NULL;
+   spr = CALLOC_STRUCT(softpipe_resource);
+   if (!spr)
+      return NULL;
+   spr->base = *templat;
+   pipe_reference_init(&spr->base.reference, 1);
+   spr->base.screen = screen;
+   spr->stride[0] = p->stride[0];
+   spr->img_stride[0] = p->img_stride[0];
+   spr->level_offset[0] = p->level_offset[0] + (unsigned long)y_rows * p->stride[0];
+   spr->data = p->data;
+   spr->userBuffer = true;
+   pipe_resource_reference(&spr->alias_of, parent);
+   return &spr->base;
+}
