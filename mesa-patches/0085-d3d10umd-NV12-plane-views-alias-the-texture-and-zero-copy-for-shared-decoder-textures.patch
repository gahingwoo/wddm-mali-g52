+/*
+ * pipe_screen::resource_alias (d3d10umd's NV12 plane views): a linear
+ * texture on the parent's BO, starting at row y_rows of each of the
+ * parent's layers, with the parent's row pitch and layer stride. The
+ * parent's BO is marked shared and its modifier fixed, so neither resource
+ * ever swaps the BO for another or converts it while the other still
+ * points at it.
+ */
+static struct pipe_resource *
+panfrost_resource_alias(struct pipe_screen *pscreen, struct pipe_resource *parent,
+                        const struct pipe_resource *templat, unsigned y_rows)
+{
+   struct panfrost_resource *p = pan_resource(parent);
+   const struct pan_image_layout *pl = &p->plane.layout;
+   struct panfrost_resource *rsc;
+   struct pipe_resource *prsc;
+
+   if (!p->bo || parent->target == PIPE_BUFFER || parent->last_level || templat->last_level ||
+       p->modifier != DRM_FORMAT_MOD_LINEAR || p->image.props.modifier != DRM_FORMAT_MOD_LINEAR ||
+       p->shadow_image || p->separate_stencil || parent->nr_samples > 1 ||
+       templat->nr_samples > 1 || util_format_get_num_planes(parent->format) != 1 ||
+       util_format_get_num_planes(templat->format) != 1 ||
+       templat->array_size != parent->array_size || y_rows + templat->height0 > parent->height0 ||
+       (templat->target != PIPE_TEXTURE_2D && templat->target != PIPE_TEXTURE_2D_ARRAY))
+      return NULL;
+
+   rsc = CALLOC_STRUCT(panfrost_resource);
+   if (!rsc)
+      return NULL;
+   prsc = &rsc->base;
+   *prsc = *templat;
+   pipe_reference_init(&prsc->reference, 1);
+   util_range_init(&rsc->valid_buffer_range);
+   prsc->screen = pscreen;
+
+   const uint32_t pitch = pl->slices[0].tiled_or_linear.row_stride_B;
+   struct pan_image_layout_constraints explicit_layout = {
+      .offset_B = pl->slices[0].offset_B + (uint64_t)y_rows * pitch,
+      .wsi_row_pitch_B = pitch,
+      .strict = true,
+   };
+   /* One layer with the explicit layout, then the parent's layers. */
+   struct pan_image_props iprops = {
+      .modifier = DRM_FORMAT_MOD_LINEAR,
+      .format = templat->format,
+      .dim = MALI_TEXTURE_DIMENSION_2D,
+      .extent_px = {
+         .width = templat->width0,
+         .height = templat->height0,
+         .depth = 1,
+      },
+      .array_size = 1,
+      .nr_samples = 1,
+      .nr_slices = 1,
+   };
+
+   rsc->modifier = DRM_FORMAT_MOD_LINEAR;
+   if (!panfrost_resource_init_image(pscreen, rsc, &iprops, 0, &explicit_layout)) {
+      panfrost_resource_destroy(pscreen, prsc);
+      return NULL;
+   }
+   rsc->image.props.array_size = templat->array_size;
+   rsc->plane.layout.array_stride_B = pl->array_stride_B;
+   rsc->plane.layout.data_size_B =
+      pl->array_stride_B * (templat->array_size - 1) + rsc->plane.layout.slices[0].size_B;
+
+   p->bo->flags |= PAN_BO_SHARED;
+   p->modifier_constant = true;
+   panfrost_bo_reference(p->bo);
+   rsc->bo = p->bo;
+   rsc->owns_label = false;
+   pan_crc_state_set_ptr(&rsc->crc_state, &rsc->bo->ptr);
+   rsc->plane.base = rsc->bo->ptr.gpu;
+   rsc->modifier_constant = true;
+   BITSET_SET(rsc->valid.data, 0);
+   panfrost_resource_set_damage_region(pscreen, prsc, 0, NULL);
+   return prsc;
+}
