                               void *dxgi_context);
+/* The time a present spends in each stage, summed by the shim and written
+ * to the file log every few seconds. The numbers are the shim's. */
+enum {
+   D3D10_PERF_FLUSH = 0,          /* pipe->flush in Present */
+   D3D10_PERF_READBACK_MAP = 1,   /* mapping the frame: waits for the GPU */
+   D3D10_PERF_READBACK_COPY = 2,  /* the frame out of the driver's buffer */
+   D3D10_PERF_PRIMARY_COPY = 3,   /* the frame into the primary */
+   D3D10_PERF_PRESENT_CB = 4,     /* the runtime's present callback */
+   D3D10_PERF_ROTATE = 5,         /* RotateResourceIdentities */
+   D3D10_PERF_SUBMIT = 6,         /* each job submission */
+   D3D10_PERF_GPU_WAIT = 7,       /* each wait for the GPU, wherever */
+   D3D10_PERF_IDLE_IN_PRESENT = 8,/* the wait before presenting a primary */
+   D3D10_PERF_BO_CREATE = 9,      /* each buffer allocation */
+};
+unsigned long long d3d10_perf_now(void);
+void d3d10_perf_add(unsigned stage, unsigned long long since);
+void d3d10_perf_frame(void);
 }
 
