+/*
+ * The processes that get DXGI redirection without C:\mali\redirect: the
+ * browsers, which present through DirectComposition, and d3dprobe (its
+ * "edge path" and "sandbox" steps), run under any of these names.
+ */
+static bool
+IsRedirectProcess(void)
+{
+   static const char *const names[] = {
+      "msedge.exe", "chrome.exe", "msedgewebview2.exe", "d3dprobe.exe",
+   };
+   char path[MAX_PATH];
+   DWORD n = GetModuleFileNameA(NULL, path, sizeof path);
+   const char *base = path;
+
+   if (n == 0 || n >= sizeof path)
+      return false;
+   for (const char *c = path; *c; c++)
+      if (*c == '\\' || *c == '/')
+         base = c + 1;
+   for (unsigned i = 0; i < ARRAYSIZE(names); i++)
+      if (_stricmp(base, names[i]) == 0)
+         return true;
+   return false;
+}
+
 HRESULT APIENTRY
 CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
              __in D3D10DDIARG_CREATEDEVICE *pCreateData) // IN
@@ -347,13 +373,30 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
