diff --git a/src/gallium/frontends/d3d10umd/VideoProcessor.cpp b/src/gallium/frontends/d3d10umd/VideoProcessor.cpp
new file mode 100644
index 0000000..8499e19
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/VideoProcessor.cpp
@@ -0,0 +1,979 @@
+/*
+ * VideoProcessor.cpp --
+ *    The D3D11 video processor (ID3D11VideoProcessor, VideoProcessorBlt)
+ *    and NV12 as two shader resource views: what a player that does not
+ *    convert NV12 itself needs to show a decoded picture (Media
+ *    Foundation's Media Engine, Edge's copy path).
+ *
+ * One input stream, progressive (an interlaced stream is shown as its
+ * frame), no filters, no rotation. Input NV12 (Resource.cpp's layout),
+ * B8G8R8A8, B8G8R8X8, R8G8B8A8; output the three RGB formats. Source
+ * rectangle, destination rectangle, target rectangle, background colour
+ * (RGB or YCbCr), BT.601 or BT.709, studio or full range in and out,
+ * alpha fill. Scaling is bilinear (chroma too).
+ *
+ * The blit is drawn in a pipe context of its own, created at the first
+ * blit: the device's context keeps exactly the state the application set
+ * (this frontend sets most of it straight on the pipe and could not put
+ * it back). The device's context is flushed and waited for first, so the
+ * blit reads what was decoded or drawn before it, and the blit is waited
+ * for before it returns, so whatever the device does next sees its
+ * output. Two waits per blit: simple and correct, not fast.
+ *
+ * Copyright (c) 2026 Ga Hing Woo <gahing@gahingwoo.com>
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "DriverIncludes.h"
+#include "Video.h"
+#include "VideoProcessor.h"
+#include "VideoShaders.h"
+#include "State.h"
+#include "Debug.h"
+
+#include "cso_cache/cso_context.h"
+#include "util/box.h"
+#include "util/os_time.h"
+#include "util/u_draw_quad.h"
+#include "util/u_inlines.h"
+#include "util/u_sampler.h"
+#include "util/u_simple_shaders.h"
+#include "util/u_surface.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+/* ------------------------------------------------------------ objects */
+
+struct VideoProcessorEnum {
+   D3D11_1DDI_VIDEO_PROCESSOR_CONTENT_DESC desc;
+};
+
+struct VideoProcessorStream {
+   D3D11_1DDI_VIDEO_FRAME_FORMAT frame_format;
+   D3D11_1DDI_VIDEO_PROCESSOR_COLOR_SPACE cs;
+   BOOL src_enabled, dst_enabled, alpha_enabled;
+   RECT src, dst;
+   float alpha;
+};
+
+struct VideoProcessor {
+   D3D11_1DDI_VIDEO_PROCESSOR_CONTENT_DESC desc;
+   BOOL target_enabled;
+   RECT target;
+   BOOL bg_ycbcr;
+   D3D11_1DDI_VIDEO_COLOR bg;
+   D3D11_1DDI_VIDEO_PROCESSOR_COLOR_SPACE out_cs;
+   D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE alpha_mode;
+   VideoProcessorStream stream;
+   unsigned blts, logged;
+};
+
+struct VideoProcessorInputView {
+   Resource *resource;
+   UINT slice;
+};
+
+struct VideoProcessorOutputView {
+   Resource *resource;
+   UINT level, slice;
+};
+
+/* The device's video processor context (Device::vp). */
+struct VideoProcessorContext {
+   struct pipe_context *pipe;
+   struct cso_context *cso;
+   void *vs;
+   void *fs[4];                 /* [nv12 * 2 + array] */
+   struct pipe_resource *vbuf;  /* 4 vertices: position, source texel */
+   struct pipe_resource *cbuf;  /* CONST[0..5], VideoShaders.c */
+};
+
+static inline VideoProcessorEnum *
+CastEnum(D3D11_1DDI_HVIDEOPROCESSORENUM h)
+{
+   return (VideoProcessorEnum *)h.pDrvPrivate;
+}
+
+static inline VideoProcessor *
+CastVp(D3D11_1DDI_HVIDEOPROCESSOR h)
+{
+   return (VideoProcessor *)h.pDrvPrivate;
+}
+
+static inline VideoProcessorInputView *
+CastInputView(D3D11_1DDI_HVIDEOPROCESSORINPUTVIEW h)
+{
+   return (VideoProcessorInputView *)h.pDrvPrivate;
+}
+
+static inline VideoProcessorOutputView *
+CastVpOutputView(D3D11_1DDI_HVIDEOPROCESSOROUTPUTVIEW h)
+{
+   return (VideoProcessorOutputView *)h.pDrvPrivate;
+}
+
+/* ------------------------------------------------------------ formats */
+
+#define VP_MAX_SIZE 8192
+
+UINT
+VideoProcessorFormat(DXGI_FORMAT format)
+{
+   switch (format) {
+   case DXGI_FORMAT_NV12:
+      return D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT;
+   case DXGI_FORMAT_B8G8R8A8_UNORM:
+   case DXGI_FORMAT_B8G8R8X8_UNORM:
+   case DXGI_FORMAT_R8G8B8A8_UNORM:
+      return D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT |
+             D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT;
+   default:
+      return 0;
+   }
+}
+
+UINT
+VideoFormatSupport(Device *pDevice, DXGI_FORMAT format)
+{
+   UINT vp, caps = 0;
+
+   if (!pDevice->ddi11_1 || !pDevice->video)
+      return 0;
+   vp = VideoProcessorFormat(format);
+   if (vp & D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT)
+      caps |= D3D11_1DDI_FORMAT_SUPPORT_VIDEO_PROCESSOR_INPUT;
+   if (vp & D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT)
+      caps |= D3D11_1DDI_FORMAT_SUPPORT_VIDEO_PROCESSOR_OUTPUT;
+   return caps;
+}
+
+/* --------------------------------------------------------------- enum */
+
+SIZE_T APIENTRY
+VideoCalcPrivateVideoProcessorEnumSize(D3D10DDI_HDEVICE, const D3D11_1DDIARG_CREATEVIDEOPROCESSORENUM *)
+{
+   return sizeof(VideoProcessorEnum);
+}
+
+HRESULT APIENTRY
+VideoCreateVideoProcessorEnum(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEOPROCESSORENUM *p,
+                              D3D11_1DDI_HVIDEOPROCESSORENUM hEnum, D3D11_1DDI_HRTVIDEOPROCESSORENUM)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoProcessorEnum *e = CastEnum(hEnum);
+   const D3D11_1DDI_VIDEO_PROCESSOR_CONTENT_DESC *d = &p->Desc;
+
+   memset(e, 0, sizeof *e);
+   if (!pDevice->video || d->InputWidth == 0 || d->InputHeight == 0 || d->OutputWidth == 0 ||
+       d->OutputHeight == 0 || d->InputWidth > VP_MAX_SIZE || d->InputHeight > VP_MAX_SIZE ||
+       d->OutputWidth > VP_MAX_SIZE || d->OutputHeight > VP_MAX_SIZE) {
+      DebugPrintf("video: CreateVideoProcessorEnum %ux%u -> %ux%u refused\n", d->InputWidth,
+                  d->InputHeight, d->OutputWidth, d->OutputHeight);
+      return E_INVALIDARG;
+   }
+   e->desc = *d;
+   DebugPrintf("video: video processor enum %ux%u -> %ux%u, frame format %u, usage %u\n",
+               d->InputWidth, d->InputHeight, d->OutputWidth, d->OutputHeight,
+               (unsigned)d->InputFrameFormat, (unsigned)d->Usage);
+   return S_OK;
+}
+
+VOID APIENTRY
+VideoDestroyVideoProcessorEnum(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum)
+{
+   memset(CastEnum(hEnum), 0, sizeof(VideoProcessorEnum));
+}
+
+VOID APIENTRY
+VideoCheckVideoProcessorFormat(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORENUM, DXGI_FORMAT Format,
+                               UINT *pSupport)
+{
+   *pSupport = VideoProcessorFormat(Format);
+}
+
+VOID APIENTRY
+VideoGetVideoProcessorCaps(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORENUM,
+                           D3D11_1DDI_VIDEO_PROCESSOR_CAPS *pCaps)
+{
+   memset(pCaps, 0, sizeof *pCaps);
+   pCaps->DeviceCaps = D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_RGB_RANGE_CONVERSION |
+                       D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_YCbCr_MATRIX_CONVERSION |
+                       D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_NOMINAL_RANGE;
+   pCaps->FeatureCaps = D3D11_1DDI_VIDEO_PROCESSOR_FEATURE_CAPS_ALPHA_FILL |
+                        D3D11_1DDI_VIDEO_PROCESSOR_FEATURE_CAPS_ALPHA_STREAM;
+   pCaps->RateConversionCapsCount = 1;
+   pCaps->MaxInputStreams = 1;
+   pCaps->MaxStreamStates = 1;
+}
+
+VOID APIENTRY
+VideoGetVideoProcessorRateConversionCaps(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORENUM, UINT,
+                                         D3D11_1DDI_VIDEO_PROCESSOR_RATE_CONVERSION_CAPS *pCaps)
+{
+   memset(pCaps, 0, sizeof *pCaps);
+   /* Bob is what an interlaced stream needs at the least; the blit shows
+    * the frame as it is (see the top of the file). */
+   pCaps->ConversionCaps = D3D11_1DDI_VIDEO_PROCESSOR_CONVERSION_CAPS_DEINTERLACE_BOB;
+}
+
+VOID APIENTRY
+VideoGetVideoProcessorCustomRate(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORENUM, UINT, UINT,
+                                 D3D11_1DDI_VIDEO_PROCESSOR_CUSTOM_RATE *pRate)
+{
+   memset(pRate, 0, sizeof *pRate);
+}
+
+VOID APIENTRY
+VideoGetVideoProcessorFilterRange(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORENUM,
+                                  D3D11_1DDI_VIDEO_PROCESSOR_FILTER,
+                                  D3D11_1DDI_VIDEO_PROCESSOR_FILTER_RANGE *pRange)
+{
+   memset(pRange, 0, sizeof *pRange);
+}
+
+/* ---------------------------------------------------------- processor */
+
+SIZE_T APIENTRY
+VideoCalcPrivateVideoProcessorSize(D3D10DDI_HDEVICE, const D3D11_1DDIARG_CREATEVIDEOPROCESSOR *)
+{
+   return sizeof(VideoProcessor);
+}
+
+HRESULT APIENTRY
+VideoCreateVideoProcessor(D3D10DDI_HDEVICE, const D3D11_1DDIARG_CREATEVIDEOPROCESSOR *p,
+                          D3D11_1DDI_HVIDEOPROCESSOR hVp, D3D11_1DDI_HRTVIDEOPROCESSOR)
+{
+   VideoProcessor *vp = CastVp(hVp);
+   VideoProcessorEnum *e = CastEnum(p->hVideoProcessorEnum);
+
+   memset(vp, 0, sizeof *vp);
+   if (!e || p->RateConversionCapsIndex != 0)
+      return E_INVALIDARG;
+   vp->desc = e->desc;
+   /* The D3D11 defaults: opaque alpha, a black background, RGB 0-255
+    * out, BT.601 studio range in, the whole surfaces. */
+   vp->alpha_mode = D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE_OPAQUE;
+   vp->bg.RGBA.A = 1.0f;
+   vp->stream.alpha = 1.0f;
+   DebugPrintf("video: video processor created (%ux%u -> %ux%u)\n", e->desc.InputWidth,
+               e->desc.InputHeight, e->desc.OutputWidth, e->desc.OutputHeight);
+   return S_OK;
+}
+
+VOID APIENTRY
+VideoDestroyVideoProcessor(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSOR hVp)
+{
+   VideoProcessor *vp = CastVp(hVp);
+
+   DebugPrintf("video: video processor destroyed after %u blits\n", vp->blts);
+   memset(vp, 0, sizeof *vp);
+}
+
+VOID APIENTRY
+VideoVideoProcessorSetOutputTargetRect(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSOR hVp, BOOL Enable,
+                                       const RECT *pRect)
+{
+   VideoProcessor *vp = CastVp(hVp);
+   vp->target_enabled = Enable && pRect;
+   if (vp->target_enabled)
+      vp->target = *pRect;
+}
+
+VOID APIENTRY
+VideoVideoProcessorSetOutputBackgroundColor(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSOR hVp,
+                                            BOOL YCbCr, const D3D11_1DDI_VIDEO_COLOR *pColor)
+{
+   VideoProcessor *vp = CastVp(hVp);
+   vp->bg_ycbcr = YCbCr;
+   vp->bg = *pColor;
+}
+
+VOID APIENTRY
+VideoVideoProcessorSetOutputColorSpace(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSOR hVp,
+                                       const D3D11_1DDI_VIDEO_PROCESSOR_COLOR_SPACE *pCs)
+{
+   CastVp(hVp)->out_cs = *pCs;
+}
+
+VOID APIENTRY
+VideoVideoProcessorSetOutputAlphaFillMode(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSOR hVp,
+                                          D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE Mode, UINT)
+{
+   CastVp(hVp)->alpha_mode = Mode;
+}
