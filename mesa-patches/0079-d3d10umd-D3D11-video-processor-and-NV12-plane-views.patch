+
+VOID APIENTRY
+VideoVideoProcessorInputViewReadAfterWriteHazard(D3D10DDI_HDEVICE, D3D11_1DDI_HVIDEOPROCESSORINPUTVIEW,
+                                                 D3D10DDI_HRESOURCE)
+{
+   /* Every blit waits for the device's context first. */
+}
+
+/* ------------------------------------------------------------- colour */
+
+/*
+ * out = M * (a, b, c, 1), M 3x4: the input range taken to 0..1 (luma) and
+ * -0.5..0.5 (chroma), YCbCr to RGB (Kr, Kb of BT.601 or BT.709), the
+ * result taken to the output range (vdectest --vp checks it against its
+ * own model).
+ */
+static void
+vp_color_matrix(bool ycbcr, bool bt709, bool in_full, bool out_limited, float m[3][4])
+{
+   float in_s[3], in_o[3];
+   float c[3][3];
+   const float os = out_limited ? 219.0f / 255.0f : 1.0f;
+   const float oo = out_limited ? 16.0f / 255.0f : 0.0f;
+
+   if (ycbcr) {
+      const float kr = bt709 ? 0.2126f : 0.299f;
+      const float kb = bt709 ? 0.0722f : 0.114f;
+      const float kg = 1.0f - kr - kb;
+
+      in_s[0] = in_full ? 1.0f : 255.0f / 219.0f;
+      in_o[0] = in_full ? 0.0f : -16.0f / 219.0f;
+      in_s[1] = in_s[2] = in_full ? 1.0f : 255.0f / 224.0f;
+      in_o[1] = in_o[2] = in_full ? -128.0f / 255.0f : -128.0f / 224.0f;
+      float t[3][3] = {
+         { 1.0f, 0.0f, 2.0f - 2.0f * kr },
+         { 1.0f, -2.0f * kb * (1.0f - kb) / kg, -2.0f * kr * (1.0f - kr) / kg },
+         { 1.0f, 2.0f - 2.0f * kb, 0.0f },
+      };
+      memcpy(c, t, sizeof c);
+   } else {
+      /* RGB: in_full false is RGB 16-235 in. */
+      for (int i = 0; i < 3; i++) {
+         in_s[i] = in_full ? 1.0f : 255.0f / 219.0f;
+         in_o[i] = in_full ? 0.0f : -16.0f / 219.0f;
+      }
+      float t[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+      memcpy(c, t, sizeof c);
+   }
+   for (int r = 0; r < 3; r++) {
+      float off = 0.0f;
+      for (int k = 0; k < 3; k++) {
+         m[r][k] = os * c[r][k] * in_s[k];
+         off += c[r][k] * in_o[k];
+      }
+      m[r][3] = os * off + oo;
+   }
+}
+
+static bool
+StreamIsFull(const VideoProcessor *vp, bool ycbcr)
+{
+   if (ycbcr)
+      return vp->stream.cs.Nominal_Range == D3D11_1DDI_VIDEO_PROCESSOR_NOMINAL_RANGE_0_255;
+   return vp->stream.cs.RGB_Range == 0;
+}
+
+/* The background colour as RGB in the output range. */
+static void
+BackgroundColor(const VideoProcessor *vp, float rgba[4])
+{
+   const bool out_limited = vp->out_cs.RGB_Range != 0;
+
+   if (vp->bg_ycbcr) {
+      float m[3][4];
+      const float v[3] = { vp->bg.YCbCr.Y, vp->bg.YCbCr.Cb, vp->bg.YCbCr.Cr };
+      vp_color_matrix(true, vp->out_cs.YCbCr_Matrix != 0,
+                      vp->out_cs.Nominal_Range == D3D11_1DDI_VIDEO_PROCESSOR_NOMINAL_RANGE_0_255,
+                      out_limited, m);
+      for (int r = 0; r < 3; r++)
+         rgba[r] = CLAMP(m[r][0] * v[0] + m[r][1] * v[1] + m[r][2] * v[2] + m[r][3], 0.0f, 1.0f);
+      rgba[3] = vp->bg.YCbCr.A;
+   } else {
+      const float s = out_limited ? 219.0f / 255.0f : 1.0f, o = out_limited ? 16.0f / 255.0f : 0.0f;
+      rgba[0] = vp->bg.RGBA.R * s + o;
+      rgba[1] = vp->bg.RGBA.G * s + o;
+      rgba[2] = vp->bg.RGBA.B * s + o;
+      rgba[3] = vp->bg.RGBA.A;
+   }
+   if (vp->alpha_mode != D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE_BACKGROUND)
+      rgba[3] = 1.0f;
+}
+
+/* ------------------------------------------------------------ context */
+
+static VideoProcessorContext *
+GetContext(Device *pDevice)
+{
+   VideoProcessorContext *c = pDevice->vp;
+   struct pipe_screen *screen = pDevice->screen;
+
+   if (c)
+      return c->pipe ? c : NULL;
+   c = (VideoProcessorContext *)calloc(1, sizeof *c);
+   if (!c)
+      return NULL;
+   pDevice->vp = c;
+   c->pipe = screen->context_create(screen, NULL, 0);
+   if (!c->pipe) {
+      DebugPrintf("video: no context for the video processor\n");
+      return NULL;
+   }
+   c->cso = cso_create_context(c->pipe, 0);
+   static const enum tgsi_semantic names[] = { TGSI_SEMANTIC_POSITION, TGSI_SEMANTIC_GENERIC };
+   static const unsigned indexes[] = { 0, 0 };
+   c->vs = util_make_vertex_passthrough_shader(c->pipe, 2, names, indexes, false);
+   c->vbuf = pipe_buffer_create(screen, PIPE_BIND_VERTEX_BUFFER, PIPE_USAGE_DEFAULT, 4 * 8 * sizeof(float));
+   c->cbuf = pipe_buffer_create(screen, PIPE_BIND_CONSTANT_BUFFER, PIPE_USAGE_DEFAULT, 8 * 4 * sizeof(float));
+   if (!c->cso || !c->vs || !c->vbuf || !c->cbuf) {
+      DebugPrintf("video: video processor context incomplete (cso %d, vs %d, buffers %d %d)\n",
+                  c->cso != NULL, c->vs != NULL, c->vbuf != NULL, c->cbuf != NULL);
+      VideoDeviceDestroy(pDevice);
+      pDevice->vp = (VideoProcessorContext *)calloc(1, sizeof *c);   /* tried: NULL pipe */
+      return NULL;
+   }
+   DebugPrintf("video: video processor context created\n");
+   return c;
+}
+
+void
+VideoDeviceDestroy(Device *pDevice)
+{
+   VideoProcessorContext *c = pDevice->vp;
+
+   if (!c)
+      return;
+   if (c->pipe) {
+      if (c->cso) {
+         cso_unbind_context(c->cso);
+         cso_destroy_context(c->cso);
+      }
+      if (c->vs)
+         c->pipe->delete_vs_state(c->pipe, c->vs);
+      for (unsigned i = 0; i < ARRAYSIZE(c->fs); i++)
+         if (c->fs[i])
+            c->pipe->delete_fs_state(c->pipe, c->fs[i]);
+      pipe_resource_reference(&c->vbuf, NULL);
+      pipe_resource_reference(&c->cbuf, NULL);
+      c->pipe->destroy(c->pipe);
+   }
+   free(c);
+   pDevice->vp = NULL;
+}
+
+static void
+Wait(struct pipe_screen *screen, struct pipe_context *pipe)
+{
+   struct pipe_fence_handle *fence = NULL;
+
+   pipe->flush(pipe, &fence, 0);
+   if (fence) {
+      screen->fence_finish(screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      screen->fence_reference(screen, &fence, NULL);
+   }
+}
+
+/* ---------------------------------------------------------------- blt */
+
+static bool
+Clip(RECT *r, LONG w, LONG h)
+{
+   r->left = CLAMP(r->left, 0, w);
+   r->right = CLAMP(r->right, 0, w);
+   r->top = CLAMP(r->top, 0, h);
+   r->bottom = CLAMP(r->bottom, 0, h);
+   return r->right > r->left && r->bottom > r->top;
+}
+
+static bool
+Intersect(RECT *d, const RECT *a, const RECT *b)
+{
+   d->left = MAX2(a->left, b->left);
+   d->top = MAX2(a->top, b->top);
+   d->right = MIN2(a->right, b->right);
+   d->bottom = MIN2(a->bottom, b->bottom);
+   return d->right > d->left && d->bottom > d->top;
+}
+
+/* Stream 0 onto the bound surface: dst (output texels) from src (source
+ * texels), drawn inside scissor. */
+static bool
+DrawStream(Device *pDevice, VideoProcessorContext *c, VideoProcessor *vp, Resource *in, UINT slice,
+           const RECT *src, const RECT *dst, const RECT *scissor, unsigned out_w, unsigned out_h)
+{
+   struct pipe_context *pipe = c->pipe;
+   struct pipe_resource *tex = in->resource;
+   const bool nv12 = in->nv12;
+   const bool array = tex->target == PIPE_TEXTURE_2D_ARRAY;
+   const unsigned tex_h = tex->height0;
+   const unsigned plane_h = nv12 ? in->nv12_luma_height : tex_h;
+   void **fs = &c->fs[(nv12 ? 2 : 0) + (array ? 1 : 0)];
+
+   if (!*fs)
+      *fs = vp_create_fs(pipe, nv12, array);
+   if (!*fs) {
+      DebugPrintf("video: no video processor shader (nv12 %d, array %d)\n", nv12, array);
+      return false;
+   }
+
+   /* Constants (VideoShaders.c). */
+   float k[6][4];
+   memset(k, 0, sizeof k);
+   k[0][0] = 1.0f / tex->width0;
+   k[0][1] = 1.0f / tex_h;
+   k[0][2] = 0.5f;
+   k[0][3] = plane_h - 0.5f;
+   k[1][0] = tex->width0 / 2 - 1.0f;
+   k[1][1] = plane_h / 2 - 1.0f;
+   k[1][2] = (float)plane_h;
+   vp_color_matrix(nv12, vp->stream.cs.YCbCr_Matrix != 0, StreamIsFull(vp, nv12),
+                   vp->out_cs.RGB_Range != 0, (float (*)[4])&k[2][0]);
+   const float stream_alpha = vp->stream.alpha_enabled ? CLAMP(vp->stream.alpha, 0.0f, 1.0f) : 1.0f;
+   switch (vp->alpha_mode) {
+   case D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE_SOURCE_STREAM:
+      /* NV12 has none: the shader's source alpha is 1. */
+      k[5][0] = 0.0f;
+      k[5][1] = stream_alpha;
+      break;
+   case D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE_BACKGROUND:
+      k[5][0] = vp->bg_ycbcr ? vp->bg.YCbCr.A : vp->bg.RGBA.A;
+      break;
+   default:
+      k[5][0] = 1.0f;
+      break;
+   }
+   pipe_buffer_write(pipe, c->cbuf, 0, sizeof k, k);
+
+   /* A strip of two triangles over dst, carrying the source texel
+    * position (edges of src at the edges of dst). */
+   const float x0 = 2.0f * dst->left / out_w - 1.0f, x1 = 2.0f * dst->right / out_w - 1.0f;
+   const float y0 = 2.0f * dst->top / out_h - 1.0f, y1 = 2.0f * dst->bottom / out_h - 1.0f;
+   const float s0 = (float)src->left, s1 = (float)src->right;
+   const float t0 = (float)src->top, t1 = (float)src->bottom;
+   const float verts[4][8] = {
+      { x0, y0, 0, 1, s0, t0, 0, 0 },
+      { x1, y0, 0, 1, s1, t0, 0, 0 },
+      { x0, y1, 0, 1, s0, t1, 0, 0 },
+      { x1, y1, 0, 1, s1, t1, 0, 0 },
+   };
+   pipe_buffer_write(pipe, c->vbuf, 0, sizeof verts, verts);
+
+   struct pipe_sampler_view templ;
+   u_sampler_view_default_template(&templ, tex, tex->format);
+   templ.target = array ? PIPE_TEXTURE_2D_ARRAY : PIPE_TEXTURE_2D;
+   templ.u.tex.first_layer = templ.u.tex.last_layer = slice;
+   templ.u.tex.first_level = templ.u.tex.last_level = 0;
+   struct pipe_sampler_view *view = pipe->create_sampler_view(pipe, tex, &templ);
+   if (!view)
+      return false;
+
+   struct pipe_sampler_state ss;
+   memset(&ss, 0, sizeof ss);
+   ss.wrap_s = ss.wrap_t = ss.wrap_r = PIPE_TEX_WRAP_CLAMP_TO_EDGE;
+   ss.min_img_filter = ss.mag_img_filter = PIPE_TEX_FILTER_LINEAR;
+   ss.min_mip_filter = PIPE_TEX_MIPFILTER_NONE;
+   const struct pipe_sampler_state *pss = &ss;
+   cso_set_samplers(c->cso, MESA_SHADER_FRAGMENT, 1, &pss);
+   pipe->set_sampler_views(pipe, MESA_SHADER_FRAGMENT, 0, 1, 0, &view);
+
+   struct pipe_constant_buffer cb;
+   memset(&cb, 0, sizeof cb);
+   cb.buffer = c->cbuf;
+   cb.buffer_size = sizeof k;
+   pipe->set_constant_buffer(pipe, MESA_SHADER_FRAGMENT, 0, &cb);
+
+   struct pipe_blend_state blend;
+   memset(&blend, 0, sizeof blend);
+   blend.rt[0].colormask = vp->alpha_mode == D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE_DESTINATION
+                              ? PIPE_MASK_RGB : PIPE_MASK_RGBA;
+   cso_set_blend(c->cso, &blend);
+
+   struct pipe_depth_stencil_alpha_state dsa;
+   memset(&dsa, 0, sizeof dsa);
+   cso_set_depth_stencil_alpha(c->cso, &dsa);
+
+   struct pipe_rasterizer_state rs;
+   memset(&rs, 0, sizeof rs);
+   rs.half_pixel_center = 1;
+   rs.bottom_edge_rule = 1;
+   rs.depth_clip_near = 1;
+   rs.depth_clip_far = 1;
+   rs.scissor = 1;
+   cso_set_rasterizer(c->cso, &rs);
+
+   struct pipe_scissor_state sc;
+   sc.minx = scissor->left;
+   sc.miny = scissor->top;
+   sc.maxx = scissor->right;
+   sc.maxy = scissor->bottom;
+   pipe->set_scissor_states(pipe, 0, 1, &sc);
+   cso_set_viewport_dims(c->cso, (float)out_w, (float)out_h, false);
+
+   cso_set_vertex_shader_handle(c->cso, c->vs);
+   cso_set_fragment_shader_handle(c->cso, *fs);
+
+   struct cso_velems_state ve;
+   memset(&ve, 0, sizeof ve);
+   ve.count = 2;
+   for (unsigned i = 0; i < 2; i++) {
+      ve.velems[i].src_format = PIPE_FORMAT_R32G32B32A32_FLOAT;
+      ve.velems[i].src_offset = i * 4 * sizeof(float);
+      ve.velems[i].src_stride = 8 * sizeof(float);
+   }
+   cso_set_vertex_elements(c->cso, &ve);
+   util_draw_vertex_buffer(pipe, c->cso, c->vbuf, 0, MESA_PRIM_TRIANGLE_STRIP, 4, 2);
+
+   Wait(pDevice->screen, pipe);
+
+   struct pipe_sampler_view *none = NULL;
+   pipe->set_sampler_views(pipe, MESA_SHADER_FRAGMENT, 0, 0, 1, &none);
+   pipe->sampler_view_release(pipe, view);
+   return true;
+}
+
+HRESULT APIENTRY
+VideoVideoProcessorBlt(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVp,
+                       D3D11_1DDI_HVIDEOPROCESSOROUTPUTVIEW hOutput, UINT OutputFrame, UINT StreamCount,
+                       const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *pStreams)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoProcessor *vp = CastVp(hVp);
+   VideoProcessorOutputView *ov = CastVpOutputView(hOutput);
+   const char *why = NULL;
+
+   (void)OutputFrame;
+   if (!ov || !ov->resource || !ov->resource->resource)
+      return E_INVALIDARG;
+
+   VideoProcessorContext *c = GetContext(pDevice);
+   if (!c)
+      return E_OUTOFMEMORY;
+
+   struct pipe_resource *out = ov->resource->resource;
+   const unsigned out_w = u_minify(out->width0, ov->level);
+   const unsigned out_h = u_minify(out->height0, ov->level);
+   RECT target = { 0, 0, (LONG)out_w, (LONG)out_h };
+   if (vp->target_enabled) {
+      target = vp->target;
+      if (!Clip(&target, out_w, out_h))
+         target.right = target.left;    /* empty: nothing is written */
+   }
+
+   /* What the device's context did before the blit (a decode, a copy, a
+    * draw into the input) lands before the blit reads it. */
+   Wait(pDevice->screen, pDevice->pipe);
+
+   struct pipe_surface surf;
+   memset(&surf, 0, sizeof surf);
+   surf.format = out->format;
+   surf.texture = out;
+   surf.level = ov->level;
+   surf.first_layer = surf.last_layer = ov->slice;
+
+   struct pipe_framebuffer_state fb;
+   memset(&fb, 0, sizeof fb);
+   fb.width = out_w;
+   fb.height = out_h;
+   fb.nr_cbufs = 1;
+   fb.cbufs[0] = surf;
+   cso_set_framebuffer(c->cso, &fb);
+
+   if (target.right > target.left) {
+      union pipe_color_union color;
+      BackgroundColor(vp, color.f);
+      c->pipe->clear_render_target(c->pipe, &surf, &color, target.left, target.top,
+                                   target.right - target.left, target.bottom - target.top, false);
+   }
+
+   const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *s = StreamCount ? &pStreams[0] : NULL;
+   VideoProcessorInputView *iv = s && s->Enable ? CastInputView(s->hInputSurface) : NULL;
+   if (iv && iv->resource && iv->resource->resource && target.right > target.left) {
+      Resource *in = iv->resource;
+      const LONG in_w = in->resource->width0;
+      const LONG in_h = in->nv12 ? in->nv12_luma_height : in->resource->height0;
+      RECT src = { 0, 0, in_w, in_h };
+      RECT dst = { 0, 0, (LONG)out_w, (LONG)out_h };
+      RECT scissor;
+
+      if (vp->stream.src_enabled) {
+         src = vp->stream.src;
+         if (!Clip(&src, in_w, in_h))
+            why = "empty source rectangle";
+      }
+      if (vp->stream.dst_enabled)
+         dst = vp->stream.dst;
+      if (!why && !Intersect(&scissor, &target, &dst))
+         why = "destination outside the target rectangle";
+      if (!why && !Clip(&scissor, out_w, out_h))
+         why = "destination outside the surface";
+      if (!why && !DrawStream(pDevice, c, vp, in, iv->slice, &src, &dst, &scissor, out_w, out_h))
+         why = "the draw failed";
+   } else {
+      why = "no stream";
+   }
+   if (why)
+      Wait(pDevice->screen, c->pipe);
+
+   /* Nothing stays bound to the application's surface. */
+   memset(&fb, 0, sizeof fb);
+   cso_set_framebuffer(c->cso, &fb);
+
+   vp->blts++;
+   if (vp->blts <= 3 || (vp->blts % 300) == 0 || (why && vp->logged++ < 10))
+      DebugPrintf("video: blit %u -> %ux%u surface, target (%ld,%ld)-(%ld,%ld)%s%s\n", vp->blts,
+                  out_w, out_h, target.left, target.top, target.right, target.bottom,
+                  why ? ": " : "", why ? why : "");
+   return S_OK;
+}
+
+/* ---------------------------------------------------- NV12 plane views */
+
+/*
+ * An NV12 texture made with BIND_SHADER_RESOURCE gets two more textures,
+ * the planes as D3D11 hands them to shaders: R8_UNORM width x height
+ * (plane 0) and R8G8_UNORM width/2 x height/2 (plane 1). A shader resource
+ * view of the NV12 texture as R8_UNORM is a view of plane 0, as R8G8_UNORM
+ * of plane 1 (Shader.cpp). The NV12 texture itself stays what it is, the
+ * one that is decoded into, mapped and copied; the planes follow it:
+ *
+ *    a decoded picture    written into both (Video.cpp, CopyToTarget)
+ *    a copy, an update    planes copied from the source's planes, or read
+ *                         back from the texture (VideoNv12Refresh)
+ */
+bool
+VideoNv12CreatePlanes(struct pipe_screen *screen, Resource *r, const struct pipe_resource *templat)
+{
+   struct pipe_resource t = *templat;
+
+   t.bind = PIPE_BIND_SAMPLER_VIEW;
+   t.height0 = r->nv12_luma_height;
+   t.format = PIPE_FORMAT_R8_UNORM;
+   r->nv12_plane[0] = screen->resource_create(screen, &t);
+   t.width0 = templat->width0 / 2;
+   t.height0 = r->nv12_luma_height / 2;
+   t.format = PIPE_FORMAT_R8G8_UNORM;
+   r->nv12_plane[1] = screen->resource_create(screen, &t);
+   if (!r->nv12_plane[0] || !r->nv12_plane[1]) {
+      VideoNv12DestroyPlanes(r);
+      return false;
+   }
+   return true;
+}
+
+void
+VideoNv12DestroyPlanes(Resource *r)
+{
+   pipe_resource_reference(&r->nv12_plane[0], NULL);
+   pipe_resource_reference(&r->nv12_plane[1], NULL);
+}
+
+void
+VideoNv12WritePlanes(struct pipe_context *pipe, Resource *r, unsigned layer, const uint8_t *luma,
+                     const uint8_t *chroma, unsigned stride, unsigned width, unsigned rows)
+{
+   struct pipe_box box;
+
+   if (!r->nv12_plane[0])
+      return;
+   width = MIN2(width, r->nv12_plane[0]->width0) & ~1u;
+   rows = MIN2(rows, r->nv12_luma_height) & ~1u;
+   u_box_3d(0, 0, layer, width, rows, 1, &box);
+   pipe->texture_subdata(pipe, r->nv12_plane[0], 0, PIPE_MAP_WRITE, &box, luma, stride, 0);
+   u_box_3d(0, 0, layer, width / 2, rows / 2, 1, &box);
+   pipe->texture_subdata(pipe, r->nv12_plane[1], 0, PIPE_MAP_WRITE, &box, chroma, stride, 0);
+}
+
+/* The planes of one layer from the NV12 texture: a read back, for the
+ * rare writes that are not decodes (UpdateSubresource, a copy from a
+ * texture with no planes). */
+void
+VideoNv12Refresh(struct pipe_context *pipe, Resource *r, unsigned layer)
+{
+   struct pipe_transfer *xfer;
+   struct pipe_resource *tex = r->resource;
+
+   if (!r->nv12_plane[0] || !tex)
+      return;
+   const uint8_t *map = (const uint8_t *)pipe_texture_map(pipe, tex, 0, layer, PIPE_MAP_READ, 0, 0,
+                                                          tex->width0, tex->height0, &xfer);
+   if (!map)
+      return;
+   VideoNv12WritePlanes(pipe, r, layer, map, map + (size_t)xfer->stride * r->nv12_luma_height,
+                        xfer->stride, tex->width0, r->nv12_luma_height);
+   pipe_texture_unmap(pipe, xfer);
+}
+
+/* After a copy into dst's layer: the planes copied from src's when it has
+ * them, else read back. Boxes in luma texels. */
+void
+VideoNv12AfterCopy(struct pipe_context *pipe, Resource *dst, unsigned dst_layer, unsigned dx,
+                   unsigned dy, Resource *src, const struct pipe_box *src_box)
+{
+   if (!dst->nv12_plane[0])
+      return;
+   if (src && src->nv12 && src->nv12_plane[0]) {
+      struct pipe_box b = *src_box;
+      b.height = MIN2(b.height, (int)src->nv12_luma_height - b.y);
+      pipe->resource_copy_region(pipe, dst->nv12_plane[0], 0, dx, dy, dst_layer, src->nv12_plane[0], 0, &b);
+      b.x /= 2;
+      b.y /= 2;
+      b.width /= 2;
+      b.height /= 2;
+      pipe->resource_copy_region(pipe, dst->nv12_plane[1], 0, dx / 2, dy / 2, dst_layer,
+                                 src->nv12_plane[1], 0, &b);
+      return;
+   }
+   VideoNv12Refresh(pipe, dst, dst_layer);
+}
