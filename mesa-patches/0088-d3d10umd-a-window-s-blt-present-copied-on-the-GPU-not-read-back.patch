+/*
+ * A window's blt model present, without reading the frame back.
+ *
+ * The frame used to be mapped, copied row by row into an allocation of the
+ * device's, and that blted by maliwddm into DWM's surface for the window:
+ * two CPU passes over the frame, both reading write-combined memory at
+ * about 100 MB/s. At 2560x1440 that was 100 ms and 80 ms a present, Edge
+ * with --disable-direct-composition at 4 frames a second (2026-11-27).
+ *
+ * Instead the back buffer is copied on the GPU into a linear BGRX surface
+ * whose buffer is an allocation the kernel driver knows the size and
+ * pitch of and VidMm backs with cached pages (MW_ALLOC_CACHED): one CPU
+ * pass is left, the kernel's, reading at memory speed. Nothing maps that
+ * surface in user mode. C:\mali\present-readback brings the old path
+ * back, to compare.
+ */
+static bool
+PresentOnGpu(void)
+{
+   static int state = -1;
+
+   if (state < 0)
+      state = SwitchFileAbsent("C:\\mali\\present-readback",
+                               "absent, a window's blt present is copied on the GPU",
+                               "present, a window's blt present is read back on the CPU");
+   return state != 0;
+}
+
+
+bool
+PresentCopyEnsure(struct Device *pDevice, struct Resource *pResource)
+{
+   struct pipe_context *pipe = pDevice->pipe;
+   struct pipe_screen *screen = pipe->screen;
+   struct pipe_resource *src = pResource->resource;
+   struct pipe_resource templat;
+   unsigned pitch, allocation, stride = 0;
+
+   if (pResource->present_copy)
+      return true;
+   if (pResource->present_copy_failed || !PresentOnGpu())
+      return false;
+   pResource->present_copy_failed = true;      /* until it has worked */
+   if (!src || pResource->buffer || src->target != PIPE_TEXTURE_2D || src->array_size > 1 ||
+       src->depth0 > 1 || util_format_is_depth_or_stencil(src->format) ||
+       !screen->is_format_supported(screen, PIPE_FORMAT_B8G8R8X8_UNORM, PIPE_TEXTURE_2D, 0, 0,
+                                    PIPE_BIND_RENDER_TARGET))
+      return false;
+
+   memset(&templat, 0, sizeof templat);
+   templat.target = PIPE_TEXTURE_2D;
+   templat.format = PIPE_FORMAT_B8G8R8X8_UNORM;
+   templat.width0 = src->width0;
+   templat.height0 = src->height0;
+   templat.depth0 = 1;
+   templat.array_size = 1;
+   templat.usage = PIPE_USAGE_DEFAULT;
+   templat.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SHARED;
+   pitch = align(templat.width0 * 4, 64);
+
+   d3d10_present_begin_create(pDevice->hDevice, templat.width0, templat.height0, pitch);
+   pResource->present_copy = screen->resource_create(screen, &templat);
+   allocation = d3d10_shared_end();
+   if (!pResource->present_copy || !allocation ||
+       !MarkResourceShared(pipe, pResource->present_copy, &stride) || stride != pitch) {
+      DebugPrintf("present: no GPU copy surface for %ux%u (resource %p, allocation 0x%x, pitch %u"
+                  " of %u): the frame is read back\n", templat.width0, templat.height0,
+                  pResource->present_copy, allocation, stride, pitch);
+      pipe_resource_reference(&pResource->present_copy, NULL);
+      return false;
+   }
+   pResource->present_copy_allocation = allocation;
+   pResource->present_copy_failed = false;
+   DebugPrintf("present: GPU copy surface %ux%u pitch %u, allocation 0x%x\n", templat.width0,
+               templat.height0, pitch, allocation);
+   return true;
+}
