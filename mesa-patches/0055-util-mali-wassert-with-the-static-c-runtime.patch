--- a/src/util/mali_wassert.c
+++ b/src/util/mali_wassert.c
@@ -95,4 +95,15 @@ mali_log_line(const char *msg)
 /* What "__declspec(dllimport) mali_wassert" resolves to. */
 void (__cdecl *__imp_mali_wassert)(const wchar_t *, const wchar_t *, unsigned) = mali_wassert_impl;
 
+#ifndef _DLL
+/* With the static C runtime (/MT, the x64 and x86 builds for emulated
