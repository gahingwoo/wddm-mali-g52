diff --git a/src/gallium/frontends/d3d10umd/DxgiFns.cpp b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
index 8d0c355..612cb9f 100644
--- a/src/gallium/frontends/d3d10umd/DxgiFns.cpp
+++ b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
@@ -248,6 +248,26 @@ _RotateResourceIdentities( DXGI_DDI_ARG_ROTATE_RESOURCE_IDENTITIES *RotateResour
 
    pipe_resource_reference(&temp_resource, NULL);
 
+   /*
+    * The allocations the runtime presents rotate with the identities: after
+    * this call the runtime regards what belonged to pResources[i + 1] as
+    * belonging to pResources[i]. Follow it, or every Present hands over the
+    * same allocation and nothing ever flips. (dwm.exe: 296 presents, all of
+    * allocation 0x400012c0, one flip.)
+    */
+   {
+      UINT n = RotateResourceIdentities->Resources;
+      Resource *first = CastResource(RotateResourceIdentities->pResources[0]);
+      unsigned first_allocation = first->present_allocation;
+
+      for (UINT i = 0; i + 1 < n; ++i) {
+         CastResource(RotateResourceIdentities->pResources[i])->present_allocation =
+            CastResource(RotateResourceIdentities->pResources[i + 1])->present_allocation;
+      }
+      CastResource(RotateResourceIdentities->pResources[n - 1])->present_allocation =
+         first_allocation;
+   }
+
    return S_OK;
 }
 
