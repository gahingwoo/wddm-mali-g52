+/*
+ * The slice control of one SubmitDecoderBuffers call. Its offsets are from
+ * the start of that call's bitstream buffer, and a frame may come in
+ * several calls (Chromium submits when a bitstream buffer is full), so they
+ * are moved by base: where that buffer's bytes start in d->bitstream.
+ */
+static bool
+ReadSliceControl(Device *pDevice, VideoDecoder *d, const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *b,
+                 int64_t base)
+{
+   unsigned got, i, n;
+
+   if (!d->slice_tmp) {
+      d->slice_tmp = (uint8_t *)malloc(SLICE_CONTROL_MAX);
+      if (!d->slice_tmp)
+         return false;
+   }
+   uint8_t *tmp = d->slice_tmp;
+   if (!ReadBuffer(pDevice, b, tmp, SLICE_CONTROL_MAX, &got))
+      return false;
+   switch (d->profile->codec) {
+   case VDEC_CODEC_H264:
+      /* The short form only says where each slice starts; the decoder
+       * finds the slices from their start codes. */
+      d->slices += got / 10;     /* sizeof(DXVA_Slice_H264_Short) */
+      return true;
+   case VDEC_CODEC_HEVC:
+   case VDEC_CODEC_VP9:
+      /* DXVA_Slice_HEVC_Short, DXVA_Slice_VPx_Short: the same three fields. */
+      n = got / sizeof(V383_DXVA_Slice_HEVC_Short);
+      for (i = 0; i < n; i++) {
+         V383_DXVA_Slice_HEVC_Short sl;
+         memcpy(&sl, tmp + i * sizeof sl, sizeof sl);
+         int64_t end = base + (int64_t)sl.BSNALunitDataLocation + sl.SliceBytesInBuffer;
+         if (end > 0 && end <= 0xFFFFFFFFll && (unsigned)end > d->data_end)
+            d->data_end = (unsigned)end;
+      }
+      d->slices += n;
+      return true;
+   default:
+      n = got / sizeof(V383_DXVA_Tile_AV1);
+      if (d->num_tiles + n > d->tiles_cap) {
+         unsigned cap = MAX2(d->num_tiles + n, 64u);
+         V383_DXVA_Tile_AV1 *t = (V383_DXVA_Tile_AV1 *)realloc(d->tiles, cap * sizeof *t);
+         if (!t)
+            return false;
+         d->tiles = t;
+         d->tiles_cap = cap;
+      }
+      for (i = 0; i < n; i++) {
+         V383_DXVA_Tile_AV1 t;
+         memcpy(&t, tmp + i * sizeof t, sizeof t);
+         int64_t off = base + (int64_t)t.DataOffset;
+         if (off < 0 || off > 0xFFFFFFFFll)
+            return false;
+         t.DataOffset = (unsigned)off;
+         d->tiles[d->num_tiles++] = t;
+      }
+      d->slices += n;
+      return true;
+   }
+}
