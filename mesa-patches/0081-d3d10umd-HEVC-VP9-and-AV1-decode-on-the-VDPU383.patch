+static unsigned
+PicParamsSize(vdec_codec codec)
+{
+   switch (codec) {
+   case VDEC_CODEC_HEVC: return sizeof(V383_DXVA_PicParams_HEVC);
+   case VDEC_CODEC_VP9: return sizeof(V383_DXVA_PicParams_VP9);
+   case VDEC_CODEC_AV1: return sizeof(V383_DXVA_PicParams_AV1);
+   default: return sizeof(V383_DXVA_PicParams_H264);
+   }
+}
