diff --git a/src/gallium/frontends/d3d10umd/Shader.cpp b/src/gallium/frontends/d3d10umd/Shader.cpp
index df6ffa1..fb32f8b 100644
--- a/src/gallium/frontends/d3d10umd/Shader.cpp
+++ b/src/gallium/frontends/d3d10umd/Shader.cpp
@@ -45,6 +45,31 @@
 #include "util/format/u_format.h"
 
 
+/*
+ * A screen without a geometry shader stage (Panfrost) has no
+ * create_gs_state, and d3d10umd's stream output without a geometry shader
+ * is an empty geometry shader too. Creating either fails the way the DDI
+ * allows, E_OUTOFMEMORY; the object is left empty so that a later bind,
+ * draw or destroy of it touches nothing.
+ */
+static bool
+GeometryShaderUnsupported(D3D10DDI_HDEVICE hDevice, Shader *pShader, const char *what)
+{
+   Device *pDevice = CastDevice(hDevice);
+
+   if (pDevice->has_gs)
+      return false;
+
+   memset(pShader, 0, sizeof *pShader);
+   pShader->type = MESA_SHADER_GEOMETRY;
+   pShader->output_resolved = true;
+   DebugPrintf("%s: no geometry shader stage on %s, E_OUTOFMEMORY\n", what,
+               pDevice->screen->get_name(pDevice->screen));
+   SetError(hDevice, E_OUTOFMEMORY);
+   return true;
+}
+
+
 /*
  * ----------------------------------------------------------------------
  *
@@ -306,7 +331,8 @@ DestroyShader(D3D10DDI_HDEVICE hDevice,   // IN
          pipe->delete_vs_state(pipe, pShader->handle);
          break;
       case MESA_SHADER_GEOMETRY:
-         pipe->delete_gs_state(pipe, pShader->handle);
+         if (pipe->delete_gs_state)
+            pipe->delete_gs_state(pipe, pShader->handle);
          break;
       default:
          assert(0);
@@ -679,6 +705,9 @@ CreateGeometryShader(D3D10DDI_HDEVICE hDevice,                                //
    struct pipe_context *pipe = CastPipeContext(hDevice);
    Shader *pShader = CastShader(hShader);
 
+   if (GeometryShaderUnsupported(hDevice, pShader, "CreateGeometryShader"))
+      return;
+
    pShader->type = MESA_SHADER_GEOMETRY;
    pShader->output_resolved = true;
 
@@ -711,6 +740,19 @@ GsSetShader(D3D10DDI_HDEVICE hDevice,  // IN
    void *state = CastPipeShader(hShader);
    Shader *pShader = CastShader(hShader);
 
+   if (!pDevice->has_gs) {
+      /* Nothing was created, so nothing can be bound; a non-NULL handle
+       * here is one whose creation failed. Draws while it is bound draw
+       * nothing (see Draw.cpp). */
+      bool ignored = pShader != NULL;
+      if (ignored != pDevice->gs_ignored)
+         DebugPrintf("GsSetShader: %s on a screen with no geometry shaders\n",
+                     ignored ? "a geometry shader bound, draws are skipped"
+                             : "unbound, draws resume");
+      pDevice->gs_ignored = ignored;
+      return;
+   }
+
    assert(pipe->bind_gs_state);
 
    if (pShader && !pShader->state.tokens) {
@@ -843,6 +885,15 @@ CreateGeometryShaderWithStreamOutput(
    unsigned num_holes = 0;
    bool all_slot_zero = true;
 
+   /* Panfrost does stream output for GLES with a vertex-shader variant whose
+    * outputs come from NIR xfb info; a TGSI shader's pipe_stream_output_info
+    * is stored and never turned into that, and the frontend's pass-through
+    * stream output is an empty geometry shader. Neither exists here. */
+   if (GeometryShaderUnsupported(hDevice, pShader,
+                                 pData->pShaderCode ? "CreateGeometryShaderWithStreamOutput"
+                                                    : "CreateGeometryShaderWithStreamOutput (no GS, stream output only)"))
+      return;
+
    pShader->type = MESA_SHADER_GEOMETRY;
 
    memset(&pShader->state, 0, sizeof pShader->state);
@@ -948,9 +999,10 @@ SoSetTargets(D3D10DDI_HDEVICE hDevice,                                     // IN
             if (so_target) {
                pipe_so_target_reference(&so_target, NULL);
             }
-            so_target = pipe->create_stream_output_target(pipe, buffer,
+            so_target = pipe->create_stream_output_target ?
+                        pipe->create_stream_output_target(pipe, buffer,
                                                           0,/*buffer offset*/
-                                                          buffer_size);
+                                                          buffer_size) : NULL;
             resource->so_target = so_target;
          }
       }
@@ -966,6 +1018,18 @@ SoSetTargets(D3D10DDI_HDEVICE hDevice,                                     // IN
       return;
    }
 
+   if (!pDevice->has_gs && SOTargets) {
+      /* Targets are kept (DrawAuto and IaSetVertexBuffers look them up) but
+       * nothing can be written to them: no shader that could create stream
+       * output was created. */
+      static bool logged;
+      if (!logged) {
+         logged = true;
+         DebugPrintf("SoSetTargets: %u targets on a screen with no geometry shaders; "
+                     "nothing will be written to them\n", SOTargets);
+      }
+   }
+
    pipe->set_stream_output_targets(pipe, SOTargets, pDevice->so_targets,
                                    pOffsets, MESA_PRIM_UNKNOWN);
 }
diff --git a/src/gallium/frontends/d3d10umd/State.h b/src/gallium/frontends/d3d10umd/State.h
