+/*
+ * A geometry shader the screen could not create is bound (GsSetShader keeps
+ * nothing on a screen without the stage). Running the vertex shader straight
+ * into the rasterizer would draw something the application did not ask for;
+ * draw nothing instead.
+ */
+static bool
+SkipDrawForGs(Device *pDevice, const char *what)
+{
+   static volatile LONG skipped = 0;
+
+   if (!pDevice->gs_ignored)
+      return false;
+   if (InterlockedIncrement(&skipped) <= 4)
+      DebugPrintf("%s: skipped, a geometry shader this screen cannot run is bound\n", what);
+   return true;
+}
+
+
 /* The parameters of the first draws of a process, to the file log: which
  * draw a missing primitive was, without a debugger. */
 static void
@@ -170,6 +189,8 @@ Draw(D3D10DDI_HDEVICE hDevice,   // IN
 
    Device *pDevice = CastDevice(hDevice);
    LogDraw(pDevice, "Draw", VertexCount, 1, StartVertexLocation, 0, 0);
+   if (SkipDrawForGs(pDevice, "Draw"))
+      return;
 
    ResolveState(pDevice);
 
@@ -201,6 +222,8 @@ DrawIndexed(D3D10DDI_HDEVICE hDevice,  // IN
 
    Device *pDevice = CastDevice(hDevice);
    LogDraw(pDevice, "DrawIndexed", IndexCount, 1, StartIndexLocation, BaseVertexLocation, 0);
+   if (SkipDrawForGs(pDevice, "DrawIndexed"))
+      return;
    struct pipe_draw_info info;
    struct pipe_draw_start_count_bias draw;
    struct pipe_resource *null_ib = NULL;
@@ -260,6 +283,8 @@ DrawInstanced(D3D10DDI_HDEVICE hDevice,      // IN
 
    Device *pDevice = CastDevice(hDevice);
    LogDraw(pDevice, "DrawInstanced", VertexCountPerInstance, InstanceCount, StartVertexLocation, 0, StartInstanceLocation);
+   if (SkipDrawForGs(pDevice, "DrawInstanced"))
+      return;
 
    if (!InstanceCount) {
       return;
@@ -300,6 +325,8 @@ DrawIndexedInstanced(D3D10DDI_HDEVICE hDevice,   // IN
 
    Device *pDevice = CastDevice(hDevice);
    LogDraw(pDevice, "DrawIndexedInstanced", IndexCountPerInstance, InstanceCount, StartIndexLocation, BaseVertexLocation, StartInstanceLocation);
+   if (SkipDrawForGs(pDevice, "DrawIndexedInstanced"))
+      return;
    struct pipe_draw_info info;
    struct pipe_draw_start_count_bias draw;
    struct pipe_resource *null_ib = NULL;
@@ -373,6 +400,19 @@ DrawAuto(D3D10DDI_HDEVICE hDevice)  // IN
       return;
    }
 
+   if (SkipDrawForGs(pDevice, "DrawAuto"))
+      return;
+
+   /* Without a geometry shader stage no stream output was ever written, so
+    * there is nothing to draw. Panfrost would also take draws == NULL with
+    * count_from_stream_output for a direct draw and read draws[0]. */
+   if (!pDevice->has_gs) {
+      static volatile LONG logged = 0;
+      if (InterlockedIncrement(&logged) == 1)
+         DebugPrintf("DrawAuto: nothing drawn, no stream output on a screen with no geometry shaders\n");
+      return;
+   }
+
    assert(pDevice->primitive < MESA_PRIM_COUNT);
 
    ResolveState(pDevice);
diff --git a/src/gallium/frontends/d3d10umd/Query.cpp b/src/gallium/frontends/d3d10umd/Query.cpp
