diff --git a/src/util/mali_count.c b/src/util/mali_count.c
new file mode 100644
index 0000000..7d38a4a
--- /dev/null
+++ b/src/util/mali_count.c
@@ -0,0 +1,68 @@
+/*
+ * Counters of the Windows Mali UMD; see mali_count.h.
+ */
+#include "mali_count.h"
+
+#ifdef _WIN32
+#include <windows.h>
+
+static struct {
+   volatile LONG64 calls, bytes, ticks;
+} counts[MALI_COUNT_KINDS];
+
+static volatile LONG flags = -1;
+
+uint64_t
+mali_count_now(void)
+{
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   return (uint64_t)t.QuadPart;
+}
+
+void
+mali_count_add(unsigned kind, uint64_t bytes, uint64_t t0)
+{
+   if (kind >= MALI_COUNT_KINDS)
+      return;
+   InterlockedIncrement64(&counts[kind].calls);
+   if (bytes)
+      InterlockedAdd64(&counts[kind].bytes, (LONG64)bytes);
+   if (t0)
+      InterlockedAdd64(&counts[kind].ticks, (LONG64)(mali_count_now() - t0));
+}
+
+void
+mali_count_take(struct mali_count out[MALI_COUNT_KINDS])
+{
+   for (unsigned k = 0; k < MALI_COUNT_KINDS; k++) {
+      out[k].calls = (uint64_t)InterlockedExchange64(&counts[k].calls, 0);
+      out[k].bytes = (uint64_t)InterlockedExchange64(&counts[k].bytes, 0);
+      out[k].ticks = (uint64_t)InterlockedExchange64(&counts[k].ticks, 0);
+   }
+}
+
+void
+mali_count_give_back(const struct mali_count in[MALI_COUNT_KINDS])
+{
+   for (unsigned k = 0; k < MALI_COUNT_KINDS; k++) {
+      InterlockedAdd64(&counts[k].calls, (LONG64)in[k].calls);
+      InterlockedAdd64(&counts[k].bytes, (LONG64)in[k].bytes);
+      InterlockedAdd64(&counts[k].ticks, (LONG64)in[k].ticks);
+   }
+}
+
+uint32_t
+mali_count_flags(void)
+{
+   return (uint32_t)flags;
+}
+
+void
+mali_count_set_flags(uint32_t f)
+{
+   InterlockedExchange(&flags, (LONG)f);
+}
+#else
+typedef int mali_count_unused;
+#endif
diff --git a/src/util/mali_count.h b/src/util/mali_count.h
new file mode 100644
index 0000000..62a06d3
--- /dev/null
+++ b/src/util/mali_count.h
@@ -0,0 +1,84 @@
+/*
+ * Counters of the Windows Mali UMD (maliumd.dll): what the driver did on
+ * the CPU and on the GPU, by kind, so that "m5test perf" on the board can
+ * tell a GPU copy from a CPU copy and a read-back present from one that
+ * copies nothing.
+ *
+ *    uint64_t t0 = mali_count_now();
+ *    ... the operation ...
+ *    mali_count_add(MALI_COUNT_UPLOAD, bytes, t0);
+ *
+ * The sums are per process. The Panfrost winsys (malikm_drm.c) takes them
+ * about once a second and hands them to maliwddm (MW_ESCAPE_UMD), which
+ * answers with the switches its registry settings give; mali_count_flags()
+ * returns those (all on until the first answer). The kinds are the KMD's
+ * MW_UMD_* (include/maliwddm_abi.h in wddm-mali-g52), by number.
+ *
+ * Off Windows everything here is empty.
+ */
+#ifndef MALI_COUNT_H
+#define MALI_COUNT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum mali_count_kind {
+   MALI_COUNT_COPY_GPU = 0,
+   MALI_COUNT_COPY_CPU = 1,
+   MALI_COUNT_COPY_CPU_BUFFER = 2,
+   MALI_COUNT_UPLOAD = 3,
+   MALI_COUNT_MAP_READ = 4,
+   MALI_COUNT_MAP_WRITE = 5,
+   MALI_COUNT_PRESENT_READBACK = 6,
+   MALI_COUNT_PRESENT_DIRECT = 7,
+   MALI_COUNT_GPU_WAIT = 8,
+   MALI_COUNT_BLT = 9,
+   MALI_COUNT_RESOLVE = 10,
+   MALI_COUNT_KINDS = 12,
+};
+
+/* maliwddm's MW_UMD_FLAG_*. */
+#define MALI_COUNT_FLAG_COPY_GPU   0x1u
+#define MALI_COUNT_FLAG_READBACK_1 0x2u
+
+struct mali_count {
+   uint64_t calls, bytes, ticks;
+};
+
+#ifdef _WIN32
+
+/* Now, in performance-counter ticks. */
+uint64_t mali_count_now(void);
+
+/* One call of Kind, with Bytes, that started at T0 (0: no time). */
+void mali_count_add(unsigned kind, uint64_t bytes, uint64_t t0);
+
+/* The sums since the previous take, which start again from 0. */
+void mali_count_take(struct mali_count out[MALI_COUNT_KINDS]);
+
+/* Back into the sums: a take whose report did not get through. */
+void mali_count_give_back(const struct mali_count in[MALI_COUNT_KINDS]);
+
+/* The switches maliwddm handed out; every bit set until it has. */
+uint32_t mali_count_flags(void);
+void mali_count_set_flags(uint32_t flags);
+
+#else
+
+static inline uint64_t mali_count_now(void) { return 0; }
+static inline void mali_count_add(unsigned kind, uint64_t bytes, uint64_t t0)
+{
+   (void)kind; (void)bytes; (void)t0;
+}
+static inline uint32_t mali_count_flags(void) { return ~0u; }
+
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MALI_COUNT_H */
