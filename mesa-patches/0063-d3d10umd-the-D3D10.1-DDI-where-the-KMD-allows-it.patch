-   if (pSupportedDDIInterfaceVersions &&
-       *puEntries < ARRAYSIZE(SupportedDDIInterfaceVersions)) {
+   /* The D3D10.0 entries come first; the D3D10.1 ones (and later) only
+    * where the adapter offers them. */
+   UINT n = ARRAYSIZE(SupportedDDIInterfaceVersions);
+   if (CastAdapter(hAdapter)->ddi < 101)
+      n = 3;
+
+   if (pSupportedDDIInterfaceVersions && *puEntries < n) {
       return E_OUTOFMEMORY;
    }
 
-   *puEntries = ARRAYSIZE(SupportedDDIInterfaceVersions);
+   *puEntries = n;
 
    if (pSupportedDDIInterfaceVersions) {
       memcpy(pSupportedDDIInterfaceVersions,
              SupportedDDIInterfaceVersions,
-             sizeof SupportedDDIInterfaceVersions);
+             n * sizeof SupportedDDIInterfaceVersions[0]);
    }
 
    return S_OK;
