index 3259249..ac94a51 100644
--- a/src/gallium/frontends/d3d10umd/Adapter.cpp
+++ b/src/gallium/frontends/d3d10umd/Adapter.cpp
@@ -62,6 +62,46 @@ static unsigned long memdbg_no = 0;
  */
 
 
+/*
+ * What maliwddm lets the UMD offer: its answer to KMTQAITYPE_UMDRIVERPRIVATE,
+ * MW_UMD_ADAPTER_INFO in wddm-mali-g52's include/maliwddm_abi.h, by layout
+ * (the frontend does not see that header). The KMD fills Ddi from its
+ * UmdDdi setting: 100 the D3D10.0 DDI, 101 the D3D10.1 DDI. Any other
+ * driver, the software runtime, or a KMD from before the query: 100, the
+ * DDI this frontend always offered.
+ */
+struct MaliUmdInfo {
+   UINT Magic, Size, Ddi, FeatureLevel, Dxgi12, Video, DecodeNode, VirtualMode, KmdBuild;
+   UINT Reserved[7];
+};
+#define MALI_UMD_INFO_MAGIC 0x3149574Du
+
+static unsigned
+QueryUmdDdi(const D3D10DDIARG_OPENADAPTER *pOpenData)
+{
+   MaliUmdInfo info = {};
+   D3DDDICB_QUERYADAPTERINFO q = {};
+   unsigned ddi = 100;
+
+   if (pOpenData->pAdapterCallbacks && pOpenData->pAdapterCallbacks->pfnQueryAdapterInfoCb) {
+      q.pPrivateDriverData = &info;
+      q.PrivateDriverDataSize = sizeof info;
+      HRESULT hr = pOpenData->pAdapterCallbacks->pfnQueryAdapterInfoCb(pOpenData->hRTAdapter.handle, &q);
+      if (SUCCEEDED(hr) && info.Magic == MALI_UMD_INFO_MAGIC && info.Size >= 3 * sizeof(UINT))
+         ddi = info.Ddi >= 101 ? 101 : 100;
+      DebugPrintf("OpenAdapter: KMD adapter info 0x%08lx, magic 0x%08x, UmdDdi %u: offering D3D10.%u\n",
+                  (unsigned long)hr, info.Magic, info.Ddi, ddi == 101 ? 1 : 0);
+   }
+   return ddi;
+}
+
+static bool
+IsD3D10_1Interface(UINT Interface)
+{
+   return Interface == D3D10_1_DDI_INTERFACE_VERSION || Interface == D3D10_1_x_DDI_INTERFACE_VERSION ||
+          Interface == D3D10_1_7_DDI_INTERFACE_VERSION;
+}
+
 static HRESULT
 OpenAdapterCommon(__inout D3D10DDIARG_OPENADAPTER *pOpenData)   // IN
 {
@@ -79,6 +119,7 @@ OpenAdapterCommon(__inout D3D10DDIARG_OPENADAPTER *pOpenData)   // IN
    }
 
    pAdaptor->hRTAdapter = pOpenData->hRTAdapter.handle;
+   pAdaptor->ddi = QueryUmdDdi(pOpenData);
    pOpenData->hAdapter.pDrvPrivate = pAdaptor;
 
    pOpenData->pAdapterFuncs->pfnCalcPrivateDeviceSize = CalcPrivateDeviceSize;
@@ -132,6 +173,10 @@ OpenAdapter10(__inout D3D10DDIARG_OPENADAPTER *pOpenData)   // IN
       return E_FAIL;
    }
 
+   /* The D3D10.1 interface only where the KMD allows it. */
+   if (IsD3D10_1Interface(pOpenData->Interface) && QueryUmdDdi(pOpenData) < 101)
+      return E_FAIL;
+
    return OpenAdapterCommon(pOpenData);
 }
 
