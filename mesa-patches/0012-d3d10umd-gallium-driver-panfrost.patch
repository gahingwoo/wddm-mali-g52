diff --git a/src/gallium/targets/d3d10umd/d3d10_gdi.c b/src/gallium/targets/d3d10umd/d3d10_gdi.c
index cafc790..40491c5 100644
--- a/src/gallium/targets/d3d10umd/d3d10_gdi.c
+++ b/src/gallium/targets/d3d10umd/d3d10_gdi.c
@@ -31,6 +31,10 @@
 #include "target-helpers/inline_debug_helper.h"
 #include "llvmpipe/lp_public.h"
 #include "softpipe/sp_public.h"
+#ifdef GALLIUM_PANFROST
+#include <stdio.h>
+#include "panfrost/drm/panfrost_drm_public.h"
+#endif
 #include "sw/gdi/gdi_sw_winsys.h"
 
 #include "winddk_compat.h"
@@ -83,6 +87,17 @@ d3d10_create_screen(void)
    (void)driver;
 #endif
 
+#ifdef GALLIUM_PANFROST
+   if (strcmp(driver, "panfrost") == 0) {
+      /* Arm Mali through Panfrost (wddm-mali-g52). The fd will name the Mali
+       * kernel driver; until that exists Panfrost finds no device and
+       * softpipe takes over. */
+      screen = panfrost_drm_screen_create(-1, NULL);
+      if (screen == NULL)
+         fprintf(stderr, "d3d10umd: Panfrost found no Mali device, using softpipe\n");
+   }
+#endif
+
    if (screen == NULL) {
       screen = softpipe_create_screen( winsys );
    }
