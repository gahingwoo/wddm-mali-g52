+/*
+ * What Panfrost and the shim call that the Direct3D UMD defines in its own
+ * frontend (d3d10umd/Debug.cpp): its log, and the slow-operation log, which
+ * is off here.
+ */
+static void
+wgl_pan_log_append(const char *buf, int len)
+{
+   static HANDLE log = NULL;
+   DWORD done;
+
+   if (log == NULL) {
+      HANDLE f = INVALID_HANDLE_VALUE;
+      if (GetFileAttributesA("C:\\mali\\log") != INVALID_FILE_ATTRIBUTES) {
+         char exe[MAX_PATH], path[MAX_PATH];
+         const char *base = exe;
+         DWORD n = GetModuleFileNameA(NULL, exe, sizeof exe);
+         exe[n < sizeof exe ? n : sizeof exe - 1] = 0;
+         for (const char *c = exe; *c; c++)
+            if (*c == '\\' || *c == '/')
+               base = c + 1;
+         snprintf(path, sizeof path, "C:\\mali\\log\\%s-%lu-gl.txt", base,
+                  (unsigned long)GetCurrentProcessId());
+         f = CreateFileA(path, FILE_APPEND_DATA,
+                         FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                         NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+      }
+      if (InterlockedCompareExchangePointer((PVOID volatile *)&log, f, NULL) != NULL &&
+          f != INVALID_HANDLE_VALUE)
+         CloseHandle(f);
+   }
+   if (log != INVALID_HANDLE_VALUE)
+      WriteFile(log, buf, (DWORD)len, &done, NULL);
+}
+
+void
+DebugPrintf(const char *format, ...)
+{
+   char buf[2048];
+   int off, len;
+   va_list ap;
+
+   off = snprintf(buf, sizeof buf, "%10lu %5lu ", (unsigned long)GetTickCount(),
+                  (unsigned long)GetCurrentThreadId());
+   va_start(ap, format);
+   len = vsnprintf(buf + off, sizeof buf - off, format, ap);
+   va_end(ap);
+   if (len < 0)
+      return;
+   if (len > (int)(sizeof buf - off - 1))
+      len = (int)(sizeof buf - off - 1);
+   OutputDebugStringA(buf + off);
+   wgl_pan_log_append(buf, off + len);
+}
