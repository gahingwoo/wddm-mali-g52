+/* Arm Mali through Panfrost (wddm-mali-g52). The libdrm shim in libpankmod
+ * (win32-compat/malikm_drm.c) has no runtime device in an OpenGL process:
+ * it opens the maliwddm adapter itself through the D3DKMT system calls and
+ * makes one device and context for the process. */
+int malikm_open(void);
+void glsl_type_singleton_init_or_ref(void);
+
+/* Panfrost reads its driconf options from the screen config, which the
+ * pipe-loader builds elsewhere; there is none here. */
+static const driOptionDescription wgl_pan_driconf[] = {
+#include "panfrost/driinfo_panfrost.h"
+};
+static driOptionCache wgl_pan_info, wgl_pan_cache;
+static bool use_panfrost = false;
+
+static struct pipe_screen *
+wgl_panfrost_create_screen(void)
+{
+   struct pipe_screen *screen = NULL;
+   int fd = malikm_open();
+
+   if (fd < 0) {
+      /* MALIKM_FAKE: the shim emulates the kernel driver in this process
+       * (CI, where there is no Mali). */
+      const char *fake = getenv("MALIKM_FAKE");
+      if (fake && *fake && *fake != '0')
+         fd = _open("NUL", _O_RDWR);
+   }
+   if (fd < 0) {
+      fprintf(stderr, "wgl: Panfrost found no Mali device\n");
+      return NULL;
+   }
+   struct pipe_screen_config config = {
+      .options = &wgl_pan_cache,
+      .options_info = &wgl_pan_info,
+   };
+   if (!wgl_pan_info.info) {
+      glsl_type_singleton_init_or_ref();
+      driParseOptionInfo(&wgl_pan_info, wgl_pan_driconf, ARRAY_SIZE(wgl_pan_driconf));
+   }
+   screen = panfrost_drm_screen_create(fd, &config);
+   _close(fd); /* the screen keeps its own duplicate */
+   if (!screen)
+      fprintf(stderr, "wgl: Panfrost found no Mali device (no screen on the adapter)\n");
+   return screen;
+}
+
+/* A context of our own, for a present made with no context current. */
+static SRWLOCK wgl_pan_present_lock = SRWLOCK_INIT;
+static struct pipe_context *wgl_pan_present_ctx;
+
+/*
+ * Present for Panfrost: read the colour buffer back and draw it into the
+ * window with GDI, as the software path does with its display target. The
+ * map waits for the GPU to finish the frame and resolves Panfrost's tiled or
+ * AFBC layout into a linear copy. A B8G8R8A8 or B8G8R8X8 buffer is handed
+ * to StretchDIBits as it is mapped; any other format is converted first.
+ * DWM composes the window as any GDI window. One CPU read of the frame per
+ * present.
+ */
+static void
+wgl_panfrost_present(struct pipe_screen *screen, struct pipe_context *pipe,
+                     struct pipe_resource *res, HDC hDC)
+{
+   unsigned w = res->width0, h = res->height0;
+   struct pipe_transfer *xfer = NULL;
+   bool own = false;
+
+   if (!pipe) {
+      AcquireSRWLockExclusive(&wgl_pan_present_lock);
+      if (!wgl_pan_present_ctx)
+         wgl_pan_present_ctx = screen->context_create(screen, NULL, 0);
+      pipe = wgl_pan_present_ctx;
+      own = true;
+      if (!pipe) {
+         ReleaseSRWLockExclusive(&wgl_pan_present_lock);
+         return;
+      }
+   }
+
+   const uint8_t *map = pipe_texture_map(pipe, res, 0, 0, PIPE_MAP_READ, 0, 0, w, h, &xfer);
+   if (map) {
+      const void *bits = map;
+      void *conv = NULL;
+      unsigned pitch = xfer->stride;
+
+      if ((res->format != PIPE_FORMAT_B8G8R8A8_UNORM &&
+           res->format != PIPE_FORMAT_B8G8R8X8_UNORM) || (pitch & 3)) {
+         pitch = w * 4;
+         conv = malloc((size_t)pitch * h);
+         if (conv)
+            util_format_translate(PIPE_FORMAT_B8G8R8A8_UNORM, conv, pitch, 0, 0,
+                                  res->format, map, xfer->stride, 0, 0, w, h);
+         bits = conv;
+      }
+      if (bits) {
+         BITMAPINFO bmi = {0};
+         bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+         bmi.bmiHeader.biWidth = (LONG)(pitch / 4);
+         bmi.bmiHeader.biHeight = -(LONG)h; /* top-down */
+         bmi.bmiHeader.biPlanes = 1;
+         bmi.bmiHeader.biBitCount = 32;
+         bmi.bmiHeader.biCompression = BI_RGB;
+         StretchDIBits(hDC, 0, 0, (int)w, (int)h, 0, 0, (int)w, (int)h, bits, &bmi,
+                       DIB_RGB_COLORS, SRCCOPY);
+      }
+      free(conv);
+      pipe_texture_unmap(pipe, xfer);
+   }
+   if (own)
+      ReleaseSRWLockExclusive(&wgl_pan_present_lock);
+}
