diff --git a/src/panfrost/compiler/bifrost/bifrost_compile.c b/src/panfrost/compiler/bifrost/bifrost_compile.c
index fc3168c..567a045 100644
--- a/src/panfrost/compiler/bifrost/bifrost_compile.c
+++ b/src/panfrost/compiler/bifrost/bifrost_compile.c
@@ -105,10 +105,18 @@ bi_emit_jump(bi_builder *b, nir_jump_instr *instr)
 static uint64_t
 bi_index_to_key(bi_index idx)
 {
-   static_assert(sizeof(idx) <= sizeof(uint64_t), "too much padding");
-
-   uint64_t key = 0;
-   memcpy(&key, &idx, sizeof(idx));
+   /* Built field by field rather than by copying the struct: under the MSVC
+    * ABI each bool bitfield run takes its own storage unit, bi_index grows
+    * past 64 bits and a copy of its first 8 bytes would drop fields. */
+   uint64_t key = idx.value;
+   key |= (uint64_t)idx.abs << 32;
+   key |= (uint64_t)idx.neg << 33;
+   key |= (uint64_t)idx.discard << 34;
+   key |= (uint64_t)(idx.swizzle & 0x1f) << 35;
+   key |= (uint64_t)(idx.offset & 0x7) << 40;
+   key |= (uint64_t)(idx.type & 0x7) << 43;
+   key |= (uint64_t)idx.kill_ssa << 46;
+   key |= (uint64_t)idx.memory << 47;
    return key;
 }
 
