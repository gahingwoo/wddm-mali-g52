+/* Primaries and presents on the hardware runtime; see malikm_drm.c. Without
+ * Panfrost there is no runtime device to ask and these do nothing. */
+#ifdef GALLIUM_PANFROST
+unsigned malikm_primary_create(void *hRTResource, unsigned w, unsigned h, unsigned vidpn_source);
+void malikm_primary_destroy(unsigned handle);
+void malikm_present_target(unsigned src_allocation, unsigned dst_allocation, int set);
+#endif
+
+unsigned
+d3d10_primary_create(void *hRTResource, unsigned w, unsigned h, unsigned vidpn_source)
+{
+#ifdef GALLIUM_PANFROST
+   return malikm_primary_create(hRTResource, w, h, vidpn_source);
+#else
+   (void)hRTResource; (void)w; (void)h; (void)vidpn_source;
+   return 0;
+#endif
+}
+
+void
+d3d10_primary_destroy(unsigned handle)
+{
+#ifdef GALLIUM_PANFROST
+   malikm_primary_destroy(handle);
+#else
+   (void)handle;
+#endif
+}
+
+void
+d3d10_present_target(unsigned src_allocation, unsigned dst_allocation, int set)
+{
+#ifdef GALLIUM_PANFROST
+   malikm_present_target(src_allocation, dst_allocation, set);
+#else
+   (void)src_allocation; (void)dst_allocation; (void)set;
+#endif
+}
