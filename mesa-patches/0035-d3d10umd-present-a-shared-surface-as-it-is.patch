+   /*
+    * A shared surface (LogonUI.exe presents the two it shares with dwm.exe,
+    * with the Blt flag and no destination): the allocation the runtime has
+    * to be told about is the surface's own, which is also what was rendered
+    * into, so there is nothing to read back or copy. Presenting a private
+    * copy instead returned S_OK and told the compositor nothing about the
+    * surface it has open.
+    */
+   if (pSrcResource->shared_allocation) {
