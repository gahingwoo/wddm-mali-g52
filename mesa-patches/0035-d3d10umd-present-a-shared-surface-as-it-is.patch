+         pDstResource ? pDstResource->present_allocation : 0,
+         pPresentData->pDXGIContext);
+      if (hr != S_OK)
+         DebugPrintf("Present: shared, result 0x%08lx\n", (unsigned long)hr);
+      return hr;
+   }
