diff --git a/src/gallium/frontends/d3d10umd/Resource.cpp b/src/gallium/frontends/d3d10umd/Resource.cpp
index 026e17f..67522a2 100644
--- a/src/gallium/frontends/d3d10umd/Resource.cpp
+++ b/src/gallium/frontends/d3d10umd/Resource.cpp
@@ -1297,10 +1297,45 @@ ResourceResolveSubResource(D3D10DDI_HDEVICE hDevice,        // IN
                            UINT SrcSubResource,             // IN
                            DXGI_FORMAT ResolveFormat)       // IN
 {
-   LOG_UNSUPPORTED_ENTRYPOINT();
-   /* Not carried out: counted, so that a caller that relies on it shows
-    * up in m5test perf. */
-   mali_count_add(MALI_COUNT_RESOLVE, 0, 0);
+   LOG_ENTRYPOINT();
+   /* A resolve on the GPU, by a blit from the multisampled resource:
+    * Panfrost averages the samples. Only reached with UmdMsaa 4, which is
+    * the only way the device offers more than one sample. */
+   uint64_t t0 = mali_count_now();
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_context *pipe = pDevice->pipe;
+   struct pipe_resource *dst = CastResource(hDstResource)->resource;
+   struct pipe_resource *src = CastResource(hSrcResource)->resource;
+   unsigned dst_level = DstSubResource % (dst->last_level + 1);
+   unsigned dst_layer = DstSubResource / (dst->last_level + 1);
+   unsigned src_level = SrcSubResource % (src->last_level + 1);
+   unsigned src_layer = SrcSubResource / (src->last_level + 1);
+   enum pipe_format format = FormatTranslate(ResolveFormat, false);
+   struct pipe_blit_info blit;
+
+   memset(&blit, 0, sizeof blit);
+   blit.src.resource = src;
+   blit.src.level = src_level;
+   blit.src.format = format != PIPE_FORMAT_NONE ? format : src->format;
+   blit.src.box.x = 0;
+   blit.src.box.y = 0;
+   blit.src.box.z = src_layer;
+   blit.src.box.width = u_minify(src->width0, src_level);
+   blit.src.box.height = u_minify(src->height0, src_level);
+   blit.src.box.depth = 1;
+   blit.dst.resource = dst;
+   blit.dst.level = dst_level;
+   blit.dst.format = format != PIPE_FORMAT_NONE ? format : dst->format;
+   blit.dst.box.x = 0;
+   blit.dst.box.y = 0;
+   blit.dst.box.z = dst_layer;
+   blit.dst.box.width = u_minify(dst->width0, dst_level);
+   blit.dst.box.height = u_minify(dst->height0, dst_level);
+   blit.dst.box.depth = 1;
+   blit.mask = PIPE_MASK_RGBA;
+   blit.filter = PIPE_TEX_FILTER_NEAREST;
+   pipe->blit(pipe, &blit);
+   mali_count_add(MALI_COUNT_RESOLVE, countBytes(dst, &blit.dst.box), t0);
 }
 
 
