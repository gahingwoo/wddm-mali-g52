+/*
+ * A decoder output for zero copy (Video.cpp): the BO's handle, its rows and
+ * slices, and the BO kept for the texture. Panfrost replaces the BO of a
+ * texture that is mapped for writing while the GPU uses it, and keeps freed
+ * BOs for reuse; the decoder writes into the allocation's pages, so the
+ * shim marks the BO (d3d10_vdec_mark) and exporting it then marks it shared
+ * in Panfrost, which does neither for a shared BO. Anything missing (not
+ * the hardware runtime, not linear) leaves nv12_zc false: the decoder's
+ * pictures are copied in, as before.
+ */
+static void
+Nv12ZeroCopySetup(Device *pDevice, struct pipe_context *pipe, Resource *pResource)
+{
+   struct pipe_screen *screen = pipe->screen;
+   struct winsys_handle whandle;
+   struct pipe_transfer *transfer = NULL;
+   struct pipe_box box;
+   unsigned gem;
+
+   pResource->nv12_zc = false;
+   memset(&whandle, 0, sizeof whandle);
+   whandle.type = WINSYS_HANDLE_TYPE_KMS;
+   if (!screen->resource_get_handle ||
+       !screen->resource_get_handle(screen, pipe, pResource->resource, &whandle, 0) ||
+       whandle.modifier != 0 /* DRM_FORMAT_MOD_LINEAR */) {
+      DebugPrintf("video: NV12 %ux%u x%u: no linear buffer handle (modifier 0x%llx), pictures are copied\n",
+                  pResource->resource->width0, pResource->nv12_luma_height,
+                  pResource->resource->array_size, (unsigned long long)whandle.modifier);
+      return;
+   }
+   gem = (unsigned)(uintptr_t)whandle.handle;
+   /* The slices: a linear map hands out the layer stride without waiting. */
+   u_box_3d(0, 0, 0, 1, 1, 1, &box);
+   if (!pipe->texture_map(pipe, pResource->resource, 0, PIPE_MAP_READ | PIPE_MAP_UNSYNCHRONIZED, &box,
+                          &transfer) || !transfer)
+      return;
+   pResource->nv12_stride = transfer->stride;
+   pResource->nv12_layer_stride = transfer->layer_stride;
+   pipe->texture_unmap(pipe, transfer);
+   pResource->nv12_offset = whandle.offset;
+   if (pResource->nv12_stride != whandle.stride ||
+       (pResource->resource->array_size > 1 && pResource->nv12_layer_stride == 0) ||
+       d3d10_vdec_mark(pDevice->hDevice, gem) != 0 || !MarkResourceShared(pipe, pResource->resource)) {
+      DebugPrintf("video: NV12 %ux%u x%u: buffer %u not kept for the decoder, pictures are copied\n",
+                  pResource->resource->width0, pResource->nv12_luma_height,
+                  pResource->resource->array_size, gem);
+      return;
+   }
+   pResource->nv12_gem = gem;
+   pResource->nv12_rt_device = pDevice->hDevice;
+   pResource->nv12_zc = true;
+   DebugPrintf("video: NV12 %ux%u x%u for the decoder to write: buffer %u, pitch %u, slices %llu bytes apart\n",
+               pResource->resource->width0, pResource->nv12_luma_height, pResource->resource->array_size,
+               gem, pResource->nv12_stride, (unsigned long long)pResource->nv12_layer_stride);
+}
