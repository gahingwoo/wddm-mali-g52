+/* Zero-copy decode (d3d10umd Video.cpp): see malikm_drm.c. Without Panfrost
+ * there is no allocation to export, and the decoder's pictures are copied. */
+int
+d3d10_vdec_mark(void *hRTDevice, unsigned gem)
+{
+#ifdef GALLIUM_PANFROST
+   return malikm_vdec_mark(hRTDevice, gem);
+#else
+   (void)hRTDevice; (void)gem;
+   return -1;
+#endif
+}
+
+int
+d3d10_vdec_export(void *hRTDevice, unsigned gem, unsigned long long *token, unsigned *pages)
+{
+#ifdef GALLIUM_PANFROST
+   return malikm_vdec_export(hRTDevice, gem, token, pages);
+#else
+   (void)hRTDevice; (void)gem; (void)token; (void)pages;
+   return -1;
+#endif
+}
