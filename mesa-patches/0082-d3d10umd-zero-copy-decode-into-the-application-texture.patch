+/* ---------------------------------------------------------- zero copy */
+
+bool
+VideoNv12ZeroCopyWanted(Device *pDevice, UINT BindFlags, UINT Usage, UINT MiscFlags, UINT MapFlags)
+{
+   /* A decoder output nothing but the GPU and the decoder touch: no shader
+    * resource views (their plane textures are copies, VideoProcessor.cpp),
+    * no CPU access, not shared with another process. */
+   return pDevice->video >= 2 && g_video_zero_copy && vdec_zero_copy_possible() &&
+          !(BindFlags & D3D10_DDI_BIND_SHADER_RESOURCE) && Usage == D3D10_DDI_USAGE_DEFAULT &&
+          !(MiscFlags & D3D10_DDI_RESOURCE_MISC_SHARED) && MapFlags == 0;
+}
+
+void
+VideoNv12ZeroCopyForget(Resource *r)
+{
+   if (r->vdec_token)
+      vdec_forget(r->vdec_token);
+   r->vdec_token = 0;
+   r->nv12_zc = false;
+}
+
+/* After maliwddm took the pages back (eviction): the allocation's export
+ * again, for vdec to refresh its import (vdec_refresh_fn). */
+static uint64_t
+ZeroCopyRefresh(void *ctx, unsigned *pages)
+{
+   Resource *r = (Resource *)ctx;
+   unsigned long long token = 0;
+   unsigned n = 0;
+
+   if (!r->nv12_zc || d3d10_vdec_export(r->nv12_rt_device, r->nv12_gem, &token, &n) != 0 || !token)
+      return 0;
+   r->vdec_token = token;
+   r->vdec_pages = n;
+   *pages = n;
+   return token;
+}
+
+/* The output view as the decoder's target, when its texture was made for
+ * it; the export is asked for at the first decode into the texture, and
+ * again every 64 frames while maliwddm refuses it (not resident yet). */
+static bool
+ZeroCopyTarget(VideoOutputView *v, vdec_target *t)
+{
+   Resource *r = v->resource;
+
+   if (!r || !r->nv12_zc)
+      return false;
+   if (!r->vdec_token) {
+      unsigned long long token = 0;
+      unsigned pages = 0;
+
+      if (r->vdec_export_tries++ % 64)
+         return false;
+      if (d3d10_vdec_export(r->nv12_rt_device, r->nv12_gem, &token, &pages) != 0 || !token) {
+         if (r->vdec_export_tries <= 1)
+            DebugPrintf("video: maliwddm did not export buffer %u (UmdVideoZeroCopy 0, an older "
+                        "maliwddm, or not resident): pictures are copied into it\n", r->nv12_gem);
+         return false;
+      }
+      r->vdec_token = token;
+      r->vdec_pages = pages;
+   }
+   memset(t, 0, sizeof *t);
+   t->token = r->vdec_token;
+   t->pages = r->vdec_pages;
+   t->offset = r->nv12_offset + (uint64_t)v->slice * r->nv12_layer_stride;
+   t->stride = r->nv12_stride;
+   t->luma_rows = r->nv12_luma_height;
+   t->refresh = ZeroCopyRefresh;
+   t->refresh_ctx = r;
+   return true;
+}
+
+/* The GPU is done with the texture before the decoder writes it: a map for
+ * writing waits for every batch that reads or writes it (a linear texture
+ * maps in place, and its buffer, shared, is never swapped for another). */
+static void
+ZeroCopyWaitGpu(struct pipe_context *pipe, VideoOutputView *v)
+{
+   struct pipe_transfer *transfer = NULL;
+   struct pipe_box box;
+
+   u_box_3d(0, 0, v->slice, 1, 1, 1, &box);
+   if (pipe->texture_map(pipe, v->resource->resource, 0, PIPE_MAP_WRITE, &box, &transfer) && transfer)
+      pipe->texture_unmap(pipe, transfer);
+}
