+
+#ifdef _WIN32
+#include <windows.h>
+#include "util/u_surface.h"
+
+/* A copy between two textures, on the GPU.
+ *
+ * Panfrost's resource_copy_region is util_resource_copy_region: it maps
+ * both resources and copies on the CPU, and a map waits for the GPU. Under
+ * the Direct3D frontend dwm.exe copies between surfaces all the time
+ * (CopySubresourceRegion), and at 2560x1440 the log of slow operations on
+ * the TaishanPi 3M had these at 22 to 26 ms each, the largest thing left
+ * over 20 ms once the waits were fixed.
+ *
+ * The blitter copies through views in the linear format of each resource,
+ * so nothing is converted. What it cannot do (buffers, multisampled or
+ * compressed resources, a copy within one level of one resource) stays on
+ * the CPU. The file C:\mali\copy-cpu puts everything back there.
+ */
+static bool
+pan_copy_on_gpu(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = GetFileAttributesA("C:\\mali\\copy-cpu") == INVALID_FILE_ATTRIBUTES;
+   return on;
+}
+
+void
+panfrost_resource_copy_region(struct pipe_context *pipe,
+                              struct pipe_resource *dst, unsigned dst_level,
+                              unsigned dstx, unsigned dsty, unsigned dstz,
+                              struct pipe_resource *src, unsigned src_level,
+                              const struct pipe_box *src_box)
+{
+   struct panfrost_context *ctx = pan_context(pipe);
+
+   if (!pan_copy_on_gpu() || dst->target == PIPE_BUFFER ||
+       src->target == PIPE_BUFFER || dst->nr_samples > 1 ||
+       src->nr_samples > 1 || (dst == src && dst_level == src_level) ||
+       util_format_is_compressed(dst->format) ||
+       util_format_is_compressed(src->format) ||
+       !util_blitter_is_copy_supported(ctx->blitter, dst, src)) {
+      util_resource_copy_region(pipe, dst, dst_level, dstx, dsty, dstz, src,
+                                src_level, src_box);
+      return;
+   }
+
+   pan_legalize_format(ctx, pan_resource(src), util_format_linear(src->format),
+                       false, false);
+   pan_legalize_format(ctx, pan_resource(dst), util_format_linear(dst->format),
+                       true, false);
+
+   panfrost_flush_all_batches(ctx, "Copy");
+   panfrost_blitter_save(ctx, PAN_RENDER_BLIT);
+   util_blitter_copy_texture(ctx->blitter, dst, dst_level, dstx, dsty, dstz,
+                             src, src_level, src_box);
+   panfrost_flush_all_batches(ctx, "Copy");
+}
+#endif
+
