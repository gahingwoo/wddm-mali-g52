diff --git a/src/util/mali_slow.h b/src/util/mali_slow.h
new file mode 100644
index 0000000..e60b46b
--- /dev/null
+++ b/src/util/mali_slow.h
@@ -0,0 +1,73 @@
+/*
+ * The slow-operation log of the Windows Mali UMD (maliumd.dll).
+ *
+ * An operation that may take long (a shader compile, a buffer allocation, a
+ * submission, a wait, a map, a present) is timed with one pair of
+ * performance-counter reads. Only when it took longer than the threshold is
+ * a line formatted and written, to C:\mali\slow\<exe>-<pid>.txt, a file of
+ * its own, apart from the entry-point log in C:\mali\log. Nothing is timed
+ * and nothing is written while the directory C:\mali\slow does not exist.
+ * The threshold is 20 ms, or the number of milliseconds in C:\mali\slow-ms.
+ *
+ *    uint64_t t0 = mali_slow_now();
+ *    ... the operation ...
+ *    MALI_SLOW(t0, "bo-create", "%llu bytes", size);
+ *
+ * The arguments after the name are evaluated only when the operation was
+ * slow. The implementation is in the d3d10umd frontend (Debug.cpp); off
+ * Windows everything here is empty.
+ */
+#ifndef MALI_SLOW_H
+#define MALI_SLOW_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef _WIN32
+
+/* Now, in performance-counter ticks; 0 while the log is off. */
+uint64_t mali_slow_now(void);
+
+/* The ticks since T0 when that is over the threshold, else 0. */
+uint64_t mali_slow_over(uint64_t t0);
+
+/* One line: Op took Ticks, and the detail. */
+void mali_slow_log(uint64_t ticks, const char *op, const char *fmt, ...);
+
+#define MALI_SLOW(t0, op, ...)                                    \
+   do {                                                           \
+      uint64_t mali_slow_ticks_ = mali_slow_over(t0);             \
+      if (mali_slow_ticks_)                                       \
+         mali_slow_log(mali_slow_ticks_, (op), __VA_ARGS__);      \
+   } while (0)
+
+#else
+
+static inline uint64_t mali_slow_now(void) { return 0; }
+#define MALI_SLOW(t0, op, ...) do { (void)(t0); } while (0)
+
+#endif
+
+#ifdef __cplusplus
+}
+
+#ifdef _WIN32
+/* For a function with several returns: the line is written when the scope
+ * ends. Fmt and up to three numbers may be set at any point before. */
+struct MaliSlowScope {
+   const char *op;
+   uint64_t t0;
+   const char *fmt;
+   unsigned long long a, b, c;
+
+   explicit MaliSlowScope(const char *name)
+      : op(name), t0(mali_slow_now()), fmt(""), a(0), b(0), c(0) {}
+   ~MaliSlowScope() { MALI_SLOW(t0, op, fmt, a, b, c); }
+};
+#endif
+#endif
+
+#endif /* MALI_SLOW_H */
