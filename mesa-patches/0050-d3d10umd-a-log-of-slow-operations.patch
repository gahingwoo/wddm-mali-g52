+/*
+ * The slow-operation log (util/mali_slow.h): one line for each operation
+ * that took longer than a threshold, in C:\mali\slow\<exe>-<pid>.txt.
+ *
+ * It is a file of its own so that it does not depend on the entry-point
+ * log: that one stops after DEBUG_TRACE_MAX lines and is usually off. The
+ * directory and the threshold are looked at again every SLOW_RECHECK_MS,
+ * so the log can be turned on and off under a running dwm.exe: create or
+ * remove C:\mali\slow, or put a file named "off" in it. A process in an
+ * AppContainer cannot create the file unless the directory's ACL lets it;
+ * it then logs nothing and says nothing.
+ *
+ * When nothing is slow the cost is a GetTickCount64 and a
+ * QueryPerformanceCounter at the start of an operation and one more
+ * QueryPerformanceCounter at its end.
+ */
+#define SLOW_DEFAULT_MS 20
+#define SLOW_RECHECK_MS 10000
+
+static volatile LONG64 slow_limit = -1;       /* ticks; -1 unread, 0 off */
+static volatile LONG64 slow_checked;          /* GetTickCount64 of the last look */
+static volatile LONG slow_checking;
+static LONG64 slow_hz;
+static HANDLE slow_file = INVALID_HANDLE_VALUE;
+static volatile LONG slow_open_tries;
+
+static unsigned
+SlowReadMs(void)
+{
+   HANDLE f = CreateFileA("C:\\mali\\slow-ms", GENERIC_READ,
+                          FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                          NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+   char buf[32];
+   DWORD got = 0;
+   unsigned ms = 0;
+
+   if (f == INVALID_HANDLE_VALUE)
+      return SLOW_DEFAULT_MS;
+   if (!ReadFile(f, buf, sizeof buf - 1, &got, NULL))
+      got = 0;
+   CloseHandle(f);
+   buf[got] = 0;
+   for (const char *c = buf; *c >= '0' && *c <= '9' && ms < 100000; c++)
+      ms = ms * 10 + (unsigned)(*c - '0');
+   return ms ? ms : SLOW_DEFAULT_MS;
+}
+
+static void
+SlowCheck(ULONGLONG now_ms)
+{
+   if (InterlockedCompareExchange(&slow_checking, 1, 0) != 0)
+      return;
+   if (!slow_hz) {
+      LARGE_INTEGER hz;
+      QueryPerformanceFrequency(&hz);
+      slow_hz = hz.QuadPart;
+   }
+   LONG64 limit = 0;
+   if (GetFileAttributesA("C:\\mali\\slow") != INVALID_FILE_ATTRIBUTES &&
+       GetFileAttributesA("C:\\mali\\slow\\off") == INVALID_FILE_ATTRIBUTES)
+      limit = (LONG64)SlowReadMs() * slow_hz / 1000;
+   InterlockedExchange64(&slow_limit, limit);
+   InterlockedExchange64(&slow_checked, (LONG64)now_ms);
+   InterlockedExchange(&slow_checking, 0);
+}
+
+extern "C" uint64_t
+mali_slow_now(void)
+{
+   ULONGLONG ms = GetTickCount64();
+   LARGE_INTEGER t;
+
+   if (slow_limit < 0 || ms - (ULONGLONG)slow_checked >= SLOW_RECHECK_MS)
+      SlowCheck(ms);
+   if (slow_limit <= 0)
+      return 0;
+   QueryPerformanceCounter(&t);
+   return (uint64_t)t.QuadPart;
+}
+
+extern "C" uint64_t
+mali_slow_over(uint64_t t0)
+{
+   LARGE_INTEGER t;
+   LONG64 limit = slow_limit;
+
+   if (!t0 || limit <= 0)
+      return 0;
+   QueryPerformanceCounter(&t);
+   uint64_t d = (uint64_t)t.QuadPart - t0;
+   return d >= (uint64_t)limit ? d : 0;
+}
+
+static HANDLE
+SlowFile(void)
+{
+   static volatile LONG opening = 0;
+
+   if (slow_file != INVALID_HANDLE_VALUE)
+      return slow_file;
+   /* A few tries, not one: the first slow operation may be on a thread
+    * that cannot create files (see DebugLogFile). */
+   if (slow_open_tries > 20 || InterlockedCompareExchange(&opening, 1, 0) != 0)
+      return INVALID_HANDLE_VALUE;
+   InterlockedIncrement(&slow_open_tries);
+
+   char exe[MAX_PATH], path[MAX_PATH];
+   const char *base = exe;
+   DWORD n = GetModuleFileNameA(NULL, exe, sizeof exe);
+   exe[n < sizeof exe ? n : sizeof exe - 1] = 0;
+   for (const char *c = exe; *c; c++)
+      if (*c == '\\' || *c == '/')
+         base = c + 1;
+   snprintf(path, sizeof path, "C:\\mali\\slow\\%s-%lu.txt", base,
+            (unsigned long)GetCurrentProcessId());
+   HANDLE f = CreateFileA(path, FILE_APPEND_DATA,
+                          FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                          NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+   if (f != INVALID_HANDLE_VALUE) {
+      char head[160];
+      DWORD done;
+      int len = snprintf(head, sizeof head,
+                         "%10lu %5lu slow-log on: over %lld us, counter %lld Hz\n",
+                         (unsigned long)GetTickCount(), (unsigned long)GetCurrentThreadId(),
+                         (long long)(slow_limit * 1000000 / (slow_hz ? slow_hz : 1)),
+                         (long long)slow_hz);
+      if (len > 0)
+         WriteFile(f, head, (DWORD)len, &done, NULL);
+      slow_file = f;
+   }
+   InterlockedExchange(&opening, 0);
+   return slow_file;
+}
+
+extern "C" void
+mali_slow_log(uint64_t ticks, const char *op, const char *fmt, ...)
+{
+   char buf[512];
+   HANDLE file = SlowFile();
+   unsigned long long us = slow_hz ? ticks * 1000000ull / (uint64_t)slow_hz : 0;
+   DWORD done;
+   int off, len;
+
+   if (file == INVALID_HANDLE_VALUE)
+      return;
+   /* tick-count ms, thread, operation, milliseconds with three decimals */
+   off = snprintf(buf, sizeof buf, "%10lu %5lu %-16s %6llu.%03llu ms ",
+                  (unsigned long)GetTickCount(), (unsigned long)GetCurrentThreadId(),
+                  op, us / 1000, us % 1000);
+   if (off < 0 || off >= (int)sizeof buf - 2)
+      return;
+   va_list ap;
+   va_start(ap, fmt);
+   len = vsnprintf(buf + off, sizeof buf - off - 1, fmt, ap);
+   va_end(ap);
+   if (len < 0)
+      len = 0;
+   if (len > (int)sizeof buf - off - 2)
+      len = (int)sizeof buf - off - 2;
+   buf[off + len] = '\n';
+   WriteFile(file, buf, (DWORD)(off + len + 1), &done, NULL);
+}
+
