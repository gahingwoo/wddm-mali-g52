+/* The slow-operation log's detail for an entry point on a resource: its
+ * size, and a third number of the caller's. */
+static void
+SlowResource(MaliSlowScope &slow, D3D10DDI_HRESOURCE hResource, const char *fmt,
+             unsigned long long c)
+{
+   Resource *pResource = CastResource(hResource);
+
+   slow.fmt = fmt;
+   if (pResource && pResource->resource) {
+      slow.a = pResource->resource->width0;
+      slow.b = pResource->resource->height0;
+   }
+   slow.c = c;
+}
