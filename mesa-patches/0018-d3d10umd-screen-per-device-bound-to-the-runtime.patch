+/* Called by CreateDevice before the device's screen is created. Panfrost on
+ * a hardware runtime (maliwddm's adapter) reaches the kernel driver through
+ * this device's callbacks from now on; anything else is unaffected. */
+#ifdef GALLIUM_PANFROST
+int malikm_bind_d3dddi(HANDLE hRTAdapter, HANDLE hRTDevice, const void *pKTCallbacks,
+                       const void *pDXGIBaseCallbacks);
+#endif
+
+bool
+d3d10_bind_runtime(HANDLE hRTAdapter, HANDLE hRTDevice, const void *pKTCallbacks,
+                   const void *pDXGIBaseCallbacks)
+{
+#ifdef GALLIUM_PANFROST
+   return malikm_bind_d3dddi(hRTAdapter, hRTDevice, pKTCallbacks, pDXGIBaseCallbacks) == 0;
+#else
+   (void)hRTAdapter; (void)hRTDevice; (void)pKTCallbacks; (void)pDXGIBaseCallbacks;
+   return false;
+#endif
+}
