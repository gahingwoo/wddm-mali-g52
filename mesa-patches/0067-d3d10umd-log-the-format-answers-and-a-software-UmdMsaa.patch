--- a/src/gallium/frontends/d3d10umd/Adapter.cpp
+++ b/src/gallium/frontends/d3d10umd/Adapter.cpp
@@ -37,6 +37,7 @@
 
 #include "Debug.h"
 
+#include "util/u_debug.h"
 #include "util/u_memory.h"
 
 #include <stddef.h>
@@ -89,6 +90,7 @@ QueryUmdDdi(const D3D10DDIARG_OPENADAPTER *pOpenData, unsigned *pMsaa = NULL)
    MaliUmdInfo info = {};
    D3DDDICB_QUERYADAPTERINFO q = {};
    unsigned ddi = 100;
+   bool kmd = false;
 
    if (pMsaa)
       *pMsaa = 0;
@@ -97,8 +99,10 @@ QueryUmdDdi(const D3D10DDIARG_OPENADAPTER *pOpenData, unsigned *pMsaa = NULL)
       q.pPrivateDriverData = &info;
       q.PrivateDriverDataSize = sizeof info;
       HRESULT hr = pOpenData->pAdapterCallbacks->pfnQueryAdapterInfoCb(pOpenData->hRTAdapter.handle, &q);
-      if (SUCCEEDED(hr) && info.Magic == MALI_UMD_INFO_MAGIC && info.Size >= 3 * sizeof(UINT))
+      if (SUCCEEDED(hr) && info.Magic == MALI_UMD_INFO_MAGIC && info.Size >= 3 * sizeof(UINT)) {
+         kmd = true;
          ddi = info.Ddi >= 101 ? 101 : 100;
+      }
       if (pMsaa && SUCCEEDED(hr) && info.Magic == MALI_UMD_INFO_MAGIC &&
           info.Size >= offsetof(MaliUmdInfo, Msaa) + sizeof(UINT))
          *pMsaa = EffectiveMsaa(info.Msaa);
@@ -106,6 +110,20 @@ QueryUmdDdi(const D3D10DDIARG_OPENADAPTER *pOpenData, unsigned *pMsaa = NULL)
                   " (here %u): offering D3D10.%u\n", (unsigned long)hr, info.Magic, info.Ddi,
                   info.Msaa, pMsaa ? *pMsaa : 0, ddi == 101 ? 1 : 0);
    }
+
+   /*
+    * No maliwddm behind this adapter: the software driver the D3D runtime
+    * loads by path (D3D_DRIVER_TYPE_SOFTWARE), on a CI runner with
+    * MALIKM_FAKE. There D3D10UMD_UMDDDI and D3D10UMD_UMDMSAA stand in for
+    * the Device Parameters values, so the runtime's checks of these answers
+    * can be run without a board. Never read when the KMD answered.
+    */
+   if (!kmd) {
+      if (debug_get_num_option("D3D10UMD_UMDDDI", 100) >= 101)
+         ddi = 101;
+      if (pMsaa)
+         *pMsaa = EffectiveMsaa((unsigned)debug_get_num_option("D3D10UMD_UMDMSAA", 0));
+   }
    return ddi;
 }
 
