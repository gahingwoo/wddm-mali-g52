    /* D3D10UMD_NO_GS=1 takes the path Panfrost takes on a screen that has
@@ -519,16 +523,56 @@ MsaaFormat(const Device *pDevice, enum pipe_format format)
                                                PIPE_BIND_RENDER_TARGET);
 }
 
+/*
+ * Every answer the runtime got from CheckFormatSupport and
+ * CheckMultisampleQualityLevels, the first CAPS_LOG_MAX of each device, in
+ * the UMD log (C:\mali\log). The D3D11 runtime asks for them while it
+ * creates the device and may refuse the device for what it was told
+ * (DXGI_ERROR_DRIVER_INTERNAL_ERROR); then no application can ask again,
+ * and this is the only record of the answers.
+ */
+#define CAPS_LOG_MAX 1024
+
+static void
+LogCaps(Device *pDevice, const char *fmt, ...)
+{
+   char line[160];
+   va_list ap;
+
+   if (pDevice->caps_logged >= CAPS_LOG_MAX)
+      return;
+   if (++pDevice->caps_logged == CAPS_LOG_MAX) {
+      DebugPrintf("caps: %u answers logged, no more for this device\n", CAPS_LOG_MAX);
+      return;
+   }
+   va_start(ap, fmt);
+   vsnprintf(line, sizeof line, fmt, ap);
+   va_end(ap);
+   DebugPrintf("%s", line);
+}
+
+static void CheckFormatSupportImpl(Device *pDevice, DXGI_FORMAT Format, UINT *pFormatCaps);
+
 void APIENTRY
 CheckFormatSupport(D3D10DDI_HDEVICE hDevice, // IN
                    DXGI_FORMAT Format,       // IN
                    __out UINT *pFormatCaps)  // OUT
+{
+   Device *pDevice = CastDevice(hDevice);
+
+   CheckFormatSupportImpl(pDevice, Format, pFormatCaps);
+   LogCaps(pDevice, "caps: CheckFormatSupport %u -> 0x%08x (msaa %u)\n", (unsigned)Format,
+           *pFormatCaps, pDevice->msaa);
+}
+
+static void
+CheckFormatSupportImpl(Device *pDevice,         // IN
+                       DXGI_FORMAT Format,      // IN
+                       UINT *pFormatCaps)       // OUT
 {
    //LOG_ENTRYPOINT();
 
-   Device *pDevice = CastDevice(hDevice);
-   struct pipe_context *pipe = CastPipeContext(hDevice);
-   struct pipe_screen *screen = pipe->screen;
+   struct pipe_screen *screen = pDevice->screen;
 
    *pFormatCaps = 0;
 
@@ -620,10 +664,10 @@ CheckMultisampleQualityLevels(D3D10DDI_HDEVICE hDevice,        // IN
 
    *pNumQualityLevels = 0;
    (void)screen;
-   if (!MsaaFormat(pDevice, format))
-      return;
-   if (SampleCount == 1 || SampleCount == 4)
+   if (MsaaFormat(pDevice, format) && (SampleCount == 1 || SampleCount == 4))
       *pNumQualityLevels = 1;
+   LogCaps(pDevice, "caps: CheckMultisampleQualityLevels %u x%u -> %u\n", (unsigned)Format,
+           SampleCount, *pNumQualityLevels);
 }
 
 
