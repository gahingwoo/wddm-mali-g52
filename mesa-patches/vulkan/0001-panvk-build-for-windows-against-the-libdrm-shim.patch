+    dependencies : [idep_vulkan_util_headers, idep_vulkan_runtime_headers, idep_mesautil],
+    c_args : [no_override_init_args, '-DHAVE_LIBDRM'],
+    gnu_symbol_visibility : 'hidden',
+  )
+  panvk_link_whole += libpanvk_win32_sync
+  libpanvk_files += files('panvk_win32.c')
+endif
+
 libvulkan_panfrost = shared_library(
   'vulkan_panfrost',
   [libpanvk_files, panvk_entrypoints, panvk_tracepoints, panvk_drirc],
@@ -210,7 +229,8 @@ libvulkan_panfrost = shared_library(
