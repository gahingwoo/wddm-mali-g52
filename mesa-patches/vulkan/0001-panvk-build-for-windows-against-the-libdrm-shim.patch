+panvk_link_whole = []
+if host_machine.system() == 'windows'
+  libpanvk_win32_sync = static_library(
+    'panvk_win32_sync',
+    files('../../vulkan/runtime/vk_drm_syncobj.c', '../../util/u_sync_provider.c'),
