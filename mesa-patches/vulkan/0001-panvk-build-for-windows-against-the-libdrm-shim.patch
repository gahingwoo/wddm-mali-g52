diff --git a/src/panfrost/vulkan/panvk_win32.c b/src/panfrost/vulkan/panvk_win32.c
new file mode 100644
index 0000000..737d140
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_win32.c
@@ -0,0 +1,85 @@
+/*
+ * Copyright 2026 wddm-mali-g52
+ * SPDX-License-Identifier: MIT
+ *
+ * What the libdrm shim (win32-compat/malikm_drm.c in wddm-mali-g52) calls
+ * that the Direct3D UMD and the OpenGL ICD define in their own frontends:
+ * the log, and the slow-operation log, which is off here.
+ *
+ * The log goes to OutputDebugString and, when the directory C:\mali\log
+ * exists, to C:\mali\log\<program>-<pid>-vk.txt, as the other two drivers do.
+ */
+
+#include <windows.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+
+static void
+panvk_win32_log_append(const char *buf, int len)
+{
+   static HANDLE log = NULL;
+   DWORD done;
+
+   if (log == NULL) {
+      HANDLE f = INVALID_HANDLE_VALUE;
+      if (GetFileAttributesA("C:\\mali\\log") != INVALID_FILE_ATTRIBUTES) {
+         char exe[MAX_PATH], path[MAX_PATH];
+         const char *base = exe;
+         DWORD n = GetModuleFileNameA(NULL, exe, sizeof exe);
+         exe[n < sizeof exe ? n : sizeof exe - 1] = 0;
+         for (const char *c = exe; *c; c++)
+            if (*c == '\\' || *c == '/')
+               base = c + 1;
+         snprintf(path, sizeof path, "C:\\mali\\log\\%s-%lu-vk.txt", base,
+                  (unsigned long)GetCurrentProcessId());
+         f = CreateFileA(path, FILE_APPEND_DATA,
+                         FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                         NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+      }
+      if (InterlockedCompareExchangePointer((PVOID volatile *)&log, f, NULL) != NULL &&
+          f != INVALID_HANDLE_VALUE)
+         CloseHandle(f);
+   }
+   if (log != INVALID_HANDLE_VALUE)
+      WriteFile(log, buf, (DWORD)len, &done, NULL);
+}
+
+void
+DebugPrintf(const char *format, ...)
+{
+   char buf[2048];
+   int off, len;
+   va_list ap;
+
+   off = snprintf(buf, sizeof buf, "%10lu %5lu ", (unsigned long)GetTickCount(),
+                  (unsigned long)GetCurrentThreadId());
+   va_start(ap, format);
+   len = vsnprintf(buf + off, sizeof buf - off, format, ap);
+   va_end(ap);
+   if (len < 0)
+      return;
+   if (len > (int)(sizeof buf - off - 1))
+      len = (int)(sizeof buf - off - 1);
+   OutputDebugStringA(buf + off);
+   panvk_win32_log_append(buf, off + len);
+}
+
+uint64_t
+mali_slow_now(void)
+{
+   return 0;
+}
+
+uint64_t
+mali_slow_over(uint64_t t0)
+{
+   (void)t0;
+   return 0;
+}
+
+void
+mali_slow_log(uint64_t ticks, const char *op, const char *fmt, ...)
+{
+   (void)ticks; (void)op; (void)fmt;
+}
