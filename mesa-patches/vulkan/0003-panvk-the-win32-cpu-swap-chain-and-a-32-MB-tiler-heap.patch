diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index 5e54c68..2b39f2e 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -491,8 +491,16 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
 #endif
 
 #if PAN_ARCH <= 9
+   /* Windows (maliwddm): no grow-on-fault, the heap is allocated whole, and
+    * the KMD's one aperture segment is 1 GB for the whole machine. 32 MB is
+    * what the Direct3D and OpenGL drivers use (mesa-patches/0053). */
+#ifdef _WIN32
+   const size_t tiler_heap_size = 32 * 1024 * 1024;
+#else
+   const size_t tiler_heap_size = 128 * 1024 * 1024;
+#endif
    result = panvk_priv_bo_create(
-      device, 128 * 1024 * 1024,
+      device, tiler_heap_size,
       PAN_KMOD_BO_FLAG_NO_MMAP | PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT,
       VK_SYSTEM_ALLOCATION_SCOPE_DEVICE, &device->tiler_heap);
    if (result != VK_SUCCESS)
diff --git a/src/panfrost/vulkan/panvk_wsi.c b/src/panfrost/vulkan/panvk_wsi.c
index 1b4acc0..43ea034 100644
--- a/src/panfrost/vulkan/panvk_wsi.c
+++ b/src/panfrost/vulkan/panvk_wsi.c
@@ -28,6 +28,9 @@ panvk_wsi_proc_addr(VkPhysicalDevice physicalDevice, const char *pName)
 static bool
 panvk_can_present_on_device(VkPhysicalDevice pdevice, int fd)
 {
+#ifdef _WIN32
+   return true;
+#endif
    drmDevicePtr device;
    if (drmGetDevice2(fd, 0, &device) != 0)
       return false;
@@ -47,11 +50,22 @@ panvk_wsi_init(struct panvk_physical_device *physical_device)
       to_panvk_instance(physical_device->vk.instance);
    VkResult result;
 
+   /* Windows: no D3D12 queue, so the Win32 WSI takes its CPU swap chain:
+    * each image is copied by the GPU into a host-visible buffer, which is
+    * blitted to the window with GDI. sw_device makes the present wait for
+    * that copy's fence before reading the buffer, keeps the WSI from asking
+    * for dma-buf exports, and skips creating a DXGI factory and a
+    * DirectComposition device that would go unused. */
+#ifdef _WIN32
+   const bool sw_device = true;
+#else
+   const bool sw_device = false;
+#endif
    result = wsi_device_init(&physical_device->wsi_device,
                             panvk_physical_device_to_handle(physical_device),
                             panvk_wsi_proc_addr, &instance->vk.alloc, -1,
                             &instance->drirc.options,
-                            &(struct wsi_device_options){.sw_device = false});
+                            &(struct wsi_device_options){.sw_device = sw_device});
    if (result != VK_SUCCESS)
       return result;
 
