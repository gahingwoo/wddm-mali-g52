+/* The parameters of the first draws of a process, to the file log: which
+ * draw a missing primitive was, without a debugger. */
+static void
+LogDraw(Device *pDevice, const char *what, unsigned count, unsigned instances,
+        unsigned start, int base_vertex, unsigned start_instance)
+{
+   static volatile LONG draws = 0;
+
+   if (InterlockedIncrement(&draws) > 400)
+      return;
+   DebugPrintf("  %s: primitive %u, count %u, instances %u, start %u, base vertex %d,"
+               " start instance %u\n", what, (unsigned)pDevice->primitive, count, instances,
+               start, base_vertex, start_instance);
+}
+
