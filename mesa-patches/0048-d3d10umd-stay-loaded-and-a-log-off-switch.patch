diff --git a/src/gallium/frontends/d3d10umd/Debug.cpp b/src/gallium/frontends/d3d10umd/Debug.cpp
index e9e2ee5..9d83427 100644
--- a/src/gallium/frontends/d3d10umd/Debug.cpp
+++ b/src/gallium/frontends/d3d10umd/Debug.cpp
@@ -118,7 +118,11 @@ DebugLogFile(void)
    if (InterlockedCompareExchange(&state, 1, 0) != 0)
       return INVALID_HANDLE_VALUE;
 
-   if (GetFileAttributesA("C:\\mali\\log") != INVALID_FILE_ATTRIBUTES) {
+   /* The log directory cannot be renamed while any process has a log open
+    * in it, and every process that draws does. A file named "off" in it
+    * stops new processes from logging. */
+   if (GetFileAttributesA("C:\\mali\\log") != INVALID_FILE_ATTRIBUTES &&
+       GetFileAttributesA("C:\\mali\\log\\off") == INVALID_FILE_ATTRIBUTES) {
       char exe[MAX_PATH], path[MAX_PATH];
       const char *base = exe;
       DWORD n = GetModuleFileNameA(NULL, exe, sizeof exe);
@@ -132,8 +136,19 @@ DebugLogFile(void)
                          FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                          NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    }
-   if (InterlockedIncrement(&tries) == 1)
+   if (InterlockedIncrement(&tries) == 1) {
+      /* This DLL stays for the life of the process. consent.exe (the
+       * elevation prompt) and LogonUI.exe create a device, destroy it and
+       * unload the driver; the exception handler below, and whatever else
+       * Mesa has registered with the process by then, was left pointing
+       * into the unloaded image, and the next exception ended the process
+       * ("maliumd.dll_unloaded" in the Application log). Nothing that needs
+       * elevation could be started. */
+      HMODULE self;
+      GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                         (LPCWSTR)(void *)&DebugCrashHandler, &self);
       AddVectoredExceptionHandler(1, DebugCrashHandler);
+   }
    /* explorer.exe had this DLL loaded and no log: the first call there may
     * come on a thread that cannot create the file. Try again on later calls
     * instead of giving up for the life of the process. */
