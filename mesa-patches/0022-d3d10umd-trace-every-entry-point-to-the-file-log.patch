 #endif
 
 
-#if 0 && !defined(NDEBUG)
-#define LOG_ENTRYPOINT() DebugPrintf("%s\n", __func__)
-#else
-#define LOG_ENTRYPOINT() (void)0
-#endif
+/* Every entry point, to the file log only and only while it is on; see
+ * DebugTraceEntry. */
+void
+DebugTraceEntry(const char *function);
+
+#define LOG_ENTRYPOINT() DebugTraceEntry(__func__)
 
 #define LOG_UNSUPPORTED_ENTRYPOINT() DebugPrintf("%s XXX\n", __func__)
 
