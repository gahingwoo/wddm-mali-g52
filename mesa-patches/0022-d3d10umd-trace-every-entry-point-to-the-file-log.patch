@@ -86,6 +86,34 @@ DebugPrintf(const char *format, ...)
 }
 
 
+/*
+ * The entry-point trace. A compositor calls these thousands of times a
+ * second, so it stops after the first DEBUG_TRACE_MAX lines of a process:
+ * what matters is which calls a process makes on its way to its first
+ * frames, and where that stops.
+ */
+#define DEBUG_TRACE_MAX 40000
+
+void
+DebugTraceEntry(const char *function)
+{
+   static volatile LONG lines = 0;
+   HANDLE file = DebugLogFile();
+   char buf[160];
+   int len;
+   DWORD done;
+
+   if (file == INVALID_HANDLE_VALUE)
+      return;
+   if (InterlockedIncrement(&lines) > DEBUG_TRACE_MAX)
+      return;
+   len = snprintf(buf, sizeof buf, "%10lu %5lu . %s\n", (unsigned long)GetTickCount(),
+                  (unsigned long)GetCurrentThreadId(), function);
+   if (len > 0)
+      WriteFile(file, buf, (DWORD)(len < (int)sizeof buf ? len : (int)sizeof buf - 1), &done, NULL);
+}
+
+
 /**
