       pSrcResource->resource, 0, 0, pPresentData->pDXGIContext, 0, NULL);
    d3d10_present_target(0, 0, 0);
 
+   /* What the runtime made of it. DXGI acts on this (a changed present mode,
+    * an occluded window); returning S_OK regardless hid every failure. */
+   if (pSrcResource->present_allocation) {
+      HRESULT hr = (HRESULT)d3d10_present_result();
+      if (hr != S_OK)
+         DebugPrintf("Present: result 0x%08lx\n", (unsigned long)hr);
+      return hr;
+   }
+
    return S_OK;
 }
 
@@ -124,7 +133,20 @@ _GetGammaCaps( DXGI_DDI_ARG_GET_GAMMA_CONTROL_CAPS *GetCaps )
 HRESULT APIENTRY
 _SetDisplayMode( DXGI_DDI_ARG_SETDISPLAYMODE *SetDisplayMode )
 {
-   LOG_UNSUPPORTED_ENTRYPOINT();
+   LOG_ENTRYPOINT();
+
+   /*
+    * Make this swap chain surface the one on the display. On the hardware
+    * runtime that is a call back into it with the primary's allocation; it
+    * is what takes the VidPN source from the desktop's primary to the swap
+    * chain, and no flip of the chain is accepted before it has succeeded.
+    * A resource that is not one of our primaries (the software runtime, or
+    * no Panfrost) keeps the old answer.
+    */
+   Resource *pResource = CastResource(SetDisplayMode->hResource);
+
+   if (pResource && pResource->present_allocation)
+      return (HRESULT)d3d10_set_display_mode(pResource->present_allocation);
 
    return S_OK;
 }
