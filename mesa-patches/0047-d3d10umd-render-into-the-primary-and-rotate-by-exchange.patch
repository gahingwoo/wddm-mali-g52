+/*
+ * Rotate primaries by exchanging what they are made of. After the call
+ * resource i has the buffer, the presented allocation and the contents that
+ * resource i + 1 had, and the last has the first's: no pixel moves. The
+ * views made on the resources, the bound framebuffer and the bound sampler
+ * views are pointed at the buffers the resources then have.
+ *
+ * The copy this replaces went through the driver's resource_copy_region,
+ * which for Panfrost is a CPU copy between mapped buffers: one more than
+ * there are surfaces, each of a whole surface, at every present.
+ */
+#define ROTATE_MAX 16
+
+static bool
+RotateByExchangingBuffers(DXGI_DDI_ARG_ROTATE_RESOURCE_IDENTITIES *Rotate)
+{
+   UINT n = Rotate->Resources;
+   Device *pDevice = CastDevice(Rotate->hDevice);
+   struct pipe_context *pipe = pDevice->pipe;
+   Resource *res[ROTATE_MAX];
+   struct pipe_resource *old[ROTATE_MAX];
+   unsigned old_allocation[ROTATE_MAX];
+   bool old_direct[ROTATE_MAX];
+
+   if (n > ROTATE_MAX)
+      return false;
+   for (UINT i = 0; i < n; ++i) {
+      res[i] = CastResource(Rotate->pResources[i]);
+      if (!res[i] || !res[i]->primary || !res[i]->resource)
+         return false;
+      for (UINT k = 0; k < res[i]->NumSubResources; ++k)
+         if (res[i]->transfers[k])
+            return false;          /* mapped: its transfer names the buffer */
+   }
+
+   for (UINT i = 0; i < n; ++i) {
+      old[i] = NULL;
+      pipe_resource_reference(&old[i], res[i]->resource);
+      old_allocation[i] = res[i]->present_allocation;
+      old_direct[i] = res[i]->direct_primary;
+   }
+   for (UINT i = 0; i < n; ++i) {
+      UINT from = (i + 1) % n;
+
+      pipe_resource_reference(&res[i]->resource, old[from]);
+      res[i]->present_allocation = old_allocation[from];
+      res[i]->direct_primary = old_direct[from];
+      if (res[i]->direct_primary)
+         d3d10_primary_rebind(pDevice->hDevice, res[i]->present_allocation,
+                              res[i]->rt_resource);
+   }
+
+   /* The views. */
+   for (UINT i = 0; i < n; ++i) {
+      for (RenderTargetView *v = res[i]->rtvs; v; v = v->next)
+         pipe_resource_reference(&v->surface.texture, res[i]->resource);
+
+      for (ShaderResourceView *v = res[i]->srvs; v; v = v->next) {
+         struct pipe_sampler_view *was = v->handle;
+         struct pipe_sampler_view templ;
+         struct pipe_sampler_view *now;
+
+         if (!was)
+            continue;
+         templ = *was;
+         now = pipe->create_sampler_view(pipe, res[i]->resource, &templ);
+         if (!now)
+            continue;
+         for (unsigned stage = 0; stage < MESA_SHADER_STAGES; ++stage) {
+            bool bound = false;
+            for (unsigned slot = 0; slot < PIPE_MAX_SHADER_SAMPLER_VIEWS; ++slot) {
+               if (pDevice->sampler_views[stage][slot] == was) {
+                  pDevice->sampler_views[stage][slot] = now;
+                  bound = true;
+               }
+            }
+            if (bound)
+               pipe->set_sampler_views(pipe, (mesa_shader_stage)stage, 0,
+                                       PIPE_MAX_SHADER_SAMPLER_VIEWS, 0,
+                                       pDevice->sampler_views[stage]);
+         }
+         v->handle = now;
+         pipe->sampler_view_release(pipe, was);
+      }
+   }
+
+   /* What is bound for drawing. */
+   bool fb_changed = false;
+   for (unsigned c = 0; c < PIPE_MAX_COLOR_BUFS; ++c) {
+      for (UINT i = 0; i < n; ++i) {
+         if (pDevice->fb.cbufs[c].texture == old[i]) {
+            pipe_resource_reference(&pDevice->fb.cbufs[c].texture, old[(i + 1) % n]);
+            fb_changed = true;
+            break;
+         }
+      }
+   }
+   if (fb_changed)
+      pipe->set_framebuffer_state(pipe, &pDevice->fb);
+
+   for (UINT i = 0; i < n; ++i)
+      pipe_resource_reference(&old[i], NULL);
+   return true;
+}
