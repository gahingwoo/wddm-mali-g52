+#endif
+}
+
+/* After a rotation: this allocation now belongs to this runtime resource. */
+void
+d3d10_primary_rebind(void *hRTDevice, unsigned allocation, void *hRTResource)
+{
+#ifdef GALLIUM_PANFROST
+   malikm_primary_rebind(hRTDevice, allocation, hRTResource);
+#else
+   (void)hRTDevice; (void)allocation; (void)hRTResource;
+#endif
+}
