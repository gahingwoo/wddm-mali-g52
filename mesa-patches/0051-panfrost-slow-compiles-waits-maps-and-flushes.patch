+
+   panfrost_ptr_unmap_body(pctx, transfer);
+   MALI_SLOW(slow_t0, "transfer-unmap", "%ux%u, box %dx%dx%d, usage 0x%x",
+             w, h, box.width, box.height, box.depth, usage);
+}
