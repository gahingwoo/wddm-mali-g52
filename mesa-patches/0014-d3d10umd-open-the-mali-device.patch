+
+/* The Mali kernel driver (wddm-mali-g52) exposes \\.\MaliG52. Panfrost gets a
+ * CRT fd for it; its libdrm calls reach the driver through that. */
+static int
+d3d10_open_mali(void)
+{
+   HANDLE h = CreateFileW(L"\\\\.\\MaliG52", GENERIC_READ | GENERIC_WRITE,
+                          FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                          OPEN_EXISTING, 0, NULL);
+   if (h == INVALID_HANDLE_VALUE) {
+      DWORD err = GetLastError();
+      /* MALIKM_FAKE: the shim emulates the driver in this process (CI). */
+      const char *fake = getenv("MALIKM_FAKE");
+      if (fake && *fake && *fake != '0')
+         return _open("NUL", _O_RDWR);
+      fprintf(stderr, "d3d10umd: cannot open \\\\.\\MaliG52 (error %lu)\n", err);
+      return -1;
+   }
+   return _open_osfhandle((intptr_t)h, 0);
+}
 #endif
