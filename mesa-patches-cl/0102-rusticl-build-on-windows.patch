index c4c029e..fbb76f8 100644
--- a/src/gallium/frontends/rusticl/rusticl_system_bindings.c
+++ b/src/gallium/frontends/rusticl/rusticl_system_bindings.c
@@ -25,3 +25,16 @@ mesa_version_string(void)
 {
     return PACKAGE_VERSION MESA_GIT_SHA1;
 }
+
+#ifdef _WIN32
+/* wddm-mali-g52: rusticl looks up eglGetProcAddress and glXGetProcAddress
+ * with dlsym(NULL, ...) for GL sharing; Windows has neither, so sharing is
+ * reported as unavailable. */
+void *
+dlsym(void *handle, const char *symbol)
+{
+   (void)handle;
+   (void)symbol;
+   return NULL;
+}
+#endif
